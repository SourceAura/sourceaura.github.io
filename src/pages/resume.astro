---
/*
Resume: an interactive resume page in the site's own visual language.
Document view + terminal view, print stylesheet, synthwave '84 accents.
*/
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
---

<Layout title="Resume" description="0xSrcAura — Web Developer, Entry-Level Cybersecurity">
  <Container>
    <!-- Ghost typography looming behind everything -->
    <div class="ghost-title" aria-hidden="true">RÉSUMÉ</div>

    <!-- ══════════════════════════════════════════
         CINEMATIC HERO — synthwave sun
         ══════════════════════════════════════════ -->
    <section class="hero" data-hero>
      <div class="hero-frame">
        <div class="hero-fallback" aria-hidden="true"></div>
        <div class="sw-sun" aria-hidden="true"></div>
        <div class="sw-grid" aria-hidden="true"></div>
        <div class="hero-scanline" aria-hidden="true"></div>
        <div class="hero-vignette" aria-hidden="true"></div>
        <div class="hero-dotgrid" aria-hidden="true"></div>
      </div>
      <h1 class="hero-title" data-decrypt>0xSrcAura</h1>
      <p class="hero-sub" data-decrypt>0xSrcAura — Web Developer · Entry-Level Cybersecurity</p>
    </section>

    <!-- ══════════════════════════════════════════
         COMMAND DECK
         ══════════════════════════════════════════ -->
    <!-- ══════════════════════════════════════════
         TERMINAL VIEW (hidden until summoned)
         ══════════════════════════════════════════ -->
    <div class="article-card term-card" id="resume-term">
      <div class="term-chrome">
        <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
        <span class="term-title">src@euthymia — resume.sh</span>
        <span class="term-tools">
          <a class="term-tool" href="https://github.com/SourceAura" target="_blank" rel="noopener" aria-label="GitHub" data-tip="GitHub" data-tip-pos="below">gh &#8599;</a>
          <a class="term-tool" href="mailto:sourceaura.dev@gmail.com" aria-label="Email" data-tip="Email" data-tip-pos="below">mail</a>
          <button class="term-tool" id="copy-email" aria-label="Copy email address" data-tip="Copy email" data-tip-pos="below"><span id="copy-label">copy</span></button>
          <button class="term-tool" id="print-btn" aria-label="Print or save as PDF" data-tip="Print / PDF" data-tip-pos="below">print</button>
        </span>
      </div>
      <div class="term-body" id="term-output" role="log" aria-label="Terminal output"></div>
      <div class="term-input-row">
        <span class="term-prompt" aria-hidden="true">src@euthymia:~$</span>
        <input
          id="term-input"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="Terminal input — type help for commands"
        />
      </div>
    </div>

    <!-- ══════════════════════════════════════════
         ARTICLE — THE READING CHAMBER
         ══════════════════════════════════════════ -->
    <article class="article-card" id="resume-doc" data-pagefind-body data-reveal hidden>
      <div class="corner-brackets" aria-hidden="true">
        <span class="bracket tl"></span><span class="bracket tr"></span>
        <span class="bracket bl"></span><span class="bracket br"></span>
      </div>
      <div class="article-vignette" aria-hidden="true"></div>
      <div class="article-dotgrid" aria-hidden="true"></div>

      <div class="article-content">
        <p class="lede" data-reveal>
          Self-taught builder working in the small hours. I ship real systems —
          multiplayer game servers, voice-driven Linux shells, recon automation —
          and I verify everything I claim.
        </p>

        <div class="article prose dark:prose-invert" data-blur-headings>
          <h2>Experience</h2>
          <h3>Independent Web Developer <span class="dim">— 2024 → present</span></h3>
          <ul>
            <li>Designed and built <strong>Euthymia: Soul Alterz</strong> — a full TypeScript multiplayer client/server web game (Protocol War lore, 3 races, 2 factions, base building, in-game economy, gamified ethical-hacking loop).</li>
            <li>Building <strong>Valence: Ghost in the Shell</strong> — a voice-driven XR shell for Linux; Phase 1 voice loop verified end-to-end (Whisper wake-word → command dispatch → live compositor control), 20/20 test suite green.</li>
            <li>Runs a local-first <strong>bug-bounty recon workflow</strong> — scope-guarded automation (subfinder → httpx → nuclei) with two-stage local triage; every finding verified by hand.</li>
          </ul>

          <h3>Tier 2 Technical Support <span class="dim">— Agero, 2015 → 2017</span></h3>
          <ul>
            <li><strong>Promoted to Tier 2</strong> — premium, escalation-level support handling the complex customer issues Tier 1 could not resolve.</li>
            <li>Received and resolved a wide variety of customer transactions and issues, efficiently and ethically.</li>
            <li>Provided technical assistance and support to team members and customers alike; maintained compliance with all company protocols and policies.</li>
          </ul>

          <h2>Arsenal</h2>
          <ul>
            <li><strong>Languages:</strong> TypeScript, JavaScript, HTML5, CSS3, Python, Bash</li>
            <li><strong>Backend:</strong> Node.js server &amp; multiplayer architecture, OAuth 2.0 (fail-closed), REST, WebSockets</li>
            <li><strong>Systems:</strong> Linux (Arch), Git/GitHub, Docker Compose, Tailscale, SSH, systemd, homelab networking</li>
            <li><strong>Security:</strong> recon tooling (nuclei, httpx, subfinder), manual verification discipline, scope-guard automation</li>
            <li><strong>ML/Voice:</strong> Whisper integration, on-device pipelines, audio device wrangling</li>
            <li><strong>Workflow:</strong> AI-assisted development, roadmap-driven builds, test suites before commits</li>
          </ul>

          <h2>Education</h2>
          <p>Independence University — coursework in Graphic Arts <span class="dim">(did not complete; no degree awarded)</span>. Design coursework feeds the front-end work.</p>

          <h2>Now</h2>
          <p>Portfolio first, applications daily. The work is public at <a href="https://github.com/SourceAura">github.com/SourceAura</a> and playable at <a href="/euthymia">/euthymia</a>. If you want the formal document, <a href="mailto:sourceaura.dev@gmail.com">ask and it's yours</a>.</p>
        </div>
      </div>
    </article>

    <a href="/petals" class="back-to-orbit">
      <span aria-hidden="true">←</span> Back to orbit
    </a>
  </Container>

<script is:inline>
  // Resume terminal: view-transition-safe, event-bridged to the footer toggle.
  // Elements are re-queried fresh on every run; document listeners bind once.
  (() => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const els = () => ({
      term: document.getElementById("resume-term"),
      doc: document.getElementById("resume-doc"),
      out: document.getElementById("term-output"),
      input: document.getElementById("term-input"),
    });

    const DATA = {
      whoami: [
        "0xSrcAura",
        "Web Developer · Entry-Level Cybersecurity",
        "Base: Nashville, TN — open to remote · typing 71 GWAM",
      ],
      experience: [
        "Independent Web Developer — 2024 → present",
        "  · Euthymia: Soul Alterz — TypeScript multiplayer client/server web game",
        "  · Valence: Ghost in the Shell — voice-driven XR shell for Linux (Phase 1 live)",
        "  · Local-first bug-bounty recon workflow (subfinder → httpx → nuclei)",
        "",
        "Tier 2 Technical Support — Agero, 2015 → 2017",
        "  · Promoted to Tier 2 — premium escalation-level support",
      ],
      arsenal: [
        "TypeScript · JavaScript · HTML5 · CSS3 · Python · Bash",
        "Node.js · OAuth 2.0 (fail-closed) · REST · WebSockets",
        "Linux (Arch) · Git/GitHub · Docker Compose · Tailscale · SSH · homelab",
        "nuclei · httpx · subfinder · Whisper on-device pipelines",
      ],
      education: [
        "Independence University — coursework in Graphic Arts",
        "(did not complete; no degree awarded) — design feeds the front-end work.",
      ],
      contact: [
        "mail ......... sourceaura.dev@gmail.com",
        "code ......... github.com/SourceAura",
        "play ......... /euthymia",
      ],
      hire: [
        "Portfolio first, applications daily.",
        "The work is public and playable. If you want the formal document,",
        "write to sourceaura.dev@gmail.com — it's yours.",
      ],
      petals: [
        "recent petals —",
        "  13 · i am that is, that is i am",
        "  12 · Meet Me",
        "  11 · The Small Hours",
        "  10 · Euthymia: Soul Alterz",
        "  09 · Valence: Ghost in the Shell",
        "read them at /petals",
      ],
    };

    function print(lines) {
      const { out } = els();
      if (!out) return;
      lines.forEach((l) => {
        const div = document.createElement("div");
        div.className = "term-line";
        div.textContent = l === "" ? " " : l;
        out.appendChild(div);
      });
      out.scrollTop = out.scrollHeight;
    }

    function typeBoot(done) {
      const { out } = els();
      if (!out) {
        done();
        return;
      }
      const boot = [
        "euthymia resume shell v1.0 — all systems nominal",
        "type ‘help’ to list commands.",
      ];
      if (reduce) {
        print(boot);
        done();
        return;
      }
      let li = 0;
      const step = () => {
        if (li >= boot.length) {
          done();
          return;
        }
        const line = boot[li];
        const div = document.createElement("div");
        div.className = "term-line term-accent";
        out.appendChild(div);
        let ci = 0;
        const tick = () => {
          if (ci <= line.length) {
            div.textContent = line.slice(0, ci);
            ci++;
            setTimeout(tick, 14);
          } else {
            li++;
            out.scrollTop = out.scrollHeight;
            step();
          }
        };
        tick();
      };
      step();
    }

    let booted = false;
    function setTerm(open, scroll = true) {
      const { term, doc, input, out } = els();
      if (!term || !doc) return;
      term.hidden = !open;
      doc.hidden = open;
      window.dispatchEvent(new CustomEvent("resume:view", { detail: { terminal: open } }));
      if (open) {
        if (!booted) {
          booted = true;
          if (out) out.innerHTML = "";
          typeBoot(() => input && input.focus({ preventScroll: true }));
        } else if (input) {
          input.focus({ preventScroll: true });
        }
        if (scroll) term.scrollIntoView({ block: "nearest", behavior: reduce ? "auto" : "smooth" });
      }
    }

    function runCommand(raw) {
      const cmd = raw.trim().toLowerCase();
      const { out } = els();
      if (!out) return;
      const echo = document.createElement("div");
      echo.className = "term-line";
      const ps = document.createElement("span");
      ps.className = "term-prompt-inline";
      ps.textContent = "src@euthymia:~$ ";
      echo.appendChild(ps);
      echo.appendChild(document.createTextNode(raw));
      out.appendChild(echo);

      if (!cmd) {
        out.scrollTop = out.scrollHeight;
        return;
      }
      if (cmd === "clear") {
        out.innerHTML = "";
      } else if (cmd === "help") {
        print([["whoami", "experience", "arsenal", "education", "contact", "petals", "play", "hire", "doc", "clear"].join(" · ")]);
      } else if (cmd === "doc" || cmd === "gui" || cmd === "document") {
        print(["switching to the formal document…"]);
        setTimeout(() => setTerm(false), 350);
      } else if (cmd === "play") {
        print(["loading euthymia…"]);
        setTimeout(() => (window.location.href = "/euthymia"), 450);
      } else if (cmd === "sudo hire me") {
        print(["nice try. write to sourceaura.dev@gmail.com — that's the real sudo."]);
      } else if (DATA[cmd]) {
        print(DATA[cmd]);
      } else {
        print(["command not found: " + raw + " — try ‘help’."]);
      }
      out.scrollTop = out.scrollHeight;
    }

    async function copyEmail() {
      try {
        await navigator.clipboard.writeText("sourceaura.dev@gmail.com");
        const label = document.getElementById("copy-label");
        if (label) {
          label.textContent = "Copied ✓";
          setTimeout(() => (label.textContent = "copy"), 1800);
        }
      } catch {
        const label = document.getElementById("copy-label");
        if (label) label.textContent = "sourceaura.dev@gmail.com";
      }
    }

    // one-time document bindings (survive view transitions; elements re-queried)
    if (!window.__resumeInit) {
      window.__resumeInit = true;

      document.addEventListener("resume:toggle-view", () => {
        const { term } = els();
        if (term) setTerm(term.hidden);
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const { term } = els();
          if (term && !term.hidden) setTerm(false);
          return;
        }
        if (e.key === "Enter" && e.target && e.target.id === "term-input") {
          const value = e.target.value;
          e.target.value = "";
          runCommand(value);
        }
      });

      document.addEventListener("click", (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        if (t.closest("#print-btn")) {
          window.print();
          return;
        }
        if (t.closest("#copy-email")) copyEmail();
      });
    }

    // terminal-first: the shell is the front door
    setTerm(true, false);
  })();
</script>


<style>
  /* synthwave '84 tokens, scoped to the resume */
  :root {
    --sw1: #ff71ce;
    --sw2: #b967ff;
    --sw3: #ff9e00;
    --sw-grad: linear-gradient(100deg, var(--sw1), var(--sw2) 50%, var(--sw3));
  }
  html.light {
    --sw1: #d12d7f;
    --sw2: #7c3aed;
    --sw3: #c26a00;
  }

  .ghost-title {
    position: relative;
    font-size: clamp(4rem, 14vw, 11rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1;
    opacity: 0.07;
    user-select: none;
    margin: 2rem 0 -1rem;
    text-align: center;
  }
  .hero { position: relative; margin-bottom: 1.5rem; }
  .hero-frame {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    min-height: 220px;
    border: 1px solid color-mix(in oklch, currentColor 10%, transparent);
    background: color-mix(in oklch, currentColor 3%, transparent);
  }
  .hero-fallback {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 110%, color-mix(in oklch, var(--pc-accent, #8b5cf6) 22%, transparent), transparent),
      radial-gradient(ellipse 40% 35% at 50% 40%, color-mix(in oklch, var(--pc-accent2, #22d3ee) 14%, transparent), transparent);
  }
  /* synthwave sun rising behind the name */
  .sw-sun {
    position: absolute;
    left: 50%;
    bottom: -38px;
    width: 300px;
    height: 300px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: linear-gradient(180deg, var(--sw1), var(--sw2) 55%, var(--sw3));
    opacity: 0.5;
    -webkit-mask-image: repeating-linear-gradient(180deg, black 0 14px, transparent 14px 20px);
    mask-image: repeating-linear-gradient(180deg, black 0 14px, transparent 14px 20px);
    filter: blur(1px) saturate(1.2);
    pointer-events: none;
  }
  .sw-grid {
    position: absolute; inset: auto 0 0 0; height: 90px; pointer-events: none;
    background-image:
      linear-gradient(color-mix(in oklch, var(--sw2) 35%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklch, var(--sw2) 35%, transparent) 1px, transparent 1px);
    background-size: 34px 22px;
    transform: perspective(220px) rotateX(48deg);
    transform-origin: bottom;
    opacity: 0.35;
    -webkit-mask-image: linear-gradient(180deg, transparent, black 70%);
    mask-image: linear-gradient(180deg, transparent, black 70%);
  }
  .hero-scanline {
    position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(0,0,0,0.12) 3px 4px);
  }
  .hero-vignette {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,0.45) 100%);
  }
  html.light .hero-vignette {
    background: radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,0.14) 100%);
  }
  .hero-dotgrid {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1px);
    background-size: 20px 20px;
  }
  html.light .hero-frame::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(5,7,15,0.55), rgba(5,7,15,0.78));
    pointer-events: none;
  }
  .hero-title {
    position: absolute; bottom: 3.2rem; left: 1.5rem; right: 1.5rem;
    font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 800; margin: 0; line-height: 1.15;
    color: white; text-shadow: 0 0 20px rgba(0,0,0,0.8), 2px 2px 0 var(--pc-accent);
  }
  .hero-sub {
    position: absolute; bottom: 1.4rem; left: 1.5rem; right: 1.5rem; margin: 0;
    font-size: 0.95rem; opacity: 0.85; color: white; text-shadow: 0 1px 8px rgba(0,0,0,0.8);
  }
  .telemetry { display: flex; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.4rem 0.8rem; border-radius: 999px;
    border: 1px solid color-mix(in oklch, var(--pc-accent, #8b5cf6) 30%, transparent);
    background: color-mix(in oklch, var(--pc-accent, #8b5cf6) 8%, transparent);
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--pc-accent, #b7a6f5);
  }
  .chip-label { opacity: 0.6; }
  .chip-link { text-decoration: none; cursor: pointer; transition: border-color 0.25s ease, transform 0.25s ease; }
  .chip-link:hover { border-color: color-mix(in oklch, var(--pc-accent, #8b5cf6) 60%, transparent); transform: translateY(-1px); }

  /* ── terminal ── */
  .term-card { margin-bottom: 2rem; overflow: hidden; }
  .term-chrome {
    display: flex; align-items: center; gap: 0.45rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid color-mix(in oklch, var(--ui-text) 12%, transparent);
    background: color-mix(in oklch, var(--ui-text) 4%, transparent);
  }
  .term-dot { width: 10px; height: 10px; border-radius: 50%; background: color-mix(in oklch, var(--ui-text) 22%, transparent); }
  .term-dot:first-child { background: var(--sw1); }
  .term-dot:nth-child(2) { background: var(--sw2); }
  .term-dot:nth-child(3) { background: var(--sw3); }
  .term-tools { margin-left: auto; display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; }
  .term-tool {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ui-text); opacity: 0.75; text-decoration: none;
    background: transparent;
    border: 1px solid color-mix(in oklch, var(--ui-text) 20%, transparent);
    padding: 0.28rem 0.55rem; cursor: pointer;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
    transition: opacity 160ms ease, border-color 160ms ease;
  }
  .term-tool:hover { opacity: 1; border-color: color-mix(in oklch, var(--sw2) 60%, transparent); }
  .term-tool:focus-visible { outline: 2px solid var(--sw2); outline-offset: 2px; }
  .term-title {
    margin-left: 0.5rem; font-size: 0.68rem; letter-spacing: 0.12em;
    text-transform: uppercase; opacity: 0.55; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .term-body {
    min-height: 280px; max-height: 420px; overflow-y: auto;
    padding: 1rem 1.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem; line-height: 1.65;
    color: var(--ui-text);
  }
  .term-line { white-space: pre-wrap; word-break: break-word; }
  .term-accent { color: var(--sw1); }
  .term-input-row {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.8rem 1.25rem 1.1rem;
    border-top: 1px solid color-mix(in oklch, var(--ui-text) 10%, transparent);
  }
  .term-prompt, .term-prompt-inline {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem; font-weight: 700; white-space: nowrap;
    background: var(--sw-grad);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  #term-input {
    flex: 1; background: transparent; border: none; outline: none;
    color: var(--ui-text); caret-color: var(--sw1);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85rem;
  }

  /* ── article ── */
  .article-card {
    position: relative; border-radius: 14px; overflow: hidden;
    border: 1px solid color-mix(in oklch, currentColor 10%, transparent);
    background: color-mix(in oklch, currentColor 3%, transparent);
    margin-bottom: 2rem;
  }
  .article-content { padding: 2rem clamp(1.25rem, 4vw, 3rem); position: relative; z-index: 1; color: var(--ui-text); }
  .lede { font-size: 1.15rem; line-height: 1.7; opacity: 0.92; margin-bottom: 2rem; }
  .article h2 {
    margin-top: 2.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid transparent;
    border-image: linear-gradient(100deg, var(--sw1), var(--sw2) 50%, var(--sw3)) 1;
  }
  .article h3 { margin-top: 1.5rem; }
  .dim { opacity: 0.78; font-weight: 400; }
  .article-vignette, .article-dotgrid { position: absolute; inset: 0; pointer-events: none; }
  .article-vignette { background: radial-gradient(ellipse at center, transparent 60%, rgba(0,0,0,0.35) 100%); }
  html.light .article-vignette { background: radial-gradient(ellipse at center, transparent 60%, rgba(0,0,0,0.10) 100%); }
  .article-dotgrid {
    background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .corner-brackets span { position: absolute; width: 22px; height: 22px; border-color: var(--pc-accent, #8b5cf6); opacity: 0.7; }
  .corner-brackets .tl { top: 10px; left: 10px; border-top: 2px solid; border-left: 2px solid; }
  .corner-brackets .tr { top: 10px; right: 10px; border-top: 2px solid; border-right: 2px solid; }
  .corner-brackets .bl { bottom: 10px; left: 10px; border-bottom: 2px solid; border-left: 2px solid; }
  .corner-brackets .br { bottom: 10px; right: 10px; border-bottom: 2px solid; border-right: 2px solid; }
  .back-to-orbit { display: inline-block; margin-bottom: 4rem; text-decoration: none; opacity: 0.8; }
  .back-to-orbit:hover { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .action-btn, .chip-link { transition: none; }
  }
</style>

<style is:global>
  /* ── print: the formal document ── */
  @media print {
    [data-role="app-header"],
    .app-footer,
    #backdrop,
    #qi-root,
    quasar-background,
    .ghost-title,
    .hero,
    .telemetry,
    .resume-actions,
    #resume-term,
    .back-to-orbit,
    .corner-brackets,
    .article-vignette,
    .article-dotgrid {
      display: none !important;
    }
