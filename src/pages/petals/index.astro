---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Nelumbo from "@components/Nelumbo.astro";
import { getCollection } from "astro:content";
import { PETALS } from "@consts";
import {
  extractFirstImageFromMarkdown,
  readingTimeMinutes,
} from "@lib/post";

const posts = (await getCollection("petals"))
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  );
---

<Layout title="Petals" description={PETALS.DESCRIPTION}>
  <head>
    <meta name="pagefind:filter" content="nav" />
  </head>

  <Container>
    <!-- ───────────────── CHRONICLE DECK ───────────────── -->
    <section class="chronicle space-y-12 py-24" data-pagefind-body>
      <div class="spine" aria-hidden="true">
        <div class="spine-fill"></div>
      </div>
      {
        posts.map((post, i) => {
          const d = new Date(post.data.date);
          const day = d.getDate();
          const month = d.toLocaleString("default", { month: "long" });
          const year = d.getFullYear();
          const img = extractFirstImageFromMarkdown(post.body) ?? "";
          const readTime = readingTimeMinutes(post.body);

          return (
            <a
              href={`/petals/${post.slug}`}
              class="chronicle-card"
              data-spotlight
              data-reveal
              style={`--reveal-delay:${Math.min(i, 6) * 60}ms`}
            >
              <span class="node" aria-hidden="true"></span>
              <header class="chron-rail">
                <span class="chron-idx">{String(i + 1).padStart(2, "0")}</span>
                <span class="chron-date">
                  {month} {day}, {year}
                </span>
              </header>

              <div class="chron-main">
                {img && (
                  <figure class="chron-thumb">
                    <img src={img} alt="" loading="lazy" decoding="async" />
                  </figure>
                )}

                <div class="chron-text">
                  <h2 data-decrypt>{post.data.title}</h2>
                  {post.data.description && <p>{post.data.description}</p>}
                </div>
              </div>

              <footer class="chron-rail">
                <span class="chron-read">{readTime}</span>
                <span class="chron-cta">Open</span>
              </footer>
            </a>
          );
        })
      }
    </section>

    <!-- ───────────────── NELUMBO (ALT VIEW) ───────────────── -->
    <section class="pt-32">
      <Nelumbo posts={posts} />
    </section>
  </Container>
</Layout>

<style>
  /* ───────────────── CHRONICLE DECK ───────────────── */

  .chronicle {
    display: flex;
    flex-direction: column;
  }

  .chronicle-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: color-mix(in oklch, currentColor 3%, transparent);
    border: none;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.35s ease;
  }

  .chronicle-card:hover {
    transform: translateY(-3px);
    background: color-mix(in oklch, currentColor 6%, transparent);
  }

  /* ───────── RAILS: index/date above, read time + CTA below ───────── */

  .chron-rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1.25rem;
    border-bottom: 1px solid color-mix(in oklch, currentColor 8%, transparent);
    font-family: "Geist Mono Variable", ui-monospace, SFMono-Regular, Menlo,
      monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .chronicle-card > .chron-rail:last-child {
    border-bottom: none;
    border-top: 1px solid color-mix(in oklch, currentColor 8%, transparent);
  }

  .chronicle-card:hover .chron-rail {
    opacity: 0.9;
  }

  .chron-idx,
  .chron-date,
  .chron-read {
    font-variant-numeric: tabular-nums;
  }

  /* ───────── BODY: thumbnail + text ───────── */

  .chron-main {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 1.25rem;
    align-items: center;
    padding: 1.25rem;
  }

  .chron-main:not(:has(.chron-thumb)) {
    grid-template-columns: 1fr;
  }

  .chron-thumb {
    margin: 0;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid color-mix(in oklch, currentColor 8%, transparent);
    background: color-mix(in oklch, currentColor 4%, transparent);
  }

  .chron-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chron-text h2 {
    font-size: 1.1rem;
    line-height: 1.25;
    margin-bottom: 0.35rem;
  }

  .chron-text p {
    opacity: 0.65;
    max-width: 48ch;
    line-height: 1.5;
    font-size: 0.88rem;
  }

  /* ───────── SPINAL IGNITION — synthwave '84 timeline ───────── */

  .chronicle {
    --sw-grad: linear-gradient(180deg, var(--sw1), var(--sw2) 48%, var(--sw3));
    position: relative;
    padding-left: 3rem;
  }
  html.light .chronicle {
    --sw1: #d12d7f;
    --sw2: #7c3aed;
    --sw3: #c26a00;
  }

  .spine {
    position: absolute;
    left: 1rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    border-radius: 2px;
    background: color-mix(in oklch, var(--sw2) 16%, transparent);
  }
  .spine-fill {
    width: 100%;
    height: calc(var(--spine-p, 0) * 100%);
    border-radius: inherit;
    background: var(--sw-grad);
    box-shadow:
      0 0 12px color-mix(in oklch, var(--sw1) 70%, transparent),
      0 0 30px color-mix(in oklch, var(--sw2) 45%, transparent);
  }

  .chronicle-card {
    position: relative;
  }
  .node {
    position: absolute;
    left: -2rem;
    top: 1.15rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: color-mix(in oklch, var(--sw2) 30%, transparent);
    border: 1px solid color-mix(in oklch, var(--sw2) 55%, transparent);
    transition:
      background 0.4s ease,
      box-shadow 0.4s ease,
      border-color 0.4s ease;
    z-index: 1;
    pointer-events: none;
  }
  .chronicle-card.ignited .node {
    background: var(--sw-grad);
    border-color: transparent;
    box-shadow:
      0 0 10px var(--sw1),
      0 0 24px color-mix(in oklch, var(--sw2) 80%, transparent);
  }
  .chronicle-card.ignited .node::after {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid var(--sw1);
    animation: nodePing 0.9s ease-out 1;
    pointer-events: none;
  }
  @keyframes nodePing {
    from {
      transform: scale(0.5);
      opacity: 0.9;
    }
    to {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  /* ignited card carries a breath of the gradient on its border */
  .chronicle-card.ignited {
    border-color: color-mix(in oklch, var(--sw2) 45%, transparent);
  }

  /* timestamps glow neon on the wire */
  .chron-date {
    color: var(--sw1);
    text-shadow: 0 0 14px color-mix(in oklch, var(--sw1) 55%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .spine-fill {
      transition: none;
    }
    .chronicle-card.ignited .node::after {
      animation: none;
      display: none;
    }
    .node,
    .chronicle-card.ignited {
      transition: none;
    }
  }

  /* ───────── RESPONSIVE ───────── */

  @media (max-width: 640px) {
    .chron-main {
      grid-template-columns: 1fr;
    }

    .chron-thumb {
      aspect-ratio: 16 / 9;
    }

    .chronicle {
      padding-left: 2.25rem;
    }
    .spine {
      left: 0.65rem;
    }
    .node {
      left: -1.6rem;
    }
  }
</style>

<script is:inline>
  // Spinal ignition: scroll-driven synthwave spine + node ignition.
  // Re-runs cleanly across Astro view transitions (tears down the prior run).
  (() => {
    const section = document.querySelector(".chronicle");
    if (!section) return;

    if (window.__spineIO) window.__spineIO.disconnect();
    if (window.__spineScroll)
      window.removeEventListener("scroll", window.__spineScroll);

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const cards = [...section.querySelectorAll(".chronicle-card")];

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            en.target.classList.add("ignited");
            io.unobserve(en.target);
          }
        });
      },
      { threshold: 0.35 },
    );
    cards.forEach((c) => io.observe(c));
    window.__spineIO = io;

    const onScroll = () => {
      const r = section.getBoundingClientRect();
      const span = Math.max(1, r.height - window.innerHeight * 0.4);
      const done = Math.min(
        1,
        Math.max(0, (-r.top + window.innerHeight * 0.35) / span),
      );
      section.style.setProperty("--spine-p", reduce ? 1 : done.toFixed(3));
    };
    window.__spineScroll = onScroll;
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>
