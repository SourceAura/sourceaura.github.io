---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Giscus from "@components/Giscus.astro";
import PostNavigation from "@components/PostNavigation.astro";
import { readingTime } from "@utils/utils";

/* Static paths */
export async function getStaticPaths() {
  const posts = (await getCollection("petals")).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: post }));
}

type Props = CollectionEntry<"petals">;

/* Current post */
const post = Astro.props as Props;
const { Content } = await post.render();

const d = new Date(post.data.date);
const dateLabel = d.toLocaleDateString(undefined, {
  month: "2-digit",
  day: "2-digit",
  year: "numeric",
});
const rt = `${readingTime(post.body)} min`;

/* Extract first image */
let imageSrc: string | null = null;
const match = post.body.match(/!\[.*?\]\((.*?)\)/);

if (match?.[1]) {
  const raw = match[1].trim();

  if (raw.startsWith("http")) {
    imageSrc = raw;
  } else {
    const cleaned = raw.replace(/^\.?\//, "");
    imageSrc = `/${cleaned}`;
  }
}

/* Prev / next posts */
const allPosts = (await getCollection("petals")).filter((p) => !p.data.draft);
const currentIndex = allPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

<Layout title={post.data.title} description={post.data.description}>
  <Container>
    <!-- Ghost typography looming behind everything -->
    <div class="ghost-title ghost-drift-center" aria-hidden="true">
      {post.data.title}
    </div>

    <!-- Cinematic hero -->
    <section class="hero" data-hero>
      <div class="hero-frame">
        {
          imageSrc ? (
            <img src={imageSrc} alt={post.data.title} data-hero-img data-petal-accent-src />
          ) : (
            <div class="hero-fallback" aria-hidden="true" />
          )
        }
        <div class="hero-scanline" aria-hidden="true" />
        <div class="hero-vignette" aria-hidden="true" />
        <div class="hero-dotgrid" aria-hidden="true" />
      </div>
      <h1 class="hero-title" data-decrypt>
        {post.data.title}
      </h1>
    </section>

    <!-- Telemetry strip -->
    <div class="telemetry" data-reveal>
      <span class="chip">
        <span class="chip-label">Date</span>
        <span class="chip-value">{dateLabel}</span>
      </span>
      <span class="chip">
        <span class="chip-label">Read</span>
        <span class="chip-value">{rt}</span>
      </span>
      <a class="chip chip-link" href={post.data.demoURL} target="_blank" rel="noopener">
        <span class="chip-label">Demo</span>
        <span class="chip-value">&#8599; Live</span>
      </a>
      <a class="chip chip-link" href={post.data.repoURL} target="_blank" rel="noopener">
        <span class="chip-label">Code</span>
        <span class="chip-value">&#8599; GitHub</span>
      </a>
    </div>

    <!-- Article: the reading chamber -->
    <article class="article-card scan-sweep" data-pagefind-body data-reveal>
      <!-- HUD corner brackets -->
      <div class="corner-brackets" aria-hidden="true">
        <span class="bracket tl" />
        <span class="bracket tr" />
        <span class="bracket bl" />
        <span class="bracket br" />
      </div>
      <!-- Vignette + dot-grid overlays -->
      <div class="article-vignette" aria-hidden="true" />
      <div class="article-dotgrid" aria-hidden="true" />

      <div class="article-content">
        {
          post.data.description && (
            <p class="lede" data-reveal>
              {post.data.description}
            </p>
          )
        }
        <div
          class="article prose dark:prose-invert"
          data-blur-headings
        >
          <Content />
        </div>
      </div>

      <!-- Reaction / comment controls -->
      <div class="article-controls">
        <button class="stat" title="Reactions">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="1.1em"
            height="1.1em"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" />
          </svg>
          <span class="count" data-reactions></span>
        </button>
        <button class="stat" title="Comments" data-toggle-giscus>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="1.1em"
            height="1.1em"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15a4 4 0 0 1-4 4H7l-4 4V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
          </svg>
          <span class="count" data-comments></span>
        </button>
      </div>
    </article>

    <!-- Prev / next navigation -->
    <PostNavigation prevPost={prevPost} nextPost={nextPost} />

    <!-- Back to orbit -->
    <a href="/" class="back-to-orbit">
      <span aria-hidden="true">←</span>
      <span>Back to Orbit</span>
    </a>

    <!-- Giscus comments -->
    <div id="giscus-wrapper" class="comments is-collapsed">
      <Giscus />
    </div>
  </Container>

  <!-- Reading progress bar -->
  <div class="reading-progress" aria-hidden="true" />
</Layout>

<!-- Scripts -->
<script is:inline>
  (() => {
    /* Accent coloration.
       Sample the hero image's dominant colour and tint the whole page. */
    const heroImg = document.querySelector("[data-hero-img]");
    const root = document.documentElement;
    // Per-visit listeners die on swap; the petal's accent tint must not leak
    // onto the next page (Layout's --petal-accent is already self-clearing).
    const __cleanups = [];
    document.addEventListener("astro:before-swap", () => {
      root.style.removeProperty("--pc-accent");
      root.style.removeProperty("--pc-accent2");
      __cleanups.forEach((fn) => { try { fn(); } catch (_) {} });
    }, { once: true });

    function rgbToHsl(r, g, b) {
      r /= 255; g /= 255; b /= 255;
      const max = Math.max(r, g, b), min = Math.min(r, g, b);
      let h = 0, s = 0;
      const l = (max + min) / 2;
      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        switch (max) {
          case r: h = ((g - b) / d + (g < b ? 6 : 0)) / 6; break;
          case g: h = ((b - r) / d + 2) / 6; break;
          case b: h = ((r - g) / d + 4) / 6; break;
        }
      }
      return { h: h * 360, s: s * 100, l: l * 100 };
    }

    function sampleImageColor(img) {
      if (!img || !img.complete) return null;
      try {
        const c = document.createElement("canvas");
        const w = 32, h = 32;
        c.width = w; c.height = h;
        const ctx = c.getContext("2d", { willReadFrequently: true });
        if (!ctx) return null;
        ctx.drawImage(img, 0, 0, w, h);
        const data = ctx.getImageData(0, 0, w, h).data;
        let r = 0, g = 0, b = 0, n = 0;
        for (let i = 0; i < data.length; i += 4) {
          const a = data[i + 3] / 255;
          if (a < 0.5) continue;
          const R = data[i], G = data[i + 1], B = data[i + 2];
          const mx = Math.max(R, G, B), mn = Math.min(R, G, B);
          const sat = mx === 0 ? 0 : (mx - mn) / mx;
          const lum = mx / 255;
          if (sat < 0.12) continue;
          const weight = a * (sat * 3.2) * (0.3 + lum * 0.8);
          r += R * weight; g += G * weight; b += B * weight;
          n += weight;
        }
        if (n <= 0) return null;
        return { r: r / n, g: g / n, b: b / n };
      } catch {
        return null;
      }
    }

    function applyAccent() {
      const color = sampleImageColor(heroImg);
      if (!color) return;
      const hsl = rgbToHsl(color.r, color.g, color.b);
      const accentHsl = `oklch(0.72 0.18 ${hsl.h})`;
      const accent2Hsl = `oklch(0.65 0.16 ${(hsl.h + 40) % 360})`;
      root.style.setProperty("--pc-accent", accentHsl);
      root.style.setProperty("--pc-accent2", accent2Hsl);
    }

    if (heroImg) {
      if (heroImg.complete) applyAccent();
      else heroImg.addEventListener("load", applyAccent, { once: true });
    }

    /* Reading progress bar */
    const progress = document.querySelector(".reading-progress");
    if (progress) {
      let ticking = false;
      const update = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const pct = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 0;
        progress.style.width = pct + "%";
        ticking = false;
      };
      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      __cleanups.push(() => window.removeEventListener("scroll", onScroll));
      update();
    }

    /* Staggered entrance choreography */
    const revealEls = document.querySelectorAll("[data-reveal]");
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduceMotion) {
      revealEls.forEach((el) => el.classList.add("is-in"));
    } else {
      revealEls.forEach((el, i) => {
        el.style.transitionDelay = `${i * 0.1}s`;
        // rAF for the transition; setTimeout as a reliable fallback
        requestAnimationFrame(() => {
          el.classList.add("is-in");
        });
        setTimeout(() => {
          el.classList.add("is-in");
        }, 150 + i * 100);
      });
    }

    /* Giscus message listener (counts) */
    const onGiscusMessage = (event) => {
      if (event.origin !== "https://giscus.app") return;
      const g = event.data?.giscus;
      if (!g || !g.discussion) return;

      const commentsEl = document.querySelector("[data-comments]");
      if (commentsEl) {
        commentsEl.textContent = g.discussion.totalCommentCount;
      }

      const reactionsEl = document.querySelector("[data-reactions]");
      function formatCount(n) {
        return n > 99 ? "99+" : String(n);
      }
      function animateCount(el) {
        el.animate(
          [{ transform: "scale(0.85)", opacity: 0 }, { transform: "scale(1)", opacity: 1 }],
          { duration: 220, easing: "cubic-bezier(.2,.8,.2,1)" },
        );
      }
      if (reactionsEl && g.discussion?.id) {
        fetch(`/api/reactions?id=${g.discussion.id}`)
          .then((r) => r.json())
          .then((d) => {
            if (typeof d.total !== "number") return;
            reactionsEl.textContent = formatCount(d.total);
            reactionsEl.dataset.active = "true";
            reactionsEl.closest(".stat")?.setAttribute("data-has-reactions", "true");
            animateCount(reactionsEl);
          })
          .catch(console.error);
      }
    };
    window.addEventListener("message", onGiscusMessage);
    __cleanups.push(() => window.removeEventListener("message", onGiscusMessage));

    /* Giscus toggle */
    const toggle = document.querySelector("[data-toggle-giscus]");
    const giscus = document.getElementById("giscus-wrapper");
    if (toggle && giscus) {
      toggle.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        giscus.classList.toggle("is-collapsed");
      });
    }
  })();
</script>

<style>
  /* Petal post page: HUD card design language */


  /* Ghost typography */
  .ghost-title {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(4rem, 18vw, 16rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.85;
    text-align: center;
    color: var(--pc-accent);
    opacity: 0.04;
    pointer-events: none;
    z-index: 0;
    white-space: nowrap;
    user-select: none;
    overflow: hidden;
    max-width: 100vw;
  }

  /* Cinematic hero */
  .hero {
    position: relative;
    margin-bottom: 2rem;
    z-index: 1;
  }

  .hero-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    contain: layout paint;
  }

  .hero-frame img,
  .hero-fallback {
    width: 100%;
    height: auto;
    min-height: 280px;
    display: block;
    object-fit: cover;
  }
  /* Light mode: guarantee a dark scrim so the white title always reads */
  html.light .hero-frame::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(5,7,15,0.55), rgba(5,7,15,0.78));
    pointer-events: none;
  }

  .hero-fallback {
    background: linear-gradient(135deg, var(--pc-accent) 0%, var(--pc-accent2) 100%);
    opacity: 0.3;
  }

  /* Laser scanline sweeping the hero */
  .hero-scanline {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--pc-accent), transparent);
    animation: heroScan 4.5s linear infinite;
    opacity: 0.6;
    pointer-events: none;
    z-index: 2;
  }

  @keyframes heroScan {
    from { top: -2%; }
    to { top: 102%; }
  }

  /* Vignette dissolving edges inward */
  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.6) 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Dot-grid texture overlay */
  .hero-dotgrid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
    z-index: 1;
  }

  /* Hero title: overlaid at lower edge, layered 3D text-shadow */
  .hero-title {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    right: 1.5rem;
    font-size: clamp(1.8rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: white;
    text-shadow:
      0 0 20px rgba(0, 0, 0, 0.8),
      2px 2px 0 var(--pc-accent),
      -1px -1px 0 var(--pc-accent2);
    z-index: 2;
    margin: 0;
    line-height: 1.2;
  }

  /* Telemetry strip */
  .telemetry {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: 0;
    clip-path: polygon(
          9px 0, 100% 0,
          100% calc(100% - 9px), calc(100% - 9px) 100%,
          0 100%, 0 9px
        );
    border: 1px solid color-mix(in oklch, var(--pc-accent) 30%, transparent);
    background: color-mix(in oklch, var(--pc-accent) 8%, transparent);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pc-accent);
    animation: chipPulse 3.2s ease-in-out infinite;
  }

  .chip-label {
    opacity: 0.6;
  }

  .chip-value {
    font-variant-numeric: tabular-nums;
  }

  .chip-link {
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.25s ease, transform 0.25s ease;
    animation: none;
  }

  .chip-link:hover {
    border-color: color-mix(in oklch, var(--pc-accent) 60%, transparent);
    transform: translateY(-1px);
  }

  @keyframes chipPulse {
    0%, 100% { opacity: 0.75; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.04); }
  }

  /* Article card: the reading chamber */
  .article-card {
    position: relative;
    border-radius: 16px;
    background: rgba(8, 10, 18, 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid color-mix(in oklch, var(--pc-accent) 15%, transparent);
    padding: 2.5rem;
    margin-bottom: 2rem;
    contain: layout paint;
    z-index: 1;
  }

  /* HUD corner brackets */
  .corner-brackets {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .bracket {
    position: absolute;
    width: 20px;
    height: 20px;
    border-color: var(--pc-accent);
    border-style: solid;
    opacity: 0.6;
  }

  .bracket.tl { top: 8px; left: 8px; border-width: 2px 0 0 2px; }
  .bracket.tr { top: 8px; right: 8px; border-width: 2px 2px 0 0; }
  .bracket.bl { bottom: 8px; left: 8px; border-width: 0 0 2px 2px; }
  .bracket.br { bottom: 8px; right: 8px; border-width: 0 2px 2px 0; }

  /* Vignette edge-dissolve */
  .article-vignette {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(ellipse at center, transparent 50%, rgba(0, 0, 0, 0.4) 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Dot-grid overlay */
  .article-dotgrid {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    z-index: 1;
  }

  /* Article content: centered reading column */
  .article-content {
    position: relative;
    z-index: 2;
    max-width: 68ch;
    margin: 0 auto;
  }

  .lede {
    font-size: 1.1rem;
    line-height: 1.7;
    color: color-mix(in oklch, white 80%, transparent);
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  .article {
    line-height: 1.75;
    color: color-mix(in oklch, white 90%, transparent);
  }

  .article a {
    color: var(--pc-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--pc-accent) 40%, transparent);
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .article a:hover {
    color: var(--pc-accent2);
  }

  .article blockquote {
    border-left: 3px solid var(--pc-accent);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: color-mix(in oklch, white 75%, transparent);
  }

  .article h2,
  .article h3,
  .article h4 {
    color: white;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .article h2::after,
  .article h3::after {
    content: "";
    display: block;
    width: 40px;
    height: 2px;
    background: var(--pc-accent);
    margin-top: 0.5rem;
    opacity: 0.5;
  }

  .article p {
    margin-bottom: 1.25rem;
  }

  .article ul,
  .article ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .article li {
    margin-bottom: 0.5rem;
  }

  .article code {
    background: color-mix(in oklch, white 8%, transparent);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .article pre {
    background: rgba(0, 0, 0, 0.4);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }

  .article pre code {
    background: none;
    padding: 0;
  }

  /* Reaction / comment controls */
  .article-controls {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklch, white 8%, transparent);
    position: relative;
    z-index: 2;
  }

  .stat {
    all: unset;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    cursor: pointer;
    pointer-events: auto;
    font-size: 1rem;
    color: color-mix(in oklch, white 70%, transparent);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .stat svg {
    width: 1.4em;
    height: 1.4em;
    transition: transform 0.2s ease;
  }

  .stat:hover {
    color: var(--pc-accent);
    transform: translateY(-2px);
  }

  .stat:hover svg {
    transform: scale(1.15);
    filter: drop-shadow(0 0 6px var(--pc-accent));
  }

  .stat .count {
    font-size: 0.85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    min-width: 1.2em;
    text-align: center;
  }

  .stat .count:not(:empty) {
    opacity: 0.75;
  }

  .stat .count[data-active="true"] {
    opacity: 1;
    color: var(--pc-accent);
  }

  /* Reading progress bar */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--pc-accent), var(--pc-accent2));
    width: 0%;
    z-index: 1000;
    transition: width 0.1s linear;
    will-change: width;
  }

  /* Back to orbit */
  .back-to-orbit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: color-mix(in oklch, white 50%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
    transition: color 0.2s ease;
  }

  .back-to-orbit:hover {
    color: var(--pc-accent);
  }

  /* Giscus wrapper */
  #giscus-wrapper {
    position: relative;
    border-radius: 16px;
    background: rgba(8, 10, 18, 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid color-mix(in oklch, var(--pc-accent) 15%, transparent);
    padding: 1.5rem;
    margin-top: 2rem;
    z-index: 1;
  }

  #giscus-wrapper.is-collapsed {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
    padding: 0;
    border-width: 0;
    margin-top: 0;
  }

  #giscus-wrapper .giscus {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  #giscus-wrapper iframe {
    position: relative !important;
    inset: auto !important;
    margin: 0 auto !important;
    display: block;
    width: 100% !important;
