---
/*
Home Page: Welcome to SourceAura
*/

import { SITE, HOME } from "@consts";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import Nelumbo from "@components/Nelumbo.astro";
import Container from "@components/Container.astro";

const posts = (await getCollection("petals"))
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  );
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <head>
    <meta name="pagefind:filter" content="nav" />
  </head>

  <Container>
    <!-- Root centers content, then lifts it above Qi -->
    <div
      class="root flex min-h-[60vh] flex-col items-center justify-center text-center"
    >
      <div class="home-ghost ghost-drift-center" aria-hidden="true">0xSRCAURA</div>
      <section
        class="w-full max-w-2xl
          -translate-y-20
          sm:-translate-y-24
          md:-translate-y-28"
      >
        <article class="seed space-y-6">
          <!-- DESCRIPTION / DEFINITION -->
          <div id="intro-log" class="log intro-log">
            <div class="log-entry">
              <span
                class="log-line log-line-primary"
                style="color: var(--ui-muted);"
              >
                {SITE.DESCRIPTION}
              </span>
              <br />
              <span
                class="log-line log-line-secondary"
                style="color: var(--ui-muted);"
              >
                {SITE.DEFINITION}
              </span>
            </div>
          </div>
          <div id="home-telemetry" class="home-telemetry" aria-hidden="true">
            <span>0xSrcAura</span><span class="ht-sep">·</span><span>web(3) developer</span>
          </div>
        </article>
      </section>

      <Nelumbo posts={posts} />
    </div>
  </Container>
</Layout>

<script is:inline>
  // Runs immediately: DOMContentLoaded never fires after view transitions,
  // and this classic script re-executes on every visit to /.
  {
    const lines = document.querySelectorAll("#intro-log .log-line");
    lines.forEach((l) => l.classList.add("shimmer-once"));
  }
  {
    const entry = document.querySelector("#intro-log .log-entry");
    if (entry) {
      const secondary = entry.querySelector(".log-line-secondary");
      const primary = entry.querySelector(".log-line-primary");

      // Bottom line fades first (definition releases)
      setTimeout(() => {
        secondary?.classList.add("fade-out");
      }, 2200);

      // Top line fades later (description lingers)
      setTimeout(() => {
        primary?.classList.add("fade-out");
      }, 3600);

      // Remove only after both have fully dissolved — then light the telemetry
      setTimeout(() => {
        entry.remove();
        document.getElementById("home-telemetry")?.classList.add("lit");
      }, 8200);
    }
  }
</script>

<style is:global>
  .intro-log {
    text-align: center;
  }

  .intro-log .log-line {
    display: block;
    opacity: 1;

    text-shadow:
      0 0 10px rgba(255, 255, 255, 0.16),
      0 0 22px rgba(255, 255, 255, 0.08),
      0 0 36px rgba(255, 255, 255, 0.045);

    animation: log-shimmer 9.5s ease-in-out infinite;

    transition:
      opacity 5.2s ease,
      text-shadow 5.2s ease,
      filter 5.2s ease;
  }

  .intro-log .log-line-secondary {
    transition-duration: 4.2s;
    text-shadow:
      0 0 8px rgba(255, 255, 255, 0.12),
      0 0 18px rgba(255, 255, 255, 0.065),
      0 0 30px rgba(255, 255, 255, 0.04);
  }

  .intro-log .log-line.fade-out {
    opacity: 0;
    text-shadow: none;
    animation: none;
    filter: none;
  }

  /* Light mode inversion */
  html.light .intro-log .log-line {
    text-shadow:
      0 0 8px rgba(0, 0, 0, 0.14),
      0 0 18px rgba(0, 0, 0, 0.08),
      0 0 30px rgba(0, 0, 0, 0.045);
  }

  /* One-time shimmer swell */
  .intro-log .log-line.shimmer-once {
    animation:
      log-swell 2.8s ease-out 1,
      log-shimmer 9.5s ease-in-out infinite 2.8s;
  }

  @keyframes log-shimmer {
    0%,
    100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.06);
    }
  }

  @keyframes log-swell {
    0% {
      filter: brightness(1);
    }
    40% {
      filter: brightness(1.22);
    }
    100% {
      filter: brightness(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-log .log-line {
      animation: none;
      filter: none;
    }
  }

  /* idle state — the ghost that was always there */
  .home-ghost {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(4rem, 20vw, 17rem);
    font-weight: 900;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    color: var(--pc-accent);
    opacity: 0.05;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .home-telemetry {
    margin-top: 1.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ui-muted);
    opacity: 0;
    transition: opacity 2.4s ease;
  }
  .home-telemetry.lit { opacity: 1; }
  .home-telemetry .ht-sep {
    margin: 0 0.7em;
    color: var(--pc-accent);
  }
</style>
