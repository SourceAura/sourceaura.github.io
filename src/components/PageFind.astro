---
/*
PageFind: the search instrument.
A command-palette in the site's own design language — glass panel, corner
brackets, accent glow, telemetry — fully token-driven for both themes.
*/
import Search from "astro-pagefind/components/Search";
---

<div
  id="backdrop"
  class="pointer-events-none invisible fixed inset-0 z-40"
>
  <div id="pagefind-shell" class="flex items-center justify-center">
    <div id="pagefind-container" class="relative flex max-h-[70vh] w-full max-w-screen-sm flex-col overflow-hidden" role="dialog" aria-modal="true" aria-label="Search the site">
      <!-- corner brackets -->
      <span class="pf-bracket pf-tl" aria-hidden="true"></span>
      <span class="pf-bracket pf-tr" aria-hidden="true"></span>
      <span class="pf-bracket pf-bl" aria-hidden="true"></span>
      <span class="pf-bracket pf-br" aria-hidden="true"></span>
      <!-- dot grid -->
      <div class="pf-dots" aria-hidden="true"></div>
      <span class="pf-star" aria-hidden="true"></span>

      <div class="pf-body">
        <Search
          id="search"
          className="pagefind-ui"
          uiOptions={{
            showImages: true,
            excerptLength: 22,
            showSubResults: true,
            resetStyles: false,
          }}
        />

        <!-- quick links: the empty-state -->
        <div id="pf-quicklinks" aria-label="Quick links">
          <span class="pf-qlabel">JUMP TO</span>
          <a class="pf-qlink" href="/petals">Petals</a>
          <a class="pf-qlink" href="/euthymia">Play Euthymia</a>
          <a class="pf-qlink" href="/petals/09-valence/">Valence</a>
          <a class="pf-qlink" href="/resume">Resume</a>
        </div>

        <!-- telemetry strip -->
        <div id="pf-status">
          <span id="pf-count" role="status" aria-live="polite"></span>
          <span class="pf-hint"><kbd>↑</kbd><kbd>↓</kbd> navigate · <kbd>↵</kbd> open · <kbd>esc</kbd> close</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Element refs are re-queried on every open: with Astro view transitions
  // the DOM (and these nodes) may be swapped between opens, so nothing here
  // holds a stale reference across navigations.
  let backdrop, shell, container, searchEl, inputEl, quicklinks, countEl;

  function query() {
    backdrop = document.getElementById("backdrop");
    shell = document.getElementById("pagefind-shell");
    container = document.getElementById("pagefind-container");
    searchEl = document.getElementById("search");
    inputEl = document.querySelector("#search input");
    quicklinks = document.getElementById("pf-quicklinks");
    countEl = document.getElementById("pf-count");
  }

  // shared across script re-executions: Astro view transitions re-run this
  // script, while the one-time document bindings below keep the FIRST run's
  // scope. A module-level `let pf.open` goes stale after any navigation.
  const pf = (window.__pf ??= { open: false });
  let scrollMemory = 0;
  let activeIdx = -1;
  let openerEl = null;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Spring physics for the open/close motion
  let y = -14, v = 0, target = -14, rafSpring = 0, lastT = 0;
  const STIFFNESS = 520, DAMPING = 38, MASS = 1;

  function applySpringStyles() {
    if (!shell) return;
    const p = Math.max(0, Math.min(1, 1 - Math.abs(y) / 14));
    shell.style.transform = `translateY(${y}px) scale(${0.985 + 0.015 * p})`;
    shell.style.opacity = String(0.1 + 0.9 * p);
    document.documentElement.style.setProperty("--qi", p.toFixed(4));
  }

  function tickSpring(t) {
    const dt = Math.min((t - lastT) / 1000, 0.033);
    lastT = t;
    const F = -STIFFNESS * (y - target) - DAMPING * v;
    v += (F / MASS) * dt;
    y += v * dt;
    if (Math.abs(v) < 0.02 && Math.abs(y - target) < 0.05) {
      y = target; v = 0;
      applySpringStyles();
      rafSpring = 0;
      return;
    }
    applySpringStyles();
    rafSpring = requestAnimationFrame(tickSpring);
  }

  function startSpring() {
    if (rafSpring || !shell) return;
    lastT = performance.now();
    rafSpring = requestAnimationFrame(tickSpring);
  }

  /* ── results: count, empty state, keyboard nav ── */

  function resultItems() {
    return [...document.querySelectorAll("#search .pagefind-ui__result")];
  }

  function setActive(i) {
    const items = resultItems();
    if (!items.length) return;
    activeIdx = Math.max(0, Math.min(i, items.length - 1));
    items.forEach((el, j) => {
      const on = j === activeIdx;
      el.classList.toggle("pf-active", on);
      if (on) el.setAttribute("aria-selected", "true");
      else el.removeAttribute("aria-selected");
    });
    items[activeIdx]?.scrollIntoView({ block: "nearest" });
  }

  function refreshResults() {
    const items = resultItems();
    activeIdx = -1;
    if (countEl) {
      countEl.textContent = items.length
        ? `${items.length} result${items.length === 1 ? "" : "s"}`
        : "";
    }
    const q = inputEl?.value.trim();
    if (quicklinks) quicklinks.style.display = !q && !items.length ? "" : "none";
  }

  let pfObserver;
  function attachObserver() {
    pfObserver?.disconnect();
    const target = document.getElementById("search");
    if (!target) return;
    pfObserver = new MutationObserver(refreshResults);
    pfObserver.observe(target, { childList: true, subtree: true });
    refreshResults();
  }

  function openResult(i) {
    const link = resultItems()[i]?.querySelector(".pagefind-ui__result-title a");
    if (link) window.location.href = link.href;
  }

  /* ── open / close ── */

  function openPagefind() {
    query();
    if (!backdrop || !container) return;
    openerEl = document.activeElement;
    pf.open = true;
    backdrop.classList.remove("invisible", "pointer-events-none");
    backdrop.classList.add("visible");
    target = 0;
    if (reduceMotion) { y = 0; v = 0; applySpringStyles(); }
    else startSpring();
    attachObserver();
    window.dispatchEvent(new Event("open-pagefind"));
    requestAnimationFrame(() => {
      container.scrollTop = scrollMemory;
      document.querySelector("#search input")?.focus({ preventScroll: true });
    });
  }

  function closePagefind() {
    query();
    if (!pf.open) return;
    pf.open = false;
    if (container) scrollMemory = container.scrollTop;
    target = -14;
    startSpring();
    if (backdrop) {
      backdrop.classList.add("invisible", "pointer-events-none");
      backdrop.classList.remove("visible");
    }
    const input = document.querySelector("#search input");
    if (input) input.value = "";
    refreshResults();
    // return focus to whatever opened search
    if (openerEl?.focus) openerEl.focus({ preventScroll: true });
    openerEl = null;
  }

  window.togglePagefind = () => (pf.open ? closePagefind() : openPagefind());

  /* ── one-time document bindings (survive view transitions) ── */

  if (!window.__pfBound) {
    window.__pfBound = true;

    // input modality: mouse vs keyboard focus glow
    window.addEventListener("keydown", () => {
      document.documentElement.classList.add("keyboard-focus");
      document.documentElement.classList.remove("mouse-focus");
    });
    window.addEventListener("pointerdown", () => {
      document.documentElement.classList.add("mouse-focus");
      document.documentElement.classList.remove("keyboard-focus");
    });

    document.addEventListener("keydown", (e) => {
      // toggle
      if (e.key === "/" || ((e.metaKey || e.ctrlKey) && e.key === "k")) {
        const tag = document.activeElement?.tagName;
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        e.preventDefault();
        window.togglePagefind();
        return;
      }
      if (!pf.open) return;

      if (e.key === "Escape") {
        closePagefind();
        return;
      }

      // focus trap
      if (e.key === "Tab") {
        query();
        const f = [...container.querySelectorAll(
          'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])'
        )].filter((el) => el.offsetParent !== null);
        if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
        return;
      }
      // command-palette navigation
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(activeIdx + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(activeIdx - 1 < 0 ? 0 : activeIdx - 1);
      } else if (e.key === "Enter" && activeIdx >= 0) {
        e.preventDefault();
        openResult(activeIdx);
      }
    });

    document.addEventListener("click", (e) => {
      // click-away closes: anything in the overlay but outside the panel.
      // (Clicks land on #pagefind-shell, not #backdrop itself, so an
      // e.target === backdrop check never fires.)
      const bd = document.getElementById("backdrop");
      const pc = document.getElementById("pagefind-container");
      if (pf.open && bd && pc && bd.contains(e.target) && !pc.contains(e.target))
        closePagefind();

      // thumbnail click navigates
      const thumb = e.target.closest(".pagefind-ui__result-thumb");
      if (thumb) {
        const link = thumb.closest(".pagefind-ui__result")?.querySelector(".pagefind-ui__result-title a");
        if (!link) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) {
          window.open(link.href, "_blank");
          return;
        }
        window.location.href = link.href;
        return;
      }

      // quick-link click closes the panel first
      if (e.target.closest("#pf-quicklinks a")) closePagefind();
    });

    // typing toggles the empty state live
    document.addEventListener("input", (e) => {
      if (e.target?.closest?.("#search") && pf.open) refreshResults();
    });
  }

  query();
  applySpringStyles();
</script>

<style is:global>
  /* ════════════════════════════════════════════════════════════
     PAGEFIND — the search instrument
     Token-driven: --pf-* locals, --pc-accent / --pc-accent2 global.
     ════════════════════════════════════════════════════════════ */

  #pagefind-shell {
    min-height: 100dvh;
    padding: 1rem;
    --pf-bg: rgba(8, 10, 18, 0.55);
    --pf-text: #fbf1c7;
    --pf-dim: rgba(251, 241, 199, 0.6);
    --pf-accent: var(--petal-accent, var(--pf-accent));
    --pf-line: color-mix(in oklch, var(--pf-text) 14%, transparent);
  }
  html.light #pagefind-shell {
    --pf-bg: rgba(250, 250, 252, 0.62);
    --pf-text: #0b0e1a;
    --pf-dim: rgba(11, 14, 26, 0.6);
  }

  /* ── backdrop scrim ── */
  #backdrop {
    background: transparent;
    transition: background 240ms ease;
  }
  #backdrop.visible {
    background: color-mix(in oklch, black 22%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  html.light #backdrop.visible {
    background: color-mix(in oklch, white 28%, transparent);
  }

  /* ── the panel ── */
  #pagefind-container {
    background: var(--pf-bg);
    border: 1px solid color-mix(in oklch, var(--pf-accent) 25%, transparent);
    border-radius: 18px;
    color: var(--pf-text);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      0 12px 44px rgba(0, 0, 0, 0.35),
      0 0 40px color-mix(in oklch, var(--pf-accent) 8%, transparent);
  }
  html.light #pagefind-container {
    box-shadow:
      0 12px 40px rgba(11, 14, 26, 0.14),
      0 0 40px color-mix(in oklch, var(--pf-accent) 10%, transparent);
  }

  .pf-star {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 1.5px;
    background: conic-gradient(
      from var(--sa),
      transparent 0deg,
      transparent 300deg,
      color-mix(in oklch, var(--pf-accent) 55%, transparent) 330deg,
      var(--pf-accent) 350deg,
      transparent 360deg
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    animation: starOrbit 5s linear infinite;
    pointer-events: none;
  }

  .pf-dots {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: radial-gradient(
      color-mix(in oklch, var(--pf-text) 7%, transparent) 1px,
      transparent 1.6px
    );
    background-size: 14px 14px;
    pointer-events: none;
    opacity: 0.5;
  }

  .pf-bracket {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 2px solid color-mix(in oklch, var(--pf-accent) 45%, transparent);
    pointer-events: none;
    z-index: 3;
  }
  .pf-tl { top: 10px; left: 10px; border-right: none; border-bottom: none; border-top-left-radius: 5px; }
  .pf-tr { top: 10px; right: 10px; border-left: none; border-bottom: none; border-top-right-radius: 5px; }
  .pf-bl { bottom: 10px; left: 10px; border-right: none; border-top: none; border-bottom-left-radius: 5px; }
  .pf-br { bottom: 10px; right: 10px; border-left: none; border-top: none; border-bottom-right-radius: 5px; }

  .pf-body {
    position: relative;
    z-index: 1;
    padding: 1.1rem 1.25rem 0.9rem;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  /* ── the input ── */
  #pagefind-container .pagefind-ui__search-input {
    border-radius: 12px;
    overflow: hidden;
    background: transparent;
  }
  #pagefind-container .pagefind-ui__search-input input {
    width: 100%;
    padding: 0.8rem 1.1rem;
    border-radius: 12px;
    background: color-mix(in oklch, var(--pf-text) 6%, transparent);
    border: 1px solid color-mix(in oklch, var(--pf-text) 16%, transparent);
    color: var(--pf-text);
    caret-color: var(--pf-accent);
    outline: none;
    box-shadow: none;
    font-size: 1rem;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  #pagefind-container .pagefind-ui__search-input input::placeholder {
    color: var(--pf-dim);
  }
  #pagefind-container .pagefind-ui__search-input input:focus {
    border-color: color-mix(in oklch, var(--pf-accent) 60%, transparent);
  }
  .mouse-focus #pagefind-container .pagefind-ui__search-input input:focus {
    box-shadow: 0 0 calc(12px + 18px * var(--qi, 0))
      color-mix(in oklch, var(--pf-accent) 30%, transparent);
  }
  .keyboard-focus #pagefind-container .pagefind-ui__search-input input:focus {
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--pf-accent) 70%, transparent),
      0 0 calc(16px + 22px * var(--qi, 0))
        color-mix(in oklch, var(--pf-accent) 45%, transparent);
  }

  /* clear button: quiet */
  #pagefind-container .pagefind-ui__search-clear {
    background: transparent;
    border: none;
    box-shadow: none;
    color: var(--pf-dim);
  }
  #pagefind-container .pagefind-ui__search-clear:hover {
    color: var(--pf-text);
  }

  /* ── results ── */
  #pagefind-container .pagefind-ui__results-area {
    margin-top: 0.25rem;
  }
  #pagefind-container .pagefind-ui__results {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 2px;
  }
  #pagefind-container .pagefind-ui__result {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 0.7rem 0.8rem;
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }
  #pagefind-container .pagefind-ui__result:hover,
  #pagefind-container .pagefind-ui__result.pf-active {
    border-color: color-mix(in oklch, var(--pf-accent) 45%, transparent);
    background: color-mix(in oklch, var(--pf-accent) 9%, transparent);
  }
  #pagefind-container .pagefind-ui__result.pf-active {
    transform: translateX(3px);
  }
  #pagefind-container .pagefind-ui__result-thumb {
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    margin-top: 2px;
  }
  #pagefind-container .pagefind-ui__result-title {
    margin: 0 0 2px;
    font-weight: 700;
    font-size: 0.95rem;
  }
  #pagefind-container .pagefind-ui__result-title a {
    color: var(--pf-text);
    text-decoration: none;
  }
  #pagefind-container .pagefind-ui__result-title a:hover {
    color: var(--pf-accent);
  }
  #pagefind-container .pagefind-ui__result-excerpt {
    margin: 0;
    color: var(--pf-dim);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* matched terms: accent-lit, not invisible */
  #pagefind-container .pagefind-ui mark {
    background: color-mix(in oklch, var(--pf-accent) 32%, transparent);
    color: inherit;
    border-radius: 4px;
    padding: 0 2px;
  }

  #pagefind-container .pagefind-ui__message {
    color: var(--pf-dim);
    font-size: 0.85rem;
    padding: 0.6rem 0.2rem;
  }

  /* ── quick links (empty state) ── */
  #pf-quicklinks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 0.2rem 0.2rem;
  }
  .pf-qlabel {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--pf-dim);
    margin-right: 0.25rem;
  }
  .pf-qlink {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pf-text);
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border-radius: 0;
    border: 1px solid color-mix(in oklch, var(--pf-accent) 35%, transparent);
    background: color-mix(in oklch, var(--pf-accent) 8%, transparent);
    /* chamfered tag corners — edgy, no pills */
    clip-path: polygon(
      9px 0, 100% 0,
      100% calc(100% - 9px), calc(100% - 9px) 100%,
      0 100%, 0 9px
    );
    transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
  }
  .pf-qlink:hover {
    border-color: color-mix(in oklch, var(--pf-accent) 70%, transparent);
    background: color-mix(in oklch, var(--pf-accent) 16%, transparent);
    transform: translateY(-1px);
  }

  /* ── telemetry strip ── */
  #pf-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 0.2rem 0;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pf-dim);
  }
  #pf-count {
    font-weight: 700;
    color: var(--pf-accent);
  }
  #pf-count:empty {
    display: none;
  }
  .pf-hint kbd {
    font-family: inherit;
    font-size: 0.62rem;
    border: 1px solid color-mix(in oklch, var(--pf-text) 20%, transparent);
    border-radius: 4px;
    padding: 1px 5px;
    margin: 0 1px;
    line-height: 1;
  }

  /* ── one scrollbar, done right ── */
  #pagefind-container {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--pf-text) 30%, transparent) transparent;
  }
  #pagefind-container::-webkit-scrollbar {
    width: 6px;
  }
  #pagefind-container::-webkit-scrollbar-track {
    background: transparent;
  }
  #pagefind-container::-webkit-scrollbar-thumb {
    background: color-mix(in oklch, var(--pf-text) 25%, transparent);
    border-radius: 999px;
  }
  #pagefind-container::-webkit-scrollbar-thumb:hover {
    background: color-mix(in oklch, var(--pf-text) 45%, transparent);
  }

  #pagefind-container .pagefind-ui ::selection {
    background: color-mix(in oklch, var(--pf-accent) 35%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    #backdrop,
    #pagefind-shell,
    #pagefind-container .pagefind-ui__result,
    .pf-qlink {
      transition: none;
    }
  }
</style>
