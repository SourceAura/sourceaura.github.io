---
/*
PageFind: the search instrument.
A command-palette in the site's own design language — glass panel, corner
brackets, accent glow, telemetry — fully token-driven for both themes.
Now unified with Insei: her voice on top, Pagefind results beneath.
Command verbs (/book, /tour, /home) bypass full-text search.
*/
import Search from "astro-pagefind/components/Search";
---

<div
  id="backdrop"
  class="pointer-events-none invisible fixed inset-0 z-40"
>
  <div id="pagefind-shell" class="flex items-center justify-center">
    <div id="pagefind-container" class="relative flex max-h-[70vh] w-full max-w-screen-sm flex-col overflow-hidden" role="dialog" aria-modal="true" aria-label="Search the site">
      <!-- corner brackets -->
      <span class="pf-bracket pf-tl" aria-hidden="true"></span>
      <span class="pf-bracket pf-tr" aria-hidden="true"></span>
      <span class="pf-bracket pf-bl" aria-hidden="true"></span>
      <span class="pf-bracket pf-br" aria-hidden="true"></span>
      <!-- dot grid -->
      <div class="pf-dots" aria-hidden="true"></div>
      <span class="pf-star" aria-hidden="true"></span>

      <div class="pf-body">
        <Search
          id="search"
          className="pagefind-ui"
          uiOptions={{
            showImages: true,
            excerptLength: 22,
            showSubResults: true,
            resetStyles: false,
          }}
        />

        <!-- Insei oracle region (whisper, answer, routes, quiet divider) -->
        <div id="insei-oracle" class="insei-oracle" aria-live="polite">
          <div id="insei-whisper" class="insei-whisper-line" style="display: none;"></div>
          <div id="insei-voice" class="insei-voice-box" style="display: none;"></div>
          <div id="insei-routes-pf" class="insei-routes-pf" style="display: none;"></div>
          <div id="insei-divider" class="insei-divider" style="display: none;" aria-hidden="true">
            <span class="insei-divider-label">the Ark holds:</span>
          </div>
        </div>

        <!-- quick links: the empty-state -->
        <div id="pf-quicklinks" aria-label="Quick links">
          <span class="pf-qlabel">JUMP TO</span>
          <a class="pf-qlink" href="/petals">Petals</a>
          <a class="pf-qlink" href="/euthymia">Play Euthymia</a>
          <a class="pf-qlink" href="/petals/09-insei/">Insei</a>
          <a class="pf-qlink" href="/resume">Resume</a>
        </div>

        <!-- telemetry strip -->
        <div id="pf-status">
          <span id="pf-count" role="status" aria-live="polite"></span>
          <span class="pf-hint"><kbd>↑</kbd><kbd>↓</kbd> navigate · <kbd>↵</kbd> open · <kbd>esc</kbd> close</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Element refs are re-queried on every open: with Astro view transitions
  // the DOM (and these nodes) may be swapped between opens, so nothing here
  // holds a stale reference across navigations.
  let backdrop, shell, container, searchEl, inputEl, quicklinks, countEl;
  let inseiOracle, inseiWhisper, inseiVoice, inseiRoutes, inseiDivider;

  function query() {
    backdrop = document.getElementById("backdrop");
    shell = document.getElementById("pagefind-shell");
    container = document.getElementById("pagefind-container");
    searchEl = document.getElementById("search");
    inputEl = document.querySelector("#search input");
    quicklinks = document.getElementById("pf-quicklinks");
    countEl = document.getElementById("pf-count");
    inseiOracle = document.getElementById("insei-oracle");
    inseiWhisper = document.getElementById("insei-whisper");
    inseiVoice = document.getElementById("insei-voice");
    inseiRoutes = document.getElementById("insei-routes-pf");
    inseiDivider = document.getElementById("insei-divider");

    const form = searchEl?.querySelector(".pagefind-ui__form");
    if (form && inseiOracle && form.nextElementSibling !== inseiOracle) {
      form.after(inseiOracle);
    }
  }

  // shared across script re-executions: Astro view transitions re-run this
  // script, while the one-time document bindings below keep the FIRST run's
  // scope. A module-level `let pf.open` goes stale after any navigation.
  const pf = (window.__pf ??= { open: false });
  let scrollMemory = 0;
  let activeIdx = -1;
  let openerEl = null;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Spring physics for the open/close motion
  let y = -14, v = 0, target = -14, rafSpring = 0, lastT = 0;
  const STIFFNESS = 520, DAMPING = 38, MASS = 1;

  function applySpringStyles() {
    if (!shell) return;
    const p = Math.max(0, Math.min(1, 1 - Math.abs(y) / 14));
    shell.style.transform = `translateY(${y}px) scale(${0.985 + 0.015 * p})`;
    shell.style.opacity = String(0.1 + 0.9 * p);
    document.documentElement.style.setProperty("--qi", p.toFixed(4));
  }

  function tickSpring(t) {
    const dt = Math.min((t - lastT) / 1000, 0.033);
    lastT = t;
    const F = -STIFFNESS * (y - target) - DAMPING * v;
    v += (F / MASS) * dt;
    y += v * dt;
    if (Math.abs(v) < 0.02 && Math.abs(y - target) < 0.05) {
      y = target; v = 0;
      applySpringStyles();
      rafSpring = 0;
      return;
    }
    applySpringStyles();
    rafSpring = requestAnimationFrame(tickSpring);
  }

  function startSpring() {
    if (rafSpring || !shell) return;
    lastT = performance.now();
    rafSpring = requestAnimationFrame(tickSpring);
  }

  /* ── Insei Voice & Rotating Placeholders ── */

  const PLACEHOLDER_PROMPTS = [
    "Ask about the seven…",
    "Book a repair…",
    "Find the axolotl post…",
  ];
  let placeholderTimer = 0;
  let placeholderIdx = 0;

  function stopPlaceholderRotation() {
    if (placeholderTimer) {
      clearInterval(placeholderTimer);
      placeholderTimer = 0;
    }
  }

  function startPlaceholderRotation() {
    stopPlaceholderRotation();
    if (!inputEl) return;
    inputEl.placeholder = PLACEHOLDER_PROMPTS[placeholderIdx % PLACEHOLDER_PROMPTS.length];
    placeholderTimer = window.setInterval(() => {
      placeholderIdx++;
      if (inputEl && !inputEl.value.trim()) {
        inputEl.placeholder = PLACEHOLDER_PROMPTS[placeholderIdx % PLACEHOLDER_PROMPTS.length];
      }
    }, 3200);
  }

  function inseiStatusLine() {
    const hour = Number(
      new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Chicago",
        hour: "numeric",
        hour12: false,
      }).format(new Date())
    );
    const inLab = hour >= 20 || hour < 6;
    return inLab
      ? "Sensei is in the lab — the small hours are sensei's hours."
      : "Sensei rests — back in the lab in the small hours.";
  }

  function limitSentences(text, max = 3) {
    if (!text) return "";
    const sentences = text.match(/[^.!?]+[.!?]+(\s|$)/g);
    if (!sentences || sentences.length <= max) return text;
    return sentences.slice(0, max).join("").trim();
  }

  function escHtml(str) {
    return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  const BOOKING_MAIL = "mailto:sourceaura@proton.me?subject=Computer%20repair%20booking";

  function renderInseiRegion() {
    query();
    if (!inseiOracle) return;
    const q = inputEl?.value.trim() ?? "";
    const drawer = searchEl?.querySelector(".pagefind-ui__drawer");
    const insei = window.__insei;

    // DIRECTIVE 3: Command verbs starting with /
    if (q.startsWith("/")) {
      // Verbs never hit Pagefind and never hit the intent engine
      if (drawer) drawer.style.display = "none";
      if (inseiDivider) inseiDivider.style.display = "none";
      if (countEl) countEl.textContent = "";
      if (quicklinks) quicklinks.style.display = "none";
      stopPlaceholderRotation();
      if (inseiWhisper) {
        inseiWhisper.textContent = "";
        inseiWhisper.style.display = "none";
      }

      const verb = q.toLowerCase().split(/\s+/)[0];

      if (verb === "/book") {
        if (inseiVoice) {
          inseiVoice.innerHTML = "<p>Sensei takes repair commissions in Nashville — the mending of machines. Directing your dispatch.</p>";
          inseiVoice.style.display = "";
        }
        if (inseiRoutes) {
          inseiRoutes.innerHTML = "";
          const link = document.createElement("a");
          link.className = "pf-route-btn";
          link.href = BOOKING_MAIL;
          link.textContent = "commission sensei →";
          inseiRoutes.appendChild(link);
          inseiRoutes.style.display = "flex";
        }
      } else if (verb === "/tour") {
        if (inseiVoice) {
          inseiVoice.innerHTML = "<p>The docent walk through the sanctums is being forged; soon I shall guide you step by step.</p>";
          inseiVoice.style.display = "";
        }
        if (inseiRoutes) {
          inseiRoutes.innerHTML = "";
          inseiRoutes.style.display = "none";
        }
      } else if (verb === "/home") {
        if (inseiVoice) {
          inseiVoice.innerHTML = "<p>Returning to orbit.</p>";
          inseiVoice.style.display = "";
        }
        if (inseiRoutes) {
          inseiRoutes.innerHTML = "";
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "pf-route-btn";
          btn.textContent = "back to orbit →";
          btn.addEventListener("click", () => {
            closePagefind();
            if (window.location.pathname !== "/") {
              window.location.href = "/";
            }
          });
          inseiRoutes.appendChild(btn);
          inseiRoutes.style.display = "flex";
        }
      } else {
        // Unknown /verb
        if (inseiVoice) {
          inseiVoice.innerHTML = "<p>I do not know that rite yet.</p>";
          inseiVoice.style.display = "";
        }
        if (inseiRoutes) {
          inseiRoutes.innerHTML = "";
          inseiRoutes.style.display = "none";
        }
      }
      return;
    }

    // Restore drawer for non-verb queries
    if (drawer) drawer.style.display = "";

    if (!q) {
      // Empty input state
      if (inseiVoice) { inseiVoice.innerHTML = ""; inseiVoice.style.display = "none"; }
      if (inseiRoutes) { inseiRoutes.innerHTML = ""; inseiRoutes.style.display = "none"; }
      if (inseiDivider) { inseiDivider.style.display = "none"; }

      const lastWhisper = insei?.lastWhisper;
      if (lastWhisper && inseiWhisper) {
        stopPlaceholderRotation();
        if (inputEl) inputEl.placeholder = "Ask of the ark or search…";
        inseiWhisper.textContent = `“${lastWhisper}”`;
        inseiWhisper.style.display = "";
      } else {
        if (inseiWhisper) {
          inseiWhisper.textContent = "";
          inseiWhisper.style.display = "none";
        }
        startPlaceholderRotation();
      }
      return;
    }

    // Visitor is typing a question / search query
    stopPlaceholderRotation();
    if (inseiWhisper) {
      inseiWhisper.textContent = "";
      inseiWhisper.style.display = "none";
    }

    const ans = insei?.ask ? insei.ask(q, { statusLine: inseiStatusLine }) : null;
    const isConfident = ans && ans.entryId && ans.entryId !== "fallback";

    if (isConfident) {
      const voiceText = limitSentences(ans.text, 3);
      if (inseiVoice) {
        inseiVoice.innerHTML = `<p>${escHtml(voiceText)}</p>`;
        inseiVoice.style.display = "";
      }
      if (inseiRoutes) {
        const routes = (ans.routes || []).filter((r) => r !== "boundaries");
        if (routes.length) {
          inseiRoutes.innerHTML = "";
          routes.forEach((rId) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "pf-route-btn";
            btn.textContent = insei?.routeLabel ? insei.routeLabel(rId) : rId;
            btn.addEventListener("click", () => {
              if (!inputEl) return;
              inputEl.value = insei?.routeLabel ? insei.routeLabel(rId) : rId;
              inputEl.focus();
              inputEl.dispatchEvent(new Event("input", { bubbles: true }));
            });
            inseiRoutes.appendChild(btn);
          });
          inseiRoutes.style.display = "flex";
        } else {
          inseiRoutes.innerHTML = "";
          inseiRoutes.style.display = "none";
        }
      }
      if (inseiDivider) {
        inseiDivider.style.display = "flex";
      }
    } else {
      // No confident answer — ceremonial yield to results
      if (inseiVoice) {
        inseiVoice.innerHTML = "<p>That is beyond what sensei has entrusted to me — the Ark yields its records below.</p>";
        inseiVoice.style.display = "";
      }
      if (inseiRoutes) {
        inseiRoutes.innerHTML = "";
        inseiRoutes.style.display = "none";
      }
      if (inseiDivider) {
        inseiDivider.style.display = "flex";
      }
    }
  }

  /* ── results: count, empty state, keyboard nav ── */

  function resultItems() {
    return [...document.querySelectorAll("#search .pagefind-ui__result")];
  }

  function setActive(i) {
    const items = resultItems();
    if (!items.length) return;
    activeIdx = Math.max(0, Math.min(i, items.length - 1));
    items.forEach((el, j) => {
      const on = j === activeIdx;
      el.classList.toggle("pf-active", on);
      if (on) el.setAttribute("aria-selected", "true");
      else el.removeAttribute("aria-selected");
    });
    items[activeIdx]?.scrollIntoView({ block: "nearest" });
  }

  function refreshResults() {
    const q = inputEl?.value.trim() ?? "";
    if (q.startsWith("/")) {
      if (countEl) countEl.textContent = "";
      if (quicklinks) quicklinks.style.display = "none";
      return;
    }
    const items = resultItems();
    activeIdx = -1;
    if (countEl) {
      countEl.textContent = items.length
        ? `${items.length} result${items.length === 1 ? "" : "s"}`
        : "";
    }
    if (quicklinks) quicklinks.style.display = !q && !items.length ? "" : "none";
  }

  let pfObserver;
  function attachObserver() {
    pfObserver?.disconnect();
    const target = document.getElementById("search");
    if (!target) return;
    pfObserver = new MutationObserver(() => {
      refreshResults();
      query();
    });
    pfObserver.observe(target, { childList: true, subtree: true });
    refreshResults();
  }

  function openResult(i) {
    const link = resultItems()[i]?.querySelector(".pagefind-ui__result-title a");
    if (link) window.location.href = link.href;
  }

  /* ── open / close ── */

  function openPagefind() {
    query();
    if (!backdrop || !container) return;
    openerEl = document.activeElement;
    pf.open = true;
    backdrop.classList.remove("invisible", "pointer-events-none");
    backdrop.classList.add("visible");
    target = 0;
    if (reduceMotion) { y = 0; v = 0; applySpringStyles(); }
    else startSpring();
    attachObserver();
    window.dispatchEvent(new Event("open-pagefind"));
    renderInseiRegion();
    requestAnimationFrame(() => {
      container.scrollTop = scrollMemory;
      document.querySelector("#search input")?.focus({ preventScroll: true });
      renderInseiRegion();
    });
  }

  function closePagefind() {
    query();
    stopPlaceholderRotation();
    if (!pf.open) return;
    pf.open = false;
    if (container) scrollMemory = container.scrollTop;
    target = -14;
    startSpring();
    if (backdrop) {
      backdrop.classList.add("invisible", "pointer-events-none");
      backdrop.classList.remove("visible");
    }
    const input = document.querySelector("#search input");
    if (input) input.value = "";
    refreshResults();
    renderInseiRegion();
    window.dispatchEvent(new Event("close-pagefind"));
    // return focus to whatever opened search
    if (openerEl?.focus) openerEl.focus({ preventScroll: true });
    openerEl = null;
  }

  window.openPagefind = openPagefind;
  window.closePagefind = closePagefind;
  window.togglePagefind = () => (pf.open ? closePagefind() : openPagefind());

  /* ── one-time document bindings (survive view transitions) ── */

  if (!window.__pfBound) {
    window.__pfBound = true;

    // input modality: mouse vs keyboard focus glow
    window.addEventListener("keydown", () => {
      document.documentElement.classList.add("keyboard-focus");
      document.documentElement.classList.remove("mouse-focus");
    });
    window.addEventListener("pointerdown", () => {
      document.documentElement.classList.add("mouse-focus");
      document.documentElement.classList.remove("keyboard-focus");
    });

    document.addEventListener("keydown", (e) => {
      const active = document.activeElement;
      const tag = active?.tagName;
      const isInput =
        tag === "INPUT" ||
        tag === "TEXTAREA" ||
        tag === "SELECT" ||
        (active && (active.isContentEditable || active.getAttribute("contenteditable") === "true"));

      // toggle: Cmd+K / Ctrl+K opens globally (preventDefault)
      if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
        e.preventDefault();
        window.togglePagefind();
        return;
      }

      // 'a' or 'A' opens unified window, never while typing in an input/textarea/select/editable
      if (!isInput && !e.metaKey && !e.ctrlKey && !e.altKey && (e.key === "a" || e.key === "A")) {
        e.preventDefault();
        if (!pf.open) openPagefind();
        return;
      }

      // '/' opens search when not in editable field
      if (!isInput && !e.metaKey && !e.ctrlKey && !e.altKey && e.key === "/") {
        e.preventDefault();
        window.togglePagefind();
        return;
      }

      if (!pf.open) return;

      if (e.key === "Escape") {
        closePagefind();
        return;
      }

      // focus trap
      if (e.key === "Tab") {
        query();
        const f = [...container.querySelectorAll(
          'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])'
        )].filter((el) => el.offsetParent !== null);
        if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
        return;
      }

      // Enter key: verb execution or result opening
      if (e.key === "Enter") {
        const q = inputEl?.value.trim() ?? "";
        if (q.startsWith("/")) {
          e.preventDefault();
          const verb = q.toLowerCase().split(/\s+/)[0];
          if (verb === "/home") {
            closePagefind();
            if (window.location.pathname !== "/") {
              window.location.href = "/";
            }
            return;
          }
          if (verb === "/book") {
            window.location.href = BOOKING_MAIL;
            return;
          }
          return;
        }
        if (activeIdx >= 0) {
          e.preventDefault();
          openResult(activeIdx);
          return;
        }
      }

      // command-palette navigation
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(activeIdx + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(activeIdx - 1 < 0 ? 0 : activeIdx - 1);
      }
    });

    document.addEventListener("click", (e) => {
      // click-away closes: anything in the overlay but outside the panel.
      const bd = document.getElementById("backdrop");
      const pc = document.getElementById("pagefind-container");
      if (pf.open && bd && pc && bd.contains(e.target) && !pc.contains(e.target))
        closePagefind();

      // thumbnail click navigates
      const thumb = e.target.closest(".pagefind-ui__result-thumb");
      if (thumb) {
        const link = thumb.closest(".pagefind-ui__result")?.querySelector(".pagefind-ui__result-title a");
        if (!link) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) {
          window.open(link.href, "_blank");
          return;
        }
        window.location.href = link.href;
        return;
      }

      // quick-link click closes the panel first
      if (e.target.closest("#pf-quicklinks a")) closePagefind();
    });

    // typing toggles the empty state live and renders Insei voice region
    document.addEventListener("input", (e) => {
      if (e.target?.closest?.("#search") && pf.open) {
        refreshResults();
        renderInseiRegion();
      }
    });
  }

  query();
  applySpringStyles();
</script>

<style is:global>
  /* ════════════════════════════════════════════════════════════
     PAGEFIND — the search instrument
     Token-driven: --pf-* locals, --pc-accent / --pc-accent2 global.
     ════════════════════════════════════════════════════════════ */

  #pagefind-shell {
    min-height: 100dvh;
    padding: 1rem;
    --pf-bg: rgba(8, 10, 18, 0.55);
    --pf-text: #fbf1c7;
    --pf-dim: rgba(251, 241, 199, 0.6);
    --pf-accent: var(--petal-accent, var(--pf-accent));
    --pf-line: color-mix(in oklch, var(--pf-text) 14%, transparent);
  }
  html.light #pagefind-shell {
    --pf-bg: rgba(250, 250, 252, 0.62);
    --pf-text: #0b0e1a;
    --pf-dim: rgba(11, 14, 26, 0.6);
  }

  /* ── backdrop scrim ── */
  #backdrop {
    background: transparent;
    transition: background 240ms ease;
  }
  #backdrop.visible {
    background: color-mix(in oklch, black 22%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  html.light #backdrop.visible {
    background: color-mix(in oklch, white 28%, transparent);
  }

  /* ── the panel ── */
  #pagefind-container {
    background: var(--pf-bg);
    border: 1px solid color-mix(in oklch, var(--pf-accent) 25%, transparent);
    border-radius: 18px;
    color: var(--pf-text);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      0 12px 44px rgba(0, 0, 0, 0.35),
      0 0 40px color-mix(in oklch, var(--pf-accent) 8%, transparent);
  }
  html.light #pagefind-container {
    box-shadow:
      0 12px 40px rgba(11, 14, 26, 0.14),
      0 0 40px color-mix(in oklch, var(--pf-accent) 10%, transparent);
  }

  .pf-star {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 1.5px;
    background: conic-gradient(
      from var(--sa),
      transparent 0deg,
      transparent 300deg,
      color-mix(in oklch, var(--pf-accent) 55%, transparent) 330deg,
      var(--pf-accent) 350deg,
      transparent 360deg
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    animation: starOrbit 5s linear infinite;
    pointer-events: none;
  }

  .pf-dots {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: radial-gradient(
      color-mix(in oklch, var(--pf-text) 7%, transparent) 1px,
      transparent 1.6px
    );
    background-size: 14px 14px;
    pointer-events: none;
    opacity: 0.5;
  }

  .pf-bracket {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 2px solid color-mix(in oklch, var(--pf-accent) 45%, transparent);
    pointer-events: none;
    z-index: 3;
  }
  .pf-tl { top: 10px; left: 10px; border-right: none; border-bottom: none; border-top-left-radius: 5px; }
  .pf-tr { top: 10px; right: 10px; border-left: none; border-bottom: none; border-top-right-radius: 5px; }
  .pf-bl { bottom: 10px; left: 10px; border-right: none; border-top: none; border-bottom-left-radius: 5px; }
  .pf-br { bottom: 10px; right: 10px; border-left: none; border-top: none; border-bottom-right-radius: 5px; }

  .pf-body {
    position: relative;
    z-index: 1;
    padding: 1.1rem 1.25rem 0.9rem;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  /* ── the input ── */
