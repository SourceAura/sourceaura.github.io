---
/*
Quasar: a component that displays a StarField background.
*/
---

<quasar-background transition:persist></quasar-background>

<style is:global>
  quasar-background {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100dvh !important;
    display: block !important;
    z-index: 0 !important;
    pointer-events: none !important;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  quasar-background canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
  }
</style>

<script>
  const COUNT = 150;
  const SPEED = 0.05;
  const MAX_DT = 2;

  const lerp = (a, b, t) => a + (b - a) * t;
  const clamp = (n, a, b) => Math.max(a, Math.min(b, n));

  class Star {
    constructor(spread) {
      this.spread = spread;
      this.reset(0, 0, spread);
    }

    reset(cx, cy, spread) {
      this.x = cx + (Math.random() - 0.5) * spread;
      this.y = cy + (Math.random() - 0.5) * spread;
      this.z = Math.random();
      this.xPrev = this.x;
      this.yPrev = this.y;
      // twinkle: ~35% of stars breathe on a slow sine
      this.tw = Math.random() < 0.35 ? Math.random() * Math.PI * 2 : null;
      this.twSpeed = 1.2 + Math.random() * 2.2;
      // color temperature: a whisper of warm/cool, most stay white
      const tr = Math.random();
      this.tint = tr < 0.08 ? "warm" : tr < 0.15 ? "cool" : null;
    }

    update(cx, cy, spread, speed, dt) {
      this.xPrev = this.x;
      this.yPrev = this.y;

      this.z += speed * 0.07 * dt;
      this.x += (this.x - cx) * speed * this.z * dt;
      this.y += (this.y - cy) * speed * this.z * dt;

      const half = spread / 2;
      if (
        this.x < cx - half ||
        this.x > cx + half ||
        this.y < cy - half ||
        this.y > cy + half
      ) {
        this.reset(cx, cy, spread);
      }
    }

    draw(ctx, light, t) {
      let a = Math.min(this.z, 1);
      if (this.tw !== null) a *= 0.55 + 0.45 * Math.sin(t * this.twSpeed + this.tw);
      if (!light && this.tint === "warm")
        ctx.strokeStyle = `rgba(255,228,178,${a})`;
      else if (!light && this.tint === "cool")
        ctx.strokeStyle = `rgba(150,224,205,${a})`;
      else ctx.strokeStyle = light ? `rgba(0,0,0,${a})` : `rgba(255,255,255,${a})`;
      ctx.lineWidth = Math.min(this.z * 0.6, 2);
      ctx.beginPath();
      ctx.moveTo(this.xPrev, this.yPrev);
      ctx.lineTo(this.x, this.y);
      ctx.stroke();
    }
  }

  // Meteors: the field's own stars going blaze — same radial warp flow as
  // every other star, just faster, bigger, brighter. Additive only.
  class Meteor {
    constructor(cx, cy, spread) {
      // pick a warp line: random angle out from the field center
      const ang = Math.random() * Math.PI * 2;
      this.ux = Math.cos(ang);
      this.uy = Math.sin(ang);
      // ignite near the center, like the rest of the field
      const r0 = spread * (0.03 + Math.random() * 0.08);
      this.x = cx + this.ux * r0;
      this.y = cy + this.uy * r0;
      // much faster than the ambient stars, constant blaze speed
      this.speed = spread * (1.1 + Math.random() * 0.7);
      this.life = 0;
      this.maxLife = 1.1 + Math.random() * 0.5;
      this.len = 130 + Math.random() * 140;
      this.width = 2 + Math.random() * 1.4;
      this.phase = Math.random() * Math.PI * 2;
    }

    update(dtSec, cx, cy, spread) {
      this.life += dtSec;
      const d = this.speed * dtSec;
      this.x += this.ux * d;
      this.y += this.uy * d;
      // burn out on time or past the field edge — same boundary as the stars
      const half = spread / 2;
      const out =
        this.x < cx - half ||
        this.x > cx + half ||
        this.y < cy - half ||
        this.y > cy + half;
      return this.life < this.maxLife && !out;
    }

    draw(ctx, light, t) {
      const lt = this.life / this.maxLife;
      const fade = lt < 0.12 ? lt / 0.12 : 1 - (lt - 0.12) / 0.88;
      const a = Math.max(0, Math.min(1, fade));
      if (a <= 0) return;

      const tx = this.x - this.ux * this.len;
      const ty = this.y - this.uy * this.len;

      const head = light ? [26, 26, 26] : [255, 255, 255];
      const teal = light ? [30, 111, 92] : [67, 170, 136];
      const gold = light ? [138, 109, 0] : [246, 195, 9];

      const g = ctx.createLinearGradient(this.x, this.y, tx, ty);
      g.addColorStop(0, `rgba(${head[0]},${head[1]},${head[2]},${a})`);
      g.addColorStop(0.22, `rgba(${teal[0]},${teal[1]},${teal[2]},${a * 0.85})`);
      g.addColorStop(0.55, `rgba(${gold[0]},${gold[1]},${gold[2]},${a * 0.45})`);
      g.addColorStop(1, `rgba(${gold[0]},${gold[1]},${gold[2]},0)`);

      ctx.lineCap = "round";
      ctx.strokeStyle = g;
      // soft outer trail
      ctx.globalAlpha = 0.5;
      ctx.lineWidth = this.width * 2.2;
      ctx.beginPath();
      ctx.moveTo(this.x, this.y);
      ctx.lineTo(tx, ty);
      ctx.stroke();
      // bright core
      ctx.globalAlpha = 1;
      ctx.lineWidth = this.width;
      ctx.beginPath();
      ctx.moveTo(this.x, this.y);
      ctx.lineTo(tx, ty);
      ctx.stroke();

      // white-hot head, shimmering as it burns
      const shimmer = 0.72 + 0.28 * Math.sin(t * 42 + this.phase);
      ctx.fillStyle = `rgba(${head[0]},${head[1]},${head[2]},${a * shimmer})`;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.width * 0.9, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalAlpha = 1;
    }
  }

  class QuasarBackground extends HTMLElement {
    constructor() {
      super();
      this.canvas = document.createElement("canvas");
      this.ctx = this.canvas.getContext("2d", { alpha: true });

      this.stars = [];
      this.meteors = [];
      this._nextMeteor = 0;
      this._reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      this.lastTime = 0;
      this.lastDraw = 0;
      this.isLight = false;

      this.base = { cx: 0, cy: 0, spread: 0 };
      this.influence = { x: 0.5, y: 0.5, a: 0, d: 0 };
      this.influenceLive = { x: 0.5, y: 0.5, a: 0, d: 0 };

      this._mounted = false;
      this._raf = 0;

      this._w = 0;
      this._h = 0;

      this._isMobile =
        matchMedia("(max-width: 768px)").matches ||
        /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

      // Cap DPR a bit harder on mobile to reduce fill-rate
      this._dprCap = this._isMobile ? 1.6 : 2;

      // FPS cap: mobile gets calmer updates, desktop stays smooth
      this._fps = this._isMobile ? 30 : 55;
      this._minFrameMs = 1000 / this._fps;

      this._resizeQueued = false;
      this._themeMO = null;

      this._onPetalLight = (e) => {
        const d = e.detail || {};
        this.influence.x = clamp(d.x ?? 0.5, 0, 1);
        this.influence.y = clamp(d.y ?? 0.5, 0, 1);
        this.influence.a = clamp(d.a ?? 0, 0, 1);
        this.influence.d = clamp(d.d ?? 0, 0, 1);
      };

      this._onVisibility = () => {
        if (document.hidden) {
          if (this._raf) cancelAnimationFrame(this._raf);
          this._raf = 0;
          return;
        }
        // resume
        this.lastTime = performance.now();
        this.lastDraw = 0;
        if (!this._raf) this._raf = requestAnimationFrame(this.frame);
      };

      this._onResize = () => this.queueResize();
    }

    connectedCallback() {
      // Guard against double-mount
      if (this._mounted) return;
      this._mounted = true;

      this.appendChild(this.canvas);

      if (window.visualViewport) {
        window.visualViewport.addEventListener("resize", this._onResize, {
          passive: true,
        });
      } else {
        window.addEventListener("resize", this._onResize, { passive: true });
      }
      window.addEventListener("orientationchange", this._onResize, {
        passive: true,
      });

      window.addEventListener("petal:light", this._onPetalLight, {
        passive: true,
      });

      document.addEventListener("visibilitychange", this._onVisibility, {
        passive: true,
      });

      this.resize(true);
      this.watchTheme();

      this.lastTime = performance.now();
      this._nextMeteor = performance.now() + 2500 + Math.random() * 3500;
      this._raf = requestAnimationFrame(this.frame);
    }

    disconnectedCallback() {
      // Cleanup (prevents leaks on Astro swaps)
      if (this._raf) cancelAnimationFrame(this._raf);
      this._raf = 0;

      if (window.visualViewport) {
        window.visualViewport.removeEventListener("resize", this._onResize);
      } else {
        window.removeEventListener("resize", this._onResize);
      }
      window.removeEventListener("orientationchange", this._onResize);

      window.removeEventListener("petal:light", this._onPetalLight);
      document.removeEventListener("visibilitychange", this._onVisibility);

      this._themeMO?.disconnect?.();
      this._themeMO = null;

      this._mounted = false;
    }

    queueResize() {
      if (this._resizeQueued) return;
      this._resizeQueued = true;
      requestAnimationFrame(() => {
        this._resizeQueued = false;
        this.resize(false);
      });
    }

    resize(force) {
      const width = window.visualViewport
        ? Math.round(window.visualViewport.width)
        : Math.round(window.innerWidth);
      const height = window.visualViewport
        ? Math.round(window.visualViewport.height)
        : Math.round(window.innerHeight);

      // Prevent thrash: only re-layout if size truly changed
      if (!force && width === this._w && height === this._h) return;

      this._w = width;
      this._h = height;

      const dpr = Math.min(window.devicePixelRatio || 1, this._dprCap);

      this.canvas.width = Math.max(1, Math.floor(width * dpr));
      this.canvas.height = Math.max(1, Math.floor(height * dpr));
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      this.base.cx = width / 2;
      this.base.cy = height / 2;
      this.base.spread = Math.max(width, height) * 1.3;

      // Keep the same “field”, but lighten density on mobile a bit.
      const targetCount = this._isMobile ? Math.round(COUNT * 0.72) : COUNT;

      // Only rebuild stars when needed
      if (this.stars.length !== targetCount) {
        // Reuse existing stars when possible to avoid GC pressure
        const diff = targetCount - this.stars.length;
        if (diff > 0) {
          for (let i = 0; i < diff; i++) {
            this.stars.push(new Star(this.base.spread));
          }
        } else {
          this.stars.splice(targetCount);
        }
      }

      for (const s of this.stars)
        s.reset(this.base.cx, this.base.cy, this.base.spread);
    }

    watchTheme() {
      const update = () => {
        this.isLight = document.documentElement.classList.contains("light");
      };
      update();
      this._themeMO = new MutationObserver(update);
      this._themeMO.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      });
    }

    frame = (t) => {
      if (document.hidden) return; // extra safety

      // FPS cap (mobile)
      if (this.lastDraw && t - this.lastDraw < this._minFrameMs) {
        this._raf = requestAnimationFrame(this.frame);
        return;
      }
      this.lastDraw = t;

      const dt = Math.min((t - this.lastTime) / 16.67, MAX_DT);
      const dtSec = Math.min((t - this.lastTime) / 1000, 0.1);
      const tSec = t / 1000;
      this.lastTime = t;

      // Smooth influence so it feels like gravity, not a pointer
      this.influenceLive.x = lerp(this.influenceLive.x, this.influence.x, 0.08);
      this.influenceLive.y = lerp(this.influenceLive.y, this.influence.y, 0.08);
      this.influenceLive.a = lerp(this.influenceLive.a, this.influence.a, 0.06);
      this.influenceLive.d = lerp(this.influenceLive.d, this.influence.d, 0.06);

      const width =
        this._w ||
        (window.visualViewport
          ? window.visualViewport.width
          : window.innerWidth);
      const height =
        this._h ||
        (window.visualViewport
          ? window.visualViewport.height
          : window.innerHeight);

      const shiftMax = 18;
      const dx = (this.influenceLive.x - 0.5) * 2;
      const dy = (this.influenceLive.y - 0.5) * 2;

      const cx = this.base.cx + dx * shiftMax * this.influenceLive.a;
      const cy = this.base.cy + dy * shiftMax * this.influenceLive.a;

      const compress = 1 - 0.1 * this.influenceLive.a;
      const spread = this.base.spread * compress;

      // Clear (use cached width/height)
      this.ctx.clearRect(0, 0, width, height);

      for (const s of this.stars) {
        s.update(cx, cy, spread, SPEED, dt);
        s.draw(this.ctx, this.isLight, tSec);
      }

      // meteors: rare visitors, never more than two
      if (
        !this._reduceMotion &&
        this.meteors.length < 2 &&
        t >= this._nextMeteor
      ) {
        this.meteors.push(new Meteor(cx, cy, spread));
        this._nextMeteor = t + 4500 + Math.random() * 5000;
      }
      for (let i = this.meteors.length - 1; i >= 0; i--) {
        if (!this.meteors[i].update(dtSec, cx, cy, spread)) this.meteors.splice(i, 1);
        else this.meteors[i].draw(this.ctx, this.isLight, tSec);
      }

      this._raf = requestAnimationFrame(this.frame);
    };
  }

  if (!customElements.get("quasar-background")) {
    customElements.define("quasar-background", QuasarBackground);
  }
</script>
