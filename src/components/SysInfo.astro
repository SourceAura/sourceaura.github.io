---
import Container from "@components/Container.astro";
---

<Container style="width: 260px; overflow: hidden; padding: 0 10px;">
  <button
    id="beacon-btn"
    type="button"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-controls="beacon-panel"
    aria-label="0xSrcAura's status — open now panel"
    class="group relative flex w-full items-center overflow-hidden rounded-full border border-black/15 hover:bg-black/5 focus-visible:bg-black/5 dark:border-white/20 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
    style="background-color: transparent; cursor: pointer;"
  >
    <canvas
      id="heartbeat"
      width="180"
      height="18"
      class="pointer-events-none absolute inset-0 m-auto"
      style="z-index: 0;"></canvas>

    <div class="relative z-10 flex w-full items-center px-3">
      <span
        data-role="sysinfo-time"
        class="text-ghost-600 cursor-pointer text-sm"
        style="white-space: nowrap;"></span>

      <span aria-hidden="true" class="block" style="width: 80px;"></span>

      <span
        id="beacon-dot"
        class="beacon-dot ml-auto"
        title="status"></span>
    </div>
  </button>

  <!-- BEACON NOW PANEL -->
  <div id="beacon-panel" role="dialog" aria-label="Now" tabindex="-1" hidden>
    <span class="bcn-corner tl" aria-hidden="true"></span>
    <span class="bcn-corner tr" aria-hidden="true"></span>
    <span class="bcn-corner bl" aria-hidden="true"></span>
    <span class="bcn-corner br" aria-hidden="true"></span>
    <div class="bcn-dots" aria-hidden="true"></div>
    <div class="bcn-body">
    <div class="bcn-strip">
      <span class="bcn-now"><span id="bcn-dot" class="beacon-dot" aria-hidden="true"></span> now</span>
      <span class="bcn-hint"><kbd>esc</kbd> close</span>
    </div>
    <p id="bcn-status" class="bcn-status"></p>
    <p id="bcn-sub" class="bcn-sub"></p>
    <a id="bcn-book" class="bcn-book" href="mailto:sourceaura@proton.me?subject=Computer%20repair%20booking">
      <span aria-hidden="true">⌁</span> Book a repair
    </a>
    <div class="bcn-links">
      <a href="https://github.com/SourceAura" target="_blank" rel="noopener" data-tip="GitHub">gh ↗</a>
      <a href="mailto:sourceaura@proton.me" data-tip="Email">mail</a>
    </div>
    </div>
  </div>

  <script type="module">
    /* ===============================
       TIME + TEMPORAL FLARES
    =============================== */
    let flare = 0;
    let lastSecond = null;

    function updateCurrentTime() {
      const el = document.querySelector("[data-role='sysinfo-time']");
      if (!el) return;

      const d = new Date();
      const h = String(d.getHours()).padStart(2, "0");
      const m = String(d.getMinutes()).padStart(2, "0");
      const s = d.getSeconds();

      el.textContent = `${h}:${m}`;

      if (s !== lastSecond) {
        lastSecond = s;

        if (s === 0) flare = 1.2;
        else if (s === 15) flare = 0.7;
        else if (s === 30) flare = 0.9;
        else if (s === 45) flare = 0.6;
      }
    }

    updateCurrentTime();
    setInterval(updateCurrentTime, 1000);

    /* ===============================
       CANVAS SETUP
    =============================== */
    const canvas = document.getElementById("heartbeat");
    const ctx = canvas.getContext("2d");

    const W = canvas.width;
    const H = canvas.height;
    const MID = H / 2;

    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let x = 0;
    let t = 0;

    /* ===============================
       PAGEFIND COMPRESSION
    =============================== */
    let compression = 1;

    window.addEventListener("open-pagefind", () => {
      compression = 0.6;
    });
    window.addEventListener("close-pagefind", () => {
      compression = 1;
    });

    /* ===============================
       COLOR + QI PHASE
    =============================== */
    function getRGB() {
      return document.documentElement.classList.contains("dark")
        ? "255,255,255"
        : "20,20,20";
    }

    function getQiPhase() {
      const styles = getComputedStyle(document.documentElement);
      return parseFloat(styles.getPropertyValue("--pulse-phase")) || 0;
    }

    /* ===============================
       PARTICLES
    =============================== */
    const particles = Array.from({ length: 28 }, () => ({
      x: Math.random() * W,
      y: MID,
      v: 0.4 + Math.random() * 0.6,
      life: Math.random(),
      glyphLock: 0,
    }));

    function drawParticles(rgb, waveY, phase) {
      for (const p of particles) {
        p.x -= p.v;
        p.life -= 0.008;

        if (p.x < 0 || p.life <= 0) {
          p.x = W + Math.random() * 40;
          p.life = 1;
          p.glyphLock = 0;
        }

        // Qi-biased attraction
        const phaseBias = Math.sin(phase * Math.PI * 2) * 2;
        const targetY = waveY + phaseBias;
        p.y += (targetY - p.y) * 0.08;

        // Glyph constellation lock during strong flares
        if (flare > 0.9 && p.glyphLock === 0) {
          p.glyphLock = Math.random() < 0.4 ? 1 : 0;
        }

        if (p.glyphLock) {
          p.y += Math.sign(MID - p.y) * 0.6;
          p.x += Math.sin(t * 2) * 0.2;
        }

        ctx.globalAlpha = p.life * 0.7;
        ctx.fillStyle = `rgba(${rgb},0.85)`;
        ctx.fillRect(p.x, p.y, 1, 1);
      }

      ctx.globalAlpha = 1;
    }

    /* ===============================
       FRAME LOOP
    =============================== */
    function frame() {
      const rgb = getRGB();
      const phase = getQiPhase();
      
      // Sync with Ase neural network mood
      let aseWake = 0.5;
      if (typeof window !== "undefined" && window.__ase) {
        aseWake = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--ase-wake")) || 0.5;
      }
      
      const moodInfluence = aseWake * 0.4;
      const baseAmplitude = 3 + moodInfluence * 2;
      const baseFrequency = 0.04 + aseWake * 0.02;
      const baseShadow = 6 + flare * 6 + aseWake * 4;

      ctx.globalCompositeOperation = "destination-out";
      ctx.fillStyle = "rgba(0,0,0,0.08)";
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = "source-over";

      ctx.strokeStyle = `rgba(${rgb},0.9)`;
      ctx.lineWidth = 1;
      ctx.shadowColor = `rgba(${rgb},0.55)`;
      ctx.shadowBlur = baseShadow;

      ctx.beginPath();

      let lastWaveY = MID;

      for (let i = 0; i < 2; i++) {
        const nx = x / W;

        let wave =
          Math.sin(nx * Math.PI * 4 + t) * baseAmplitude +
          Math.sin(nx * Math.PI * 12 - t * 1.3) * (1.2 + moodInfluence);

        if (flare > 0) {
          wave += Math.sin(nx * Math.PI * 24 + t * 2) * flare * 2;
        }

        // Add Ase mood-based modulation
        wave *= (1 + aseWake * 0.3);

        wave *= compression;
        const y = MID + wave;
        lastWaveY = y;

        ctx.moveTo(x, y);
        ctx.lineTo(x + 1, y);

        x += 1;
        if (x >= W) x = 0;
      }

      ctx.stroke();
      ctx.shadowBlur = 0;

      drawParticles(rgb, lastWaveY, phase);

      flare *= 0.9;
      compression += (1 - compression) * 0.05;

      t += 0.04;
      requestAnimationFrame(frame);
    }

    function drawStatic() {
      ctx.clearRect(0, 0, W, H);
      ctx.beginPath();
      ctx.moveTo(0, MID);
      ctx.lineTo(W, MID);
      ctx.strokeStyle = `rgba(${getRGB()},0.6)`;
      ctx.stroke();
    }

    if (reduceMotion) drawStatic();
    else frame();

    /* ===============================
       BEACON — status dot + NOW panel
       =============================== */
    // Flip BEACON_STATUS by hand when you want to override the clock:
    // "auto" | "lab" | "bookings" | "rest"
    const BEACON_STATUS = "auto";
    // Swap for the real scheduling link when the Nashville ad goes live.
    const BOOKING_URL = "mailto:sourceaura@proton.me?subject=Computer%20repair%20booking";

    const BEACON_STATES = {
      lab:      { key: "lab",      label: "IN THE LAB",     sub: "the small hours are his hours", dot: "lab" },
      bookings: { key: "bookings", label: "TAKING BOOKINGS", sub: "computer repair — Nashville", dot: "lab" },
      rest:     { key: "rest",     label: "RECHARGING",      sub: "back in the small hours",      dot: "rest" },
    };

    function chicagoNow() {
      return new Date(new Date().toLocaleString("en-US", { timeZone: "America/Chicago" }));
    }

    function labCountdown() {
      const c = chicagoNow();
      const target = new Date(c);
      target.setHours(20, 0, 0, 0);
      let ms = target - c;
      if (ms < 0) ms = 0;
      const h = Math.floor(ms / 3600000);
      const m = Math.floor((ms % 3600000) / 60000);
      return h > 0 ? `back in the lab in ${h}h ${m}m` : `back in the lab in ${m}m`;
    }

    function beaconState() {
      if (BEACON_STATUS !== "auto") return BEACON_STATES[BEACON_STATUS] || BEACON_STATES.rest;
      // his time, his rhythm: the lab runs 20:00–06:00 America/Chicago
      const hour = Number(
        new Intl.DateTimeFormat("en-US", {
          timeZone: "America/Chicago", hour: "numeric", hour12: false,
        }).format(new Date())
      );
      return hour >= 20 || hour < 6 ? BEACON_STATES.lab : BEACON_STATES.rest;
    }

    const bBtn = document.getElementById("beacon-btn");
    const bPanel = document.getElementById("beacon-panel");
    const bDot = document.getElementById("beacon-dot");

    function renderBeacon() {
      const st = beaconState();
      if (bDot) {
        bDot.classList.toggle("lab", st.dot === "lab");
        bDot.classList.toggle("rest", st.dot === "rest");
        bDot.title = st.label.toLowerCase();
      }
      const pd = document.getElementById("bcn-dot");
      if (pd) {
        pd.classList.toggle("lab", st.dot === "lab");
        pd.classList.toggle("rest", st.dot === "rest");
      }
      const s1 = document.getElementById("bcn-status");
      const s2 = document.getElementById("bcn-sub");
      if (s1) s1.textContent = st.label;
      if (s2) s2.textContent = st.key === "rest" ? labCountdown() : st.sub;
      const bk = document.getElementById("bcn-book");
      if (bk) bk.href = BOOKING_URL;
    }

    function placeBeacon() {
      if (!bBtn || !bPanel) return;
      const r = bBtn.getBoundingClientRect();
      bPanel.style.top = Math.round(r.bottom + 10) + "px";
      bPanel.style.right = Math.max(8, Math.round(window.innerWidth - r.right)) + "px";
    }

    function openBeacon() {
      if (!bBtn || !bPanel || !bPanel.hidden) return;
      renderBeacon();
      bPanel.hidden = false;
      placeBeacon();
      bBtn.setAttribute("aria-expanded", "true");
      bPanel.focus({ preventScroll: true });
      document.addEventListener("pointerdown", outsideBeacon, { capture: true });
      window.addEventListener("resize", closeBeacon);
      window.addEventListener("scroll", closeBeacon, { capture: true });
    }

    function closeBeacon() {
      if (!bBtn || !bPanel || bPanel.hidden) return;
      bPanel.hidden = true;
      bBtn.setAttribute("aria-expanded", "false");
      document.removeEventListener("pointerdown", outsideBeacon, { capture: true });
      window.removeEventListener("resize", closeBeacon);
      window.removeEventListener("scroll", closeBeacon, { capture: true });
      bBtn.focus({ preventScroll: true });
    }

    function outsideBeacon(e) {
      if (bPanel && !bPanel.hidden && !bPanel.contains(e.target) && !bBtn.contains(e.target)) {
        closeBeacon();
      }
    }

    if (bBtn && bPanel) {
      renderBeacon();
      // refresh the dot's read + countdown, in case the page sits open
      setInterval(renderBeacon, 60 * 1000);
      bBtn.addEventListener("click", () => (bPanel.hidden ? openBeacon() : closeBeacon()));
      bPanel.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeBeacon();
      });
    }
  </script>

  <style>
    /* beacon dot — synthwave gradient when live, dim when resting */
    .beacon-dot {
      display: block;
      width: 8px;
      height: 8px;
      border-radius: 9999px;
      flex: none;
    }
    .beacon-dot.lab {
      background: linear-gradient(135deg, var(--sw1) 0%, var(--sw2) 52%, var(--sw3) 100%);
      box-shadow:
        0 0 8px color-mix(in oklch, var(--sw2) 85%, transparent),
        0 0 2px rgba(255, 255, 255, 0.9);
      animation: beacon-pulse 2.2s ease-in-out infinite;
    }
    .beacon-dot.rest {
      background: color-mix(in oklch, currentColor 35%, transparent);
      box-shadow: none;
      opacity: 0.55;
      animation: beacon-pulse 6s ease-in-out infinite;
    }
    @keyframes beacon-pulse {
      0%, 100% { transform: scale(1); opacity: 0.72; }
      50% { transform: scale(1.3); opacity: 1; }
    }

    /* NOW panel — PageFind instrument DNA: tokens, accent border+glow, dot grid, brackets */
    #beacon-panel {
      --bcn-bg: rgba(8, 10, 18, 0.55);
      --bcn-text: #e8ecf4;
      --bcn-dim: rgba(232, 236, 244, 0.6);
      position: fixed;
      z-index: 60;
      width: 252px;
      border-radius: 18px;
      border: 1px solid color-mix(in oklch, var(--pc-accent) 25%, transparent);
      background: var(--bcn-bg);
      color: var(--bcn-text);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      box-shadow:
        0 12px 44px rgba(0, 0, 0, 0.35),
        0 0 40px color-mix(in oklch, var(--pc-accent) 8%, transparent);
      outline: none;
      overflow: hidden;
      animation: beacon-breathe 5.5s ease-in-out infinite;
      transform-origin: top right;
    }
    html.light #beacon-panel {
      --bcn-bg: rgba(250, 250, 252, 0.62);
      --bcn-text: #0b0e1a;
      --bcn-dim: rgba(11, 14, 26, 0.6);
      box-shadow:
        0 12px 40px rgba(11, 14, 26, 0.14),
        0 0 40px color-mix(in oklch, var(--pc-accent) 10%, transparent);
    }
    #beacon-panel[hidden] { display: none; }
    @keyframes beacon-breathe {
      0%, 100% {
        transform: scale(1);
        box-shadow:
          0 12px 44px rgba(0, 0, 0, 0.35),
          0 0 40px color-mix(in oklch, var(--pc-accent) 8%, transparent);
      }
      50% {
        transform: scale(1.015);
        box-shadow:
          0 12px 44px rgba(0, 0, 0, 0.4),
          0 0 64px color-mix(in oklch, var(--pc-accent) 17%, transparent);
      }
    }
    .bcn-dots {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background-image: radial-gradient(
        color-mix(in oklch, var(--bcn-text) 7%, transparent) 1px,
        transparent 1.6px
      );
      background-size: 14px 14px;
      pointer-events: none;
      opacity: 0.5;
    }
    .bcn-corner {
      position: absolute;
      width: 16px;
      height: 16px;
      border: 2px solid color-mix(in oklch, var(--pc-accent) 45%, transparent);
      pointer-events: none;
      z-index: 3;
    }
    .bcn-corner.tl { top: 10px; left: 10px; border-right: none; border-bottom: none; border-top-left-radius: 5px; }
    .bcn-corner.tr { top: 10px; right: 10px; border-left: none; border-bottom: none; border-top-right-radius: 5px; }
    .bcn-corner.bl { bottom: 10px; left: 10px; border-right: none; border-top: none; border-bottom-left-radius: 5px; }
    .bcn-corner.br { bottom: 10px; right: 10px; border-left: none; border-top: none; border-bottom-right-radius: 5px; }
    .bcn-body {
      position: relative;
      z-index: 1;
      padding: 1.1rem 1.25rem 0.9rem;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    /* telemetry strip */
    .bcn-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bcn-dim);
      margin-bottom: 0.55rem;
    }
    .bcn-now {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      color: var(--pc-accent);
    }
    .bcn-hint kbd {
      font-family: inherit;
      font-size: 0.62rem;
      border: 1px solid color-mix(in oklch, var(--bcn-text) 20%, transparent);
      border-radius: 4px;
      padding: 1px 5px;
      margin: 0 1px;
      line-height: 1;
    }
    .bcn-status {
      margin: 0 0 2px;
      font-size: 0.95rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      background: linear-gradient(90deg, var(--sw1), var(--sw2) 55%, var(--sw3));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .bcn-sub {
      margin: 0;
      font-size: 0.78rem;
      color: var(--bcn-dim);
    }
    /* chamfered tag button — same cut as PageFind quick links */
    .bcn-book {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      margin: 0.85rem 0 0.7rem;
      padding: 0.55rem 0.85rem;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--bcn-text);
      border: 1px solid color-mix(in oklch, var(--pc-accent) 35%, transparent);
      background: color-mix(in oklch, var(--pc-accent) 8%, transparent);
      clip-path: polygon(
        9px 0, 100% 0,
        100% calc(100% - 9px), calc(100% - 9px) 100%,
        0 100%, 0 9px
      );
      transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
    }
    .bcn-book:hover {
      border-color: color-mix(in oklch, var(--pc-accent) 70%, transparent);
      background: color-mix(in oklch, var(--pc-accent) 16%, transparent);
      transform: translateY(-1px);
    }
    .bcn-book:focus-visible { outline: 2px solid var(--pc-accent); outline-offset: 2px; }
    .bcn-links {
      display: flex;
      gap: 14px;
      justify-content: center;
      font-size: 0.75rem;
      color: var(--bcn-dim);
    }
    .bcn-links a { color: inherit; text-decoration: none; }
    .bcn-links a:hover { color: var(--bcn-text); text-decoration: underline; }

    @media (prefers-reduced-motion: reduce) {
      .beacon-dot.lab, .beacon-dot.rest, #beacon-panel { animation: none; }
    }

    #heartbeat {
      background: transparent;
    }
  </style>
</Container>
