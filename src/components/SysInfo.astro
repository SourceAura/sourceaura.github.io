---
import Container from "@components/Container.astro";
---

<Container style="width: 260px; overflow: hidden; padding: 0 10px;">
  <button
    id="beacon-btn"
    type="button"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-controls="beacon-panel"
    aria-label="Insei — keeper of the ark — open"
    class="group relative flex w-full items-center overflow-hidden rounded-full border border-black/15 hover:bg-black/5 focus-visible:bg-black/5 dark:border-white/20 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
    style="background-color: transparent; cursor: pointer;"
  >
    <canvas
      id="heartbeat"
      width="180"
      height="18"
      class="pointer-events-none absolute inset-0 m-auto"
      style="z-index: 0;"></canvas>

    <div class="relative z-10 flex w-full items-center px-3">
      <span
        data-role="sysinfo-time"
        class="text-ghost-600 cursor-pointer text-sm"
        style="white-space: nowrap;"></span>

      <span aria-hidden="true" class="block" style="width: 80px;"></span>

      <span
        id="beacon-dot"
        class="beacon-dot ml-auto"
        title="status"></span>
    </div>
  </button>

  <!-- BEACON NOW PANEL -->
  <div id="beacon-scrim" aria-hidden="true" hidden transition:persist></div>
  <div id="beacon-panel" role="dialog" aria-label="Insei" tabindex="-1" hidden transition:persist>
    <span class="bcn-corner tl" aria-hidden="true"></span>
    <span class="bcn-corner tr" aria-hidden="true"></span>
    <span class="bcn-corner bl" aria-hidden="true"></span>
    <span class="bcn-corner br" aria-hidden="true"></span>
    <div class="bcn-dots" aria-hidden="true"></div>
    <span class="bcn-star" aria-hidden="true"></span>
    <div class="bcn-body">
    <div class="bcn-strip">
      <span class="bcn-now"><span id="bcn-dot" class="beacon-dot" aria-hidden="true"></span> insei <span id="insei-wake-word" class="bcn-wake"></span></span>
      <span class="bcn-hint"><kbd>esc</kbd> close</span>
    </div>
    <div id="insei-transcript" role="log" aria-live="polite" aria-label="Conversation with Insei"></div>
    <div id="insei-routes" aria-label="Suggested paths"></div>
    <form id="insei-form">
      <canvas id="insei-pulse" aria-hidden="true"></canvas>
      <input id="insei-input" type="text" autocomplete="off" maxlength="200" placeholder="ask of the ark&hellip;" aria-label="Ask Insei" />
      <button id="insei-send" type="submit" aria-label="Send">&rarr;</button>
    </form>
    </div>
  </div>

  <script type="module">
    /* ===============================
       TIME + TEMPORAL FLARES
    =============================== */
    let flare = 0;
    let lastSecond = null;

    function updateCurrentTime() {
      const el = document.querySelector("[data-role='sysinfo-time']");
      if (!el) return;

      const d = new Date();
      const h = String(d.getHours()).padStart(2, "0");
      const m = String(d.getMinutes()).padStart(2, "0");
      const s = d.getSeconds();

      el.textContent = `${h}:${m}`;

      if (s !== lastSecond) {
        lastSecond = s;

        if (s === 0) flare = 1.2;
        else if (s === 15) flare = 0.7;
        else if (s === 30) flare = 0.9;
        else if (s === 45) flare = 0.6;
      }
    }

    updateCurrentTime();
    setInterval(updateCurrentTime, 1000);

    /* ===============================
       CANVAS SETUP
    =============================== */
    const canvas = document.getElementById("heartbeat");
    const ctx = canvas.getContext("2d");

    const W = canvas.width;
    const H = canvas.height;
    const MID = H / 2;

    // panel sparkline — the pill's heartbeat unfolded
    const spark = document.getElementById("insei-pulse");
    const sctx = spark ? spark.getContext("2d") : null;
    let SW = 0, SH = 0, SMID = 0;
    let sx = 0;
    let sparkAccent = null; // rgb triplet from --petal-accent, read on open
    function sparkStroke() {
      return sparkAccent || getRGB();
    }

    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let x = 0;
    let t = 0;
    let bcnOpen = false; // NOW panel expanded — sparkline runs only then

    /* ===============================
       PAGEFIND COMPRESSION
    =============================== */
    let compression = 1;

    window.addEventListener("open-pagefind", () => {
      compression = 0.6;
    });
    window.addEventListener("close-pagefind", () => {
      compression = 1;
    });

    /* ===============================
       COLOR + QI PHASE
    =============================== */
    function getRGB() {
      return document.documentElement.classList.contains("dark")
        ? "255,255,255"
        : "20,20,20";
    }

    // Live CSS vars, cached: getComputedStyle forces a style recalc, so
    // per-frame reads are replaced with a 1s TTL cache.
    const __live = { t: 0, phase: 0, wake: 0.5 };
    function readLiveStyles() {
      const now = performance.now();
      if (now - __live.t < 1000) return __live;
      const styles = getComputedStyle(document.documentElement);
      __live.t = now;
      __live.phase = parseFloat(styles.getPropertyValue("--pulse-phase")) || 0;
      __live.wake = parseFloat(styles.getPropertyValue("--insei-wake")) || 0.5;
      return __live;
    }
    function getQiPhase() {
      return readLiveStyles().phase;
    }

    /* ===============================
       PARTICLES
    =============================== */
    const particles = Array.from({ length: 28 }, () => ({
      x: Math.random() * W,
      y: MID,
      v: 0.4 + Math.random() * 0.6,
      life: Math.random(),
      glyphLock: 0,
    }));

    function drawParticles(rgb, waveY, phase) {
      for (const p of particles) {
        p.x -= p.v;
        p.life -= 0.008;

        if (p.x < 0 || p.life <= 0) {
          p.x = W + Math.random() * 40;
          p.life = 1;
          p.glyphLock = 0;
        }

        // Qi-biased attraction
        const phaseBias = Math.sin(phase * Math.PI * 2) * 2;
        const targetY = waveY + phaseBias;
        p.y += (targetY - p.y) * 0.08;

        // Glyph constellation lock during strong flares
        if (flare > 0.9 && p.glyphLock === 0) {
          p.glyphLock = Math.random() < 0.4 ? 1 : 0;
        }

        if (p.glyphLock) {
          p.y += Math.sign(MID - p.y) * 0.6;
          p.x += Math.sin(t * 2) * 0.2;
        }

        ctx.globalAlpha = p.life * 0.7;
        ctx.fillStyle = `rgba(${rgb},0.85)`;
        ctx.fillRect(p.x, p.y, 1, 1);
      }

      ctx.globalAlpha = 1;
    }

    /* ===============================
       FRAME LOOP
    =============================== */
    function frame() {
      const rgb = getRGB();
      const phase = getQiPhase();
      
      // Sync with Insei's sensed mood (local-only, no network)
      let aseWake = 0.5;
      if (typeof window !== "undefined" && window.__insei) {
        aseWake = readLiveStyles().wake;
      }
      
      const moodInfluence = aseWake * 0.4;
      const baseAmplitude = 3 + moodInfluence * 2;
      const baseFrequency = 0.04 + aseWake * 0.02;
      const baseShadow = 6 + flare * 6 + aseWake * 4;

      ctx.globalCompositeOperation = "destination-out";
      ctx.fillStyle = "rgba(0,0,0,0.08)";
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = "source-over";

      ctx.strokeStyle = `rgba(${rgb},0.9)`;
      ctx.lineWidth = 1;
      ctx.shadowColor = `rgba(${rgb},0.55)`;
      ctx.shadowBlur = baseShadow;

      ctx.beginPath();

      let lastWaveY = MID;

      for (let i = 0; i < 2; i++) {
        const nx = x / W;

        let wave =
          Math.sin(nx * Math.PI * 4 + t) * baseAmplitude +
          Math.sin(nx * Math.PI * 12 - t * 1.3) * (1.2 + moodInfluence);

        if (flare > 0) {
          wave += Math.sin(nx * Math.PI * 24 + t * 2) * flare * 2;
        }

        // Add Ase mood-based modulation
        wave *= (1 + aseWake * 0.3);

        wave *= compression;
        const y = MID + wave;
        lastWaveY = y;

        ctx.moveTo(x, y);
        ctx.lineTo(x + 1, y);

        x += 1;
        if (x >= W) x = 0;
      }

      ctx.stroke();
      ctx.shadowBlur = 0;

      // the unfolded heartbeat — same wave, wider canvas, only while open
      if (sctx && bcnOpen) {
        sctx.globalCompositeOperation = "destination-out";
        sctx.fillStyle = "rgba(0,0,0,0.08)";
        sctx.fillRect(0, 0, SW, SH);
        sctx.globalCompositeOperation = "source-over";

        const srgb = sparkStroke();
        sctx.strokeStyle = `rgba(${srgb},0.85)`;
        sctx.lineWidth = 1.2;
        sctx.shadowColor = `rgba(${srgb},0.5)`;
        sctx.shadowBlur = 5 + flare * 5;

        sctx.beginPath();
        for (let i = 0; i < 3; i++) {
          const nx = sx / SW;
          let wave =
            Math.sin(nx * Math.PI * 4 + t) * baseAmplitude +
            Math.sin(nx * Math.PI * 12 - t * 1.3) * (1.2 + moodInfluence);
          if (flare > 0) {
            wave += Math.sin(nx * Math.PI * 24 + t * 2) * flare * 2;
          }
          wave *= compression;
          const sy = SMID + wave;
          sctx.moveTo(sx, sy);
          sctx.lineTo(sx + 1, sy);
          sx += 1;
          if (sx >= SW) sx = 0;
        }
        sctx.stroke();
        sctx.shadowBlur = 0;
      }

      drawParticles(rgb, lastWaveY, phase);

      flare *= 0.9;
      compression += (1 - compression) * 0.05;

      t += 0.04;
      requestAnimationFrame(frame);
    }

    function drawStatic() {
      ctx.clearRect(0, 0, W, H);
      ctx.beginPath();
      ctx.moveTo(0, MID);
      ctx.lineTo(W, MID);
      ctx.strokeStyle = `rgba(${getRGB()},0.6)`;
      ctx.stroke();
    }

    function drawSparkStatic() {
      if (!sctx) return;
      sctx.clearRect(0, 0, SW, SH);
      sctx.beginPath();
      sctx.moveTo(0, SMID);
      sctx.lineTo(SW, SMID);
      sctx.strokeStyle = `rgba(${sparkStroke()},0.6)`;
      sctx.stroke();
    }

    if (reduceMotion) { drawStatic(); drawSparkStatic(); }
    else frame();

    /* ===============================
       BEACON — status dot + NOW panel
       =============================== */
    // Flip BEACON_STATUS by hand when you want to override the clock:
    // "auto" | "lab" | "bookings" | "rest"
    const BEACON_STATUS = "auto";
    // Swap for the real scheduling link when the Nashville ad goes live.
    const BOOKING_URL = "mailto:sourceaura@proton.me?subject=Computer%20repair%20booking";

    const BEACON_STATES = {
      lab:      { key: "lab",      label: "IN THE LAB",     sub: "the small hours are his hours", dot: "lab" },
      bookings: { key: "bookings", label: "TAKING BOOKINGS", sub: "computer repair — Nashville", dot: "lab" },
      rest:     { key: "rest",     label: "RECHARGING",      sub: "back in the small hours",      dot: "rest" },
    };

    function chicagoNow() {
      return new Date(new Date().toLocaleString("en-US", { timeZone: "America/Chicago" }));
    }

    function labCountdown() {
      const c = chicagoNow();
      const target = new Date(c);
      target.setHours(20, 0, 0, 0);
      let ms = target - c;
      if (ms < 0) ms = 0;
      const h = Math.floor(ms / 3600000);
      const m = Math.floor((ms % 3600000) / 60000);
      return h > 0 ? `back in the lab in ${h}h ${m}m` : `back in the lab in ${m}m`;
    }

    function beaconState() {
      if (BEACON_STATUS !== "auto") return BEACON_STATES[BEACON_STATUS] || BEACON_STATES.rest;
      // his time, his rhythm: the lab runs 20:00–06:00 America/Chicago
      const hour = Number(
        new Intl.DateTimeFormat("en-US", {
          timeZone: "America/Chicago", hour: "numeric", hour12: false,
        }).format(new Date())
      );
      return hour >= 20 || hour < 6 ? BEACON_STATES.lab : BEACON_STATES.rest;
    }

    const bBtn = document.getElementById("beacon-btn");
    const bPanel = document.getElementById("beacon-panel");
    const bScrim = document.getElementById("beacon-scrim");
    const bDot = document.getElementById("beacon-dot");

    // The header carries a transform (PageFind lift), which would hijack
    // position:fixed on descendants — the panel would center on the header
    // bar and the scrim would shrink to a strip. They live on <body> instead.
    if (bScrim && bScrim.parentElement !== document.body)
      document.body.appendChild(bScrim);
    if (bPanel && bPanel.parentElement !== document.body)
      document.body.appendChild(bPanel);

    function renderBeacon() {
      const st = beaconState();
      if (bDot) {
        bDot.classList.toggle("lab", st.dot === "lab");
        bDot.classList.toggle("rest", st.dot === "rest");
        bDot.title = st.label.toLowerCase();
      }
      const pd = document.getElementById("bcn-dot");
      if (pd) {
        pd.classList.toggle("lab", st.dot === "lab");
        pd.classList.toggle("rest", st.dot === "rest");
      }
      updateWakeWord();
    }

    /* ===============================
       INSEI — the keeper window
       =============================== */
    const inseiApi = () => window.__insei;
    let inseiGreeted = false;
    let inseiIdleNudged = false;
    let inseiWakeTimer = 0;

    function inseiStatusLine() {
      const st = beaconState();
      if (st.key === "lab") return "Sensei is in the lab — the small hours are sensei's hours.";
      if (st.key === "bookings") return "Sensei is taking commissions — the mending of machines, Nashville.";
      return "Sensei rests — the lab rekindles in " + labCountdown().replace("back in the lab in ", "") + ".";
    }

    function updateWakeWord() {
      const el = document.getElementById("insei-wake-word");
      if (!el) return;
      const w = readLiveStyles().wake;
      el.textContent = w < 0.35 ? "listening" : w > 0.7 ? "dreaming" : "awake";
    }

    function escHtml(str) {
      return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function inseiAddMsg(kind, html, whisper) {
      const t = document.getElementById("insei-transcript");
      if (!t) return;
      while (t.children.length >= 40) t.removeChild(t.firstChild);
      const d = document.createElement("div");
      d.className = kind === "you" ? "insei-you" : "insei-her";
      if (whisper) d.setAttribute("data-whisper", "1");
      d.innerHTML = html;
      const nearBottom = t.scrollHeight - t.scrollTop - t.clientHeight < 60;
      t.appendChild(d);
      if (nearBottom) t.scrollTop = t.scrollHeight;
    }

    function inseiRenderRoutes(routes) {
      const r = document.getElementById("insei-routes");
      if (!r) return;
      r.textContent = "";
      const api = inseiApi();
      (routes || []).forEach(function (id) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "insei-route";
        b.textContent = api && api.routeLabel ? api.routeLabel(id) : id;
        b.addEventListener("click", function () { inseiSend(id, true); });
        r.appendChild(b);
      });
    }

    function inseiRenderAnswer(ans) {
      let html = "<p>" + escHtml(ans.text) + "</p>";
      if (ans.facts && ans.facts.length) {
        html += '<ul class="insei-facts">' + ans.facts.map(function (f) {
          let li = escHtml(f.text);
          if (f.link) {
            li += ' <a href="' + f.link + '"' +
              (f.link.indexOf("http") === 0 ? ' target="_blank" rel="noopener"' : "") +
              ">" + escHtml(f.linkLabel || "open") + "</a>";
          }
          return "<li>" + li + "</li>";
        }).join("") + "</ul>";
      }
      inseiAddMsg("her", html, false);
      inseiRenderRoutes(ans.routes || []);
    }

    function inseiGreet() {
      const api = inseiApi();
      const line = inseiIdleNudged
        ? "Still here? Ask me anything."
        : (api && api.greeting ? api.greeting() : "I am Insei — keeper of this ark.");
      inseiIdleNudged = false;
      inseiAddMsg("her", "<p>" + escHtml(line) + "</p>", false);
      inseiRenderRoutes(["sanctums", "steel", "service", "booking"]);
    }

    function inseiSend(text, isRoute) {
      const api = inseiApi();
      if (!api) return;
      const shown = isRoute && api.routeLabel ? api.routeLabel(text) : text;
      inseiAddMsg("you", "<p>" + escHtml(shown) + "</p>", false);
      // she takes a breath before answering — alive, not instant
      const t = document.getElementById("insei-transcript");
      let bubble = null;
      if (t) {
        bubble = document.createElement("div");
        bubble.className = "insei-her";
        bubble.setAttribute("aria-hidden", "true");
        bubble.innerHTML = '<span class="insei-thinking"><i></i><i></i><i></i></span>';
        t.appendChild(bubble);
        t.scrollTop = t.scrollHeight;
      }
      const delay = 1100 + Math.random() * 900;
      window.setTimeout(function () {
        if (bubble && bubble.parentNode) bubble.parentNode.removeChild(bubble);
        let ans = null;
        try {
          ans = isRoute ? api.whisper(text) : api.ask(text, { statusLine: inseiStatusLine });
        } catch (e) { ans = null; }
        if (!ans) {
          ans = { text: "That is beyond what sensei has entrusted to me.", facts: [], routes: ["sanctums", "steel", "service"] };
        }
        inseiRenderAnswer(ans);
      }, delay);
    }

    function inseiBindForm() {
      const form = document.getElementById("insei-form");
      if (!form || form.dataset.bound === "1") return;
      form.dataset.bound = "1";
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        const inp = document.getElementById("insei-input");
        if (!inp) return;
        const v = inp.value.trim();
        if (!v) return;
        inp.value = "";
        inseiSend(v, false);
      });
    }

    if (!window.__inseiWhisper) {
      window.__inseiWhisper = true;
      window.addEventListener("insei:whisper", function (e) {
        const d = (e && e.detail) || {};
        if (d.trigger === "idle-quiet") {
          inseiIdleNudged = true;
          const dot = document.getElementById("bcn-dot");
          if (dot) dot.setAttribute("data-nudge", "1");
          return;
        }
        const panel = document.getElementById("beacon-panel");
        if (panel && !panel.hidden && d.entryId) {
          const api = inseiApi();
          const ans = api && api.whisper ? api.whisper(d.entryId) : null;
          if (ans) {
            inseiAddMsg("her", "<p>" + escHtml(ans.text) + "</p>", true);
            inseiRenderRoutes(ans.routes || []);
          }
        }
      });
    }

    function openBeacon() {
      if (!bBtn || !bPanel || !bPanel.hidden) return;
      renderBeacon();
      bPanel.hidden = false;
      bcnOpen = true;
      inseiBindForm();
      // her pulse: size the presence canvas, wear the petal accent
      const pulse = document.getElementById("insei-pulse");
      if (pulse && spark && sctx) {
        const r = pulse.getBoundingClientRect();
        SW = Math.max(1, Math.round(r.width));
        SH = Math.max(1, Math.round(r.height || 26));
        SMID = SH / 2;
        spark.width = SW;
        spark.height = SH;
        if (sx >= SW) sx = 0;
        const av = getComputedStyle(document.documentElement)
          .getPropertyValue("--petal-accent").trim();
        const m = av.match(/(\d+)\D+(\d+)\D+(\d+)/);
        sparkAccent = m ? `${m[1]},${m[2]},${m[3]}` : null;
      }
      if (bScrim) {
        bScrim.hidden = false;
        requestAnimationFrame(() => requestAnimationFrame(() => bScrim.classList.add("visible")));
      }
      bBtn.setAttribute("aria-expanded", "true");
      if (!inseiGreeted) {
        inseiGreeted = true;
        const t = document.getElementById("insei-transcript");
        if (t) {
          const bubble = document.createElement("div");
          bubble.className = "insei-her";
          bubble.setAttribute("aria-hidden", "true");
          bubble.innerHTML = '<span class="insei-thinking"><i></i><i></i><i></i></span>';
          t.appendChild(bubble);
          window.setTimeout(function () {
            if (bubble.parentNode) bubble.parentNode.removeChild(bubble);
            inseiGreet();
          }, 800);
        } else {
          inseiGreet();
        }
      } else {
        updateWakeWord();
      }
      const inp = document.getElementById("insei-input");
      if (inp) inp.focus({ preventScroll: true });
      if (inseiWakeTimer) window.clearInterval(inseiWakeTimer);
      inseiWakeTimer = window.setInterval(updateWakeWord, 2000);
      document.addEventListener("pointerdown", outsideBeacon, { capture: true });
    }

    function closeBeacon() {
      if (!bBtn || !bPanel || bPanel.hidden) return;
      bPanel.hidden = true;
      bcnOpen = false;
      if (inseiWakeTimer) {
        window.clearInterval(inseiWakeTimer);
        inseiWakeTimer = 0;
      }
      if (bScrim && !bScrim.hidden) {
        bScrim.classList.remove("visible");
        window.setTimeout(() => { if (bPanel.hidden) bScrim.hidden = true; }, 250);
      }
      bBtn.setAttribute("aria-expanded", "false");
      document.removeEventListener("pointerdown", outsideBeacon, { capture: true });
      bBtn.focus({ preventScroll: true });
    }

    function outsideBeacon(e) {
      if (bPanel && !bPanel.hidden && !bPanel.contains(e.target) && !bBtn.contains(e.target)) {
        closeBeacon();
      }
    }

    if (bScrim) bScrim.addEventListener("click", () => closeBeacon());

    if (!window.__beaconKeys) {
      window.__beaconKeys = true;
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const p = document.getElementById("beacon-panel");
          if (p && !p.hidden) {
            const btn = document.getElementById("beacon-btn");
            p.hidden = true;
            bcnOpen = false;
            btn?.setAttribute("aria-expanded", "false");
            const sc = document.getElementById("beacon-scrim");
            if (sc && !sc.hidden) {
              sc.classList.remove("visible");
              window.setTimeout(() => { if (p.hidden) sc.hidden = true; }, 250);
            }
            btn?.focus({ preventScroll: true });
          }
        }
      });
    }

    if (bBtn && bPanel) {
      renderBeacon();
      // refresh the dot's read + countdown, in case the page sits open
      setInterval(renderBeacon, 60 * 1000);
      bBtn.addEventListener("click", () => (bPanel.hidden ? openBeacon() : closeBeacon()));
      bPanel.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeBeacon();
      });
    }
  </script>

  <style>
    /* beacon dot — synthwave gradient when live, dim when resting */
    .beacon-dot {
      display: block;
      width: 8px;
      height: 8px;
      border-radius: 9999px;
      flex: none;
    }
    .beacon-dot.lab {
      background: linear-gradient(135deg, var(--sw1) 0%, var(--sw2) 52%, var(--sw3) 100%);
      box-shadow:
        0 0 8px color-mix(in oklch, var(--sw2) 85%, transparent),
        0 0 2px rgba(255, 255, 255, 0.9);
      animation: beacon-pulse 2.2s ease-in-out infinite;
    }
    .beacon-dot.rest {
      background: color-mix(in oklch, currentColor 35%, transparent);
      box-shadow: none;
      opacity: 0.55;
      animation: beacon-pulse 6s ease-in-out infinite;
    }
    @keyframes beacon-pulse {
      0%, 100% { transform: scale(1); opacity: 0.72; }
      50% { transform: scale(1.3); opacity: 1; }
    }

    /* scrim — PageFind's exact recipe */
    #beacon-scrim {
      position: fixed;
      inset: 0;
      z-index: 55;
      background: transparent;
      transition: background 240ms ease;
    }
    #beacon-scrim.visible {
