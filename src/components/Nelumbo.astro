---
/* Nelumbo
Rose Lotus - Rotating LED Display.
Nelumbo displays a 3D carousel of petals + a HUD.

Updates:
- Carousel hidden by default, toggled by Qi.astro click
- HUD opens ONLY on long press
- Orbs ~20% smaller
- Petals never distort/stretch (counter-rotate surface to face camera)
- HUD docked under PageFind input (#hud-dock)
- NEW: Side “card scanner” lines pulse when an orb crosses the fade boundary (scan out/in)
*/
import Qi from "@components/Qi.astro";
import Orb from "@components/Orb.astro";
import Giscus from "@components/Giscus.astro";
const { posts } = Astro.props;
import "@styles/nelumbo.css";

import {
  extractFirstImageFromMarkdown,
  stripMarkdownToText,
  readingTimeMinutes,
  formatDate,
} from "@lib/post";
---

<div class="carousel-layer" id="petal-shell" hidden aria-hidden="true">
  <div class="carousel-viewport">
    <div class="carousel-ring" id="petal-ring">
      {
        posts.map((post, i) => {
          const img = extractFirstImageFromMarkdown(post.body) ?? "";
          const articleText = stripMarkdownToText(post.body);
          const dateLabel = formatDate(post.data.date);
          const rt = readingTimeMinutes(post.body);

          return (
            <div
              class="carousel-item"
              tabindex="0"
              data-index={i}
              data-href={`/petals/${post.slug}`}
              data-title={post.data.title}
              data-desc={post.data.description}
              data-img={img}
              data-article={articleText}
              data-date={dateLabel}
              data-rt={rt}
            >
              <div class="parallax-layer">
                <div class="petal-surface" data-petal-surface>
                  <Orb post={post} crystal />
                  <div class="petal-content">
                    <h1>{post.data.title}</h1>
                    <p>{post.data.description}</p>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <!-- Side scanner rails (BACK = outer beams behind orb) -->
  <div class="petal-scanners petal-scanners-back" aria-hidden="true">
    <div class="petal-scan-wrap petal-scan-left petal-scan-outer">
      <div class="petal-scan" data-scan-side="left" data-scan-depth="back">
        <!-- exactly ONE beam element per side layer -->
        <span class="petal-beam"></span>
      </div>
    </div>

    <div class="petal-scan-wrap petal-scan-right petal-scan-outer">
      <div class="petal-scan" data-scan-side="right" data-scan-depth="back">
        <span class="petal-beam"></span>
      </div>
    </div>
  </div>

  <!-- Side scanner rails (FRONT = inner beams in front of orb) -->
  <div class="petal-scanners petal-scanners-front" aria-hidden="true">
    <div class="petal-scan-wrap petal-scan-left petal-scan-inner">
      <div
        class="petal-scan"
        id="petal-scan-left"
        data-scan-side="left"
        data-scan-depth="front"
      >
        <span class="petal-beam"></span>
      </div>
    </div>

    <div class="petal-scan-wrap petal-scan-right petal-scan-inner">
      <div
        class="petal-scan"
        id="petal-scan-right"
        data-scan-side="right"
        data-scan-depth="front"
      >
        <span class="petal-beam"></span>
      </div>
    </div>
  </div>

  <!-- HUD Overlay (DOCKED under PageFind input) -->
  <div class="hud" id="petal-hud" aria-hidden="true">
    <div class="hud-progress" aria-hidden="true"></div>
    <div class="hud-frame">
      <!-- chrome layer: clipped glass, vignette, dot grid, spotlight, star border -->
      <div class="hud-chrome" aria-hidden="true">
        <div class="hud-spot"></div>
        <div class="hud-dots"></div>
        <div class="hud-vignette"></div>
        <div class="hud-star"></div>

        <!-- HUD corner brackets -->
        <span class="hud-bracket hb-tl" aria-hidden="true"></span>
        <span class="hud-bracket hb-tr" aria-hidden="true"></span>
        <span class="hud-bracket hb-bl" aria-hidden="true"></span>
        <span class="hud-bracket hb-br" aria-hidden="true"></span>

        <!-- giant ghost typography looming behind the content -->
        <div class="hud-ghost" aria-hidden="true"></div>
      </div>

      <!-- content floats above the chrome -->
      <div class="hud-tilt">
        <button
          class="hud-close"
          type="button"
          id="hud-close"
          aria-label="Close HUD"
        >
          <span class="hud-close-k">ESC</span>
          <span class="hud-close-x" aria-hidden="true">×</span>
        </button>

        <div class="hud-seg hud-mediaStats">
          <div class="hud-media-wrap glare">
            <img data-hud-img alt="" />
            <div class="hud-scan" aria-hidden="true"></div>
            <div class="hud-laser" aria-hidden="true"></div>
            <div class="hud-glare" aria-hidden="true"></div>
            <div class="hud-titleOverlay" aria-hidden="true">
              <div class="hud-titleText" data-hud-title></div>
            </div>
          </div>

          <!-- telemetry strip: DATE · READ, directly beneath the hero -->
          <div class="hud-telemetry" aria-label="Post stats">
            <span class="hud-chip">
              <span class="hud-chip-k">DATE</span>
              <span class="hud-chip-v" data-hud-date></span>
            </span>
            <span class="hud-chip-sep" aria-hidden="true">·</span>
            <span class="hud-chip">
              <span class="hud-chip-k">READ</span>
              <span class="hud-chip-v" data-hud-rt></span>
            </span>
          </div>
        </div>

        <div class="hud-seg hud-article">
          <div class="hud-sub">ARTICLE</div>
          <p class="hud-quote" data-hud-desc></p>
          <div class="hud-article-body" data-hud-article></div>
          <a
            class="hud-pill"
            data-hud-link
            data-spark
            href="#"
            aria-label="Open post"
            title="Access Entry"
          >
            READ ENTRY <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="hud-controls" aria-label="Post controls">
          <a
            class="hud-ctl hud-reactions"
            data-hud-reactions
            data-spark
            href="#"
            aria-label="Reactions"
            title="Reactions"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1.1em"
              height="1.1em"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"
              ></path>
            </svg>
            <span class="count" data-hud-reactions-count></span>
          </a>
          <a
            class="hud-ctl hud-comments"
            data-hud-comments
            data-spark
            href="#"
            aria-label="Comments"
            title="Comments"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1.1em"
              height="1.1em"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15a4 4 0 0 1-4 4H7l-4 4V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
            </svg>
            <span class="count" data-hud-comments-count></span>
          </a>
        </div>
      </div>

      <div class="hud-glow" aria-hidden="true"></div>
      <div class="hud-specks" aria-hidden="true"></div>
      <div class="hud-signalNoise" aria-hidden="true"></div>
    </div>
  </div>

<!-- Collapsible Giscus Comments Section (completely separate from HUD) -->
<div class="hud-comments-section is-collapsed" id="hud-comments-section">
  <div class="hud-frame">
    <!-- chrome layer: clipped glass, vignette, dot grid, spotlight, star border -->
    <div class="hud-chrome" aria-hidden="true">
      <div class="hud-spot"></div>
      <div class="hud-dots"></div>
      <div class="hud-vignette"></div>
      <div class="hud-star"></div>

      <!-- HUD corner brackets -->
      <span class="hud-bracket hb-tl" aria-hidden="true"></span>
      <span class="hud-bracket hb-tr" aria-hidden="true"></span>
      <span class="hud-bracket hb-bl" aria-hidden="true"></span>
      <span class="hud-bracket hb-br" aria-hidden="true"></span>

      <!-- giant ghost typography looming behind the content -->
      <div class="hud-ghost" aria-hidden="true">ECHOES</div>
    </div>

    <div class="hud-seg hud-mediaStats">
      <div class="hud-media-wrap">
      </div>
    </div>

    <div class="hud-seg hud-article">
      <div id="hud-giscus-wrapper" class="giscus">
        <!-- Dynamic Giscus instance will be mounted here -->
      </div>
    </div>

    <button
      class="hud-close"
      type="button"
      id="hud-comments-close"
      aria-label="Close Comments"
    >
      <span class="hud-close-k">ESC</span>
      <span class="hud-close-x" aria-hidden="true">×</span>
    </button>

    <div class="hud-glow" aria-hidden="true"></div>
    <div class="hud-specks" aria-hidden="true"></div>
    <div class="hud-signalNoise" aria-hidden="true"></div>
  </div>
</div>

<script is:inline>
  const shell = document.getElementById("petal-shell");
  const ring = document.getElementById("petal-ring");
  const items = ring ? [...ring.querySelectorAll(".carousel-item")] : [];

  // Front beams keep ids (used for particles + default pulse target)
  const scanL = document.getElementById("petal-scan-left");
  const scanR = document.getElementById("petal-scan-right");

  // Back beams (outer, behind orbs)
  const scanBackLeft = document.querySelector(
    '.petal-scanners-back [data-scan-side="left"]',
  );
  const scanBackRight = document.querySelector(
    '.petal-scanners-back [data-scan-side="right"]',
  );

  const hud = document.getElementById("petal-hud");
  const hudClose = document.getElementById("hud-close");

  const hudTitle = hud?.querySelector("[data-hud-title]");
  const hudImg = hud?.querySelector("[data-hud-img]");
  const hudDesc = hud?.querySelector("[data-hud-desc]");
  const hudArticle = hud?.querySelector("[data-hud-article]");
  const hudDate = hud?.querySelector("[data-hud-date]");
  const hudRT = hud?.querySelector("[data-hud-rt]");
  const hudLink = hud?.querySelector("[data-hud-link]");
  const hudReactions = hud?.querySelector("[data-hud-reactions]");
  const hudComments = hud?.querySelector("[data-hud-comments]");
  const hudReactionsCount = hud?.querySelector("[data-hud-reactions-count]");
  const hudCommentsCount = hud?.querySelector("[data-hud-comments-count]");
  const hudCommentsSection = document.getElementById("hud-comments-section");
  function hudCommentsClose() {
    return document.getElementById("hud-comments-close");
  }
  const hudCommentsFrame = hudCommentsSection?.querySelector(".hud-frame");
  const hudGiscusWrapper = document.getElementById("hud-giscus-wrapper");

  let activeGiscusTerm = "/";
  let hudGiscusBooted = false;

  function ensureHudGiscus(term) {
    if (!hudGiscusWrapper) return;
    if (hudGiscusBooted) return;

    hudGiscusWrapper.innerHTML = "<div class=\"giscus\"></div>";

    const s = document.createElement("script");
    s.src = "https://giscus.app/client.js";
    s.async = true;
    s.crossOrigin = "anonymous";

    s.setAttribute("data-repo", "sourceaura/sourceaura.github.io");
    s.setAttribute("data-repo-id", "MDEwOlJlcG9zaXRvcnkyMDg2Nzg2NjY=");
    s.setAttribute("data-category", "Show and tell");
    s.setAttribute("data-category-id", "DIC_kwDODHAvCs4Cgi0j");
    s.setAttribute("data-mapping", "specific");
    s.setAttribute("data-term", term);
    s.setAttribute("data-reactions-enabled", "1");
    s.setAttribute("data-emit-metadata", "1");
    s.setAttribute("data-input-position", "bottom");
    s.setAttribute("data-theme", hudGiscusThemeUrl());
    s.setAttribute("data-lang", "en");

    hudGiscusWrapper.appendChild(s);
    hudGiscusBooted = true;
  }

  function hudGiscusThemeUrl() {
    return document.documentElement.classList.contains("light")
      ? "/giscus/nelumbo-hud-light.css"
      : "/giscus/nelumbo-hud.css";
  }

  // Keep the comments iframe on the page's theme: the cards are daylight
  // glass in light mode, dark glass in dark mode — the thread must match.
  new MutationObserver(() => {
    if (!hudGiscusBooted) return;
    const frame = hudGiscusWrapper?.querySelector("iframe.giscus-frame");
    if (!frame || !frame.contentWindow) return;
    frame.contentWindow.postMessage(
      { giscus: { setConfig: { theme: hudGiscusThemeUrl() } } },
      "https://giscus.app",
    );
  }).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });

  function setHudGiscusTerm(term) {
    activeGiscusTerm = term;
    ensureHudGiscus(term);
    if (!hudGiscusWrapper) return;

    const frame = hudGiscusWrapper.querySelector("iframe.giscus-frame");
    if (!frame || !frame.contentWindow) return;

    frame.contentWindow.postMessage(
      { giscus: { setConfig: { term } } },
      "https://giscus.app",
    );
  }

  function formatCount(n) {
    return n > 99 ? "99+" : String(n);
  }

  function animateCount(el) {
    el.animate(
      [
        { transform: "scale(0.85)", opacity: 0 },
        { transform: "scale(1.15)", opacity: 1, offset: 0.55 },
        { transform: "scale(1)", opacity: 1 },
      ],
      { duration: 420, easing: "cubic-bezier(0.2, 0.9, 0.2, 1)" },
    );
  }

  function setHudCountsLoading() {
    if (hudReactionsCount) hudReactionsCount.textContent = "";
    if (hudCommentsCount) hudCommentsCount.textContent = "";
    hudReactions?.removeAttribute("data-has-reactions");
  }

  function setGiscusTerm(term) {
    if (term === activeGiscusTerm) return;
    activeGiscusTerm = term;

    mountGiscusProbe(term);
  }

  window.addEventListener("message", (event) => {
    if (event.origin !== "https://giscus.app") return;

    const g = event.data?.giscus;
    if (!g || !g.discussion) return;

    if (hudCommentsCount) {
      hudCommentsCount.textContent = formatCount(
        g.discussion.totalCommentCount ?? 0,
      );
      animateCount(hudCommentsCount);
    }

    if (hudReactionsCount && g.discussion?.id) {
      fetch(`/api/reactions?id=${g.discussion.id}`)
        .then((r) => r.json())
        .then((d) => {
          if (typeof d.total !== "number") return;
          hudReactions?.setAttribute("data-has-reactions", "true");
          animateCount(hudReactionsCount);

          // Count the number up, but not the "99+" cap — that is a label,
          // not a value.
          if (d.total > 99) hudReactionsCount.textContent = "99+";
          else window.__countUp?.(hudReactionsCount, d.total, 600);
        })
        .catch(() => {});
    }
  });

  const ARTIFACT_KEYWORDS = [
    "Materia",
    "Qi",
    "Rose",
    "Lotus",
    "Nelumbo",
    "Euthymia",
    "Ase",
    "SourceAura",
    "Tiphereth",
    "Binah",
  ];

  const count = items.length;
  const step = count ? 360 / count : 360;

  const getHudDock = () =>
    document.getElementById("hud-dock") ||
    document.querySelector("[data-hud-dock]");

  let petalsOpen = false;

  function updatePetalVisibility() {
    if (!shell) return;
    shell.hidden = !petalsOpen;
    shell.toggleAttribute("data-petals-open", petalsOpen);
    shell.setAttribute("aria-hidden", petalsOpen ? "false" : "true");
    if (!petalsOpen) focusedIndex = -1;
  }

  // The ring pitches only while a card is displayed, as if making room for it.
  // Driving the variable (not the transform) keeps the ring and the per-orb
  // billboard compensation in sync, since both read --orbit-tilt.
  function rgbToHsl(r, g, b) {
    r /= 255;
    g /= 255;
    b /= 255;
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    const l = (max + min) / 2;
    const d = max - min;
    let h = 0;
    let s = 0;
    if (d !== 0) {
      s = d / (1 - Math.abs(2 * l - 1));
      if (max === r) h = ((g - b) / d) % 6;
      else if (max === g) h = (b - r) / d + 2;
      else h = (r - g) / d + 4;
      h *= 60;
      if (h < 0) h += 360;
    }
    return { h, s: s * 100, l: l * 100 };
  }

  // Sample the dominant hue of the hero image, ignoring near-black /
  // near-white / grey pixels. Returns { accent, accent2 } or null.
  function sampleImageColor(img) {
    try {
      const size = 32;
      const canvas = document.createElement("canvas");
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext("2d");
      ctx.drawImage(img, 0, 0, size, size);
      const data = ctx.getImageData(0, 0, size, size).data;
      const hues = [];
      let satSum = 0;
      let litSum = 0;
      let count = 0;
      for (let i = 0; i < data.length; i += 4) {
        const r = data[i];
        const g = data[i + 1];
        const b = data[i + 2];
        const max = Math.max(r, g, b);
        const min = Math.min(r, g, b);
        if (max < 40 || min > 220 || max - min < 30) continue;
        const hsl = rgbToHsl(r, g, b);
        hues.push(hsl.h);
        satSum += hsl.s;
        litSum += hsl.l;
        count++;
      }
      if (count < 5) return null;
      hues.sort((a, b) => a - b);
      const h = hues[Math.floor(hues.length / 2)];
      const s = Math.min(95, (satSum / count) * 1.15);
      const l = Math.min(62, Math.max(38, litSum / count));
      return {
        accent: `hsl(${Math.round(h)} ${Math.round(s)}% ${Math.round(l)}%)`,
        accent2: `hsl(${Math.round((h + 40) % 360)} ${Math.round(s * 0.85)}% ${Math.round(l * 0.88)}%)`,
      };
    } catch {
      return null;
    }
  }

  function setRingTilt(on) {
    shell
      ?.querySelector(".carousel-viewport")
      ?.style.setProperty("--orbit-tilt", on ? "" : "0deg");
  }

  let hudOpen = false;
  let hudBootToken = 0;

  function setHudOpen(next) {
    hudOpen = !!next;
    setRingTilt(hudOpen);
    document.body.classList.toggle("hud-open", hudOpen);

    // The comments card is a sibling, not a descendant, so it does not
    // inherit the accent vars. Mirror them so both cards share one mood.
    // getComputedStyle resolves the full cascade: per-post inline override,
    // else the page theme's global tokens (neon in dark, deep cyan in light).
    if (hudCommentsFrame) {
      const cs = getComputedStyle(hud);
      const acc = cs.getPropertyValue("--pc-accent").trim();
      const acc2 = cs.getPropertyValue("--pc-accent2").trim();
      if (acc) hudCommentsFrame.style.setProperty("--pc-accent", acc);
      if (acc2) hudCommentsFrame.style.setProperty("--pc-accent2", acc2);
    }

    if (!hud) return;

    hud.classList.toggle("is-open", hudOpen);
    hud.setAttribute("aria-hidden", hudOpen ? "false" : "true");

    if (hudOpen) {
      hudBootToken = (hudBootToken + 1) % 1000;
      hud.dataset.boot = String(hudBootToken);

      hud.classList.remove("is-booting");
      void hud.offsetWidth;
      hud.classList.add("is-booting");

      snapHudToDock(true);
    }
  }

  // Smooth trackpad / mousewheel rotation
  shell?.addEventListener(
    "wheel",
    (e) => {
      if (!petalsOpen) return;
      if (hudOpen) return;
      e.preventDefault();

      const dy = clamp(e.deltaY, -80, 80);
      wheelVel += dy * 0.004;
      bumpIdle();
      start();
    },
    { passive: false },
  );

  function closeHud() {
    setHudOpen(false);
    // Also close comments section when HUD closes
    hudCommentsSection?.classList.add("is-collapsed");
  }

  hudClose?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    closeHud();
  });

  hudComments?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    const isOpening = !hudCommentsSection?.classList.contains("is-collapsed");
    hudCommentsSection?.classList.toggle("is-collapsed");
    
    // Mount Giscus when opening comments
    if (!isOpening && activeGiscusTerm) {
      ensureHudGiscus(activeGiscusTerm);
      setHudGiscusTerm(activeGiscusTerm);
    }
  });

  // Use capture phase to ensure this runs before any other handlers
  document.addEventListener("click", (e) => {
    if (e.target === hudCommentsClose || hudCommentsClose?.contains(e.target)) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      hudCommentsSection?.classList.add("is-collapsed");
      
      // Clean up Giscus instance when closing comments
      // Keep the embed mounted; collapsing only hides it and preserves thread state.
      
      return false;
    }
  }, true); // Use capture phase

  window.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (hudOpen) closeHud();
  });

  function closePetals() {
    if (!petalsOpen) return;

    petalsOpen = false;
    isDragging = false;
    isPointerDown = false;
    didMove = false;
    pullVel = 0;

    cancelLongPress();
    cancelIdleSnap();
    closeHud();
    updatePetalVisibility();
    stop();
  }

  // Toggling must go through the same transitions as every other open/close
  // path. Inverting petalsOpen here and then calling closePetals() would make
  // it early-return on its own `if (!petalsOpen) return` guard, leaving the
  // shell stuck with data-petals-open set - the close direction never worked.
  window.addEventListener("qi:toggle-petals", () => {
    if (petalsOpen) {
      closePetals();
      return;
    }

    petalsOpen = true;
    updatePetalVisibility();
    scheduleIdleSnap();
    start();
  });

  // Click-away close (backdrop)
  shell?.addEventListener(
    "pointerdown",
    (e) => {
      if (!petalsOpen) return;

      const t = e.target;
      if (t && hud && hud.contains(t)) return;

      const inPetalSurface =
        t && t.closest && t.closest("[data-petal-surface], .carousel-item");
      if (inPetalSurface) return;

      closePetals();
    },
    { passive: true },
  );

  // Esc closes carousel when HUD isn't open
  window.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (hudOpen) return;
    closePetals();
  });

  const BASE_FRICTION = 0.96;
  const BASE_SNAP = 0.06;
  const velClamp = 3.2;
  const settleThreshold = 0.015;

  let angle = 0;
  let vel = 0;

  // Drag state
  let isDragging = false;
  let isPointerDown = false;
  let didMove = false;

  let lastAngle = null;
  let lastActive = -1;

  let focusedIndex = -1;
  let snapTarget = null;
  let snapElastic = 0;

  let rafId = 0;
  let running = false;

  let pullVel = 0;
  let isPulling = false;

  let wheelVel = 0;

  let snapBoost = 0;

  let omPulse = 0.5;
  const sampleOmPulse = () => {
    const v = getComputedStyle(document.documentElement).getPropertyValue(
      "--pulse",
    );
    const p = Number(v);
    omPulse = Number.isFinite(p) ? p : 0.5;
  };
  sampleOmPulse();
  const omPulseTimer = setInterval(sampleOmPulse, 120);

  function getOmPulse() {
    return omPulse;
  }

  let radius = 300;
  let stretch = 1;
  const mq = matchMedia("(max-width: 768px)");
  function updateRadius() {
    radius = mq.matches ? 220 : 300;
  }
  mq.addEventListener("change", updateRadius);
  updateRadius();

  // ---------- Orbit: pointer parallax ----------
  // The camera leans a few degrees toward the pointer. Small on purpose: this
  // should be felt rather than seen.
  //
  // It runs on its own rAF because Nelumbo's main loop parks itself once the
  // ring settles — the camera has to keep tracking while the ring is at rest.
  const PARALLAX_X = 3.4;
  const PARALLAX_Y = 2.2;
  let panX = 0;
  let panY = 0;
  let panTargetX = 0;
  let panTargetY = 0;
  let panRaf = 0;

  function panTick() {
    panX += (panTargetX - panX) * 0.06;
    panY += (panTargetY - panY) * 0.06;

    const vpEl = ring?.closest(".carousel-viewport");
    if (vpEl) {
      vpEl.style.setProperty("--orbit-pan-x", `${panX.toFixed(3)}deg`);
      vpEl.style.setProperty("--orbit-pan-y", `${panY.toFixed(3)}deg`);
    }

    const settled =
      Math.abs(panTargetX - panX) < 0.01 && Math.abs(panTargetY - panY) < 0.01;
    panRaf = settled ? 0 : requestAnimationFrame(panTick);
  }

  window.addEventListener(
    "pointermove",
    (e) => {
      panTargetX = (e.clientX / window.innerWidth - 0.5) * 2 * PARALLAX_X;
      panTargetY = (e.clientY / window.innerHeight - 0.5) * -2 * PARALLAX_Y;
      if (!panRaf) panRaf = requestAnimationFrame(panTick);
    },
    { passive: true },
  );

  const clamp = (n, min, max) => Math.max(min, Math.min(max, n));
  const snapAngle = (a) => Math.round(a / step) * step;
  const normDeg = (d) => ((d % 360) + 360) % 360;

  const angDist = (a, b) => {
    const d = Math.abs(a - b) % 360;
    return d > 180 ? 360 - d : d;
  };

  const smoothstep = (e0, e1, x) => {
    const t = Math.max(0, Math.min(1, (x - e0) / (e1 - e0)));
    return t * t * (3 - 2 * t);
  };

  const SIDE_KILL = 43;
  const SIDE_FADE_END = 52;

  // Remember previous side distances so we can detect crossing events
  const lastSideDist = new Array(count).fill(null);
  let scanLToken = 0;
  let scanRToken = 0;

  function pulseScan(which /* "left" | "right" */, mode /* "out" | "in" */) {
    const front = which === "left" ? scanL : scanR;
    const back = which === "left" ? scanBackLeft : scanBackRight;

    const list = [back, front].filter(Boolean);

    for (const el of list) {
      el.classList.remove("is-pulsing", "is-in", "is-out");
      void el.offsetWidth; // restart animation reliably
      el.classList.add("is-pulsing", mode === "out" ? "is-out" : "is-in");
    }

    // Particles only on the FRONT beam
    if (front) burstParticles(front, which, mode);

    if (front) {
      if (which === "left") front.dataset.pulse = String(++scanLToken);
      else front.dataset.pulse = String(++scanRToken);
    }
  }

  function burstParticles(scanEl, which, mode) {
    const wrap = scanEl.closest(".petal-scan-wrap");
    if (!wrap) return;

    // MUCH more particles
    const N = 64;

    const dir = which === "left" ? -1 : 1;

    const h = wrap.clientHeight || 300;
    const baseY = h * (0.5 + (Math.random() - 0.5) * 0.18);

    // longer linger than beam anim (beam is ~520ms)
    const DURATION = 980;

    for (let i = 0; i < N; i++) {
      const p = document.createElement("i");
      p.className = "petal-particle";

      const y0 = baseY + (Math.random() - 0.5) * 120;
      p.style.top = `${y0}px`;
      p.style.left = `0px`;

      // more "burst": wider, punchier spreads
      const spreadX =
        (34 + Math.random() * 86) * dir * (0.85 + Math.random() * 0.55);
      const spreadY = (Math.random() - 0.5) * 140;

      const fromX = mode === "out" ? 0 : spreadX;
      const toX = mode === "out" ? spreadX : 0;

      const fromY = mode === "out" ? 0 : spreadY;
      const toY = mode === "out" ? spreadY : 0;

      // slightly more granular stagger
      const delay = Math.random() * 160;

      // per-particle flair
      const spin = (Math.random() * 80 - 40) * dir;
      const s0 = 0.9 + Math.random() * 0.35;

      wrap.appendChild(p);

      const anim = p.animate(
        [
          {
            opacity: 0,
            transform: `translate3d(${fromX}px, ${fromY}px, 0) scale(${s0}) rotate(${spin * 0.25}deg)`,
            filter: "blur(0.25px)",
          },
          {
            opacity: 1,
            transform: `translate3d(${fromX * 0.2}px, ${fromY * 0.2}px, 0) scale(${s0 * 1.08}) rotate(${spin * 0.6}deg)`,
            offset: 0.18,
          },
          {
            opacity: 0.85,
            transform: `translate3d(${toX * 0.78}px, ${toY * 0.78}px, 0) scale(${s0 * 0.55}) rotate(${spin}deg)`,
            offset: 0.62,
            filter: "blur(0.65px)",
          },
          {
            opacity: 0,
            transform: `translate3d(${toX}px, ${toY}px, 0) scale(${s0 * 0.25}) rotate(${spin * 1.15}deg)`,
            filter: "blur(1.1px)",
          },
        ],
        {
          duration: DURATION,
          delay,
          easing: "cubic-bezier(0.14, 0.9, 0.18, 1)",
          fill: "forwards",
        },
      );

      anim.onfinish = () => p.remove();
    }
  }

  function snapToIndex(index, immediate = false) {
    const target = -index * step;
    snapTarget = target;

    if (immediate) {
      angle = target;
      vel = 0;
      snapElastic = 0;
      applyTransforms();
      start();
      return;
    }

    const delta = target - angle;
    snapElastic = clamp(delta * 0.12, -18, 18);
    vel = 0;
    start();
  }

  function scrambleText(el, targetText, duration = 800) {
    if (!el) return;
    const chars = "!<>-_\\/[]{}—=+*^?#________";
    let frame = 0;
    const totalFrames = Math.floor((duration / 1000) * 60);

    const tickScramble = () => {
      frame++;
      const progress = frame / totalFrames;
      const length = targetText.length;

      let result = "";
      for (let i = 0; i < length; i++) {
        if (progress > i / length + Math.random() * 0.1) {
          result += targetText[i];
        } else {
          result += chars[Math.floor(Math.random() * chars.length)];
        }
      }

      el.textContent = result;

      if (frame < totalFrames) {
        requestAnimationFrame(tickScramble);
      } else {
        el.textContent = targetText;
      }
    };

    requestAnimationFrame(tickScramble);
  }

  function highlightKeywords(text) {
    let result = text;
    ARTIFACT_KEYWORDS.forEach((word) => {
      const regex = new RegExp(`\\b(${word})\\b`, "gi");
      result = result.replace(
        regex,
        `<span class="artifact-keyword">$1</span>`,
      );
    });
    return result;
  }

  function stripToText(html = "") {
    const tmp = document.createElement("div");
    tmp.innerHTML = String(html);
    return (tmp.innerText || tmp.textContent || "").trim();
  }

  // --- draggable HUD scroll (installed once) ---
  function enableDragScroll(scroller) {
    if (!scroller) return;
    if (scroller.dataset.dragScroll === "1") return;
    scroller.dataset.dragScroll = "1";

    let down = false;
    let startY = 0;
    let startScroll = 0;

    scroller.style.cursor = "grab";

    scroller.addEventListener(
      "pointerdown",
      (e) => {
        if (e.pointerType === "mouse" && e.button !== 0) return;
        down = true;
        startY = e.clientY;
        startScroll = scroller.scrollTop;
        scroller.style.cursor = "grabbing";
        scroller.setPointerCapture?.(e.pointerId);
      },
      { passive: true },
    );

    scroller.addEventListener(
      "pointermove",
      (e) => {
        if (!down) return;
        const dy = e.clientY - startY;
        scroller.scrollTop = startScroll - dy;
      },
      { passive: true },
    );

    function end() {
      down = false;
      scroller.style.cursor = "grab";
    }
    scroller.addEventListener("pointerup", end, { passive: true });
    scroller.addEventListener("pointercancel", end, { passive: true });
  }

  function setHudDataFromItem(el) {
    if (!el || !hud) return;

    const title =
      el.getAttribute("data-title") ||
      el.querySelector(".petal-content h1")?.textContent ||
      "Untitled";

    const desc =
      el.getAttribute("data-desc") ||
      el.querySelector(".petal-content p")?.textContent ||
      "";

    const date = el.getAttribute("data-date") || "";
    const rt = el.getAttribute("data-rt") || "";
    const href = el.getAttribute("data-href") || "#";

    const articleRaw = el.getAttribute("data-article") || "";
    const articleText = stripToText(articleRaw);

    const img = el.getAttribute("data-img") || "";

    if (hudTitle) scrambleText(hudTitle, title);
    if (hudDesc) scrambleText(hudDesc, desc, 1200);
    if (hudDate) hudDate.textContent = date;
    if (hudRT) hudRT.textContent = rt;

    if (hudLink) {
      hudLink.setAttribute("href", href);
      hudLink.setAttribute("aria-label", `Open ${title}`);
    }

    if (hudReactions) {
      hudReactions.setAttribute("href", href);
      hudReactions.setAttribute("aria-label", `Reactions for ${title}`);
    }

    if (hudComments) {
      hudComments.setAttribute("href", `${href}#giscus-wrapper`);
      hudComments.setAttribute("aria-label", `Comments for ${title}`);
    }

    setHudCountsLoading();
    try {
      const term = new URL(href, window.location.origin).pathname;
      setHudGiscusTerm(term);
    } catch {
      setHudGiscusTerm("/");
    }

    if (hudArticle) {
      const highlighted = highlightKeywords(
        articleText || "No article loaded yet.",
      );
      hudArticle.innerHTML = highlighted;
    }
    enableDragScroll(hudArticle);

    if (hudImg) {
      if (img) {
        hudImg.src = img;
        hudImg.alt = title;
        hudImg.style.display = "block";
        const applyAccent = () => {
          const colors = sampleImageColor(hudImg);
          if (!colors) return;
          hud.style.setProperty("--pc-accent", colors.accent);
          hud.style.setProperty("--pc-accent2", colors.accent2);
        };
        if (hudImg.complete && hudImg.naturalWidth > 0) {
          applyAccent();
        } else {
          hudImg.addEventListener("load", applyAccent, { once: true });
        }
      } else {
        hudImg.removeAttribute("src");
        hudImg.alt = "";
        hudImg.style.display = "none";
      }
    }
  }

  function clampToViewport(x, y) {
    const pad = 16;
    const vw = window.innerWidth;
    const vh = window.innerHeight;

    const pfBottomVar = getComputedStyle(document.documentElement)
      .getPropertyValue("--pagefind-bottom")
      .trim();

    const pfBottom = Number.parseFloat(pfBottomVar);
    const minY = Number.isFinite(pfBottom) ? pfBottom + 12 : pad;

    const cx = Math.max(pad, Math.min(vw - pad, x));
    const cy = Math.max(minY, Math.min(vh - pad, y));

    return { cx, cy };
  }

  function snapHudToDock(immediate = false) {
    if (!hudOpen || !hud) return;

    hud.style.setProperty("--hud-x", `50%`);
    hud.style.setProperty("--hud-y", `50%`);
    hudCommentsSection?.style.setProperty("--hud-x", `50%`);
    hudCommentsSection?.style.setProperty("--hud-y", `50%`);

    if (immediate) hud.classList.add("no-snap");
    else hud.classList.remove("no-snap");
  }

  function updateHudEffects(activeSideVis = 1) {
    if (!hudOpen || !hud) return;

    const om = getOmPulse();
    hud.style.setProperty("--hud-pulse", String(om));

    hud.style.setProperty("--hud-signal", String(activeSideVis));
    hud.classList.toggle("is-signal-loss", activeSideVis < 0.35);

    const yaw = normDeg(
      (lastActive >= 0 ? lastActive : 0) * step + angle + snapElastic,
    );
    const t = (yaw - 180) / 180;

    const imgX = clamp(t, -1, 1) * 8;
    const imgY = Math.sin((angle * Math.PI) / 180) * 5;

    hud.style.setProperty("--seg-img-x", `${imgX.toFixed(2)}px`);
    hud.style.setProperty("--seg-img-y", `${imgY.toFixed(2)}px`);
    hud.style.setProperty("--seg-title-x", `${(imgX * 0.35).toFixed(2)}px`);
    hud.style.setProperty("--seg-title-y", `${(imgY * 0.35).toFixed(2)}px`);
    hud.style.setProperty("--seg-chips-x", `${(imgX * 0.55).toFixed(2)}px`);
    hud.style.setProperty("--seg-chips-y", `${(imgY * 0.55).toFixed(2)}px`);
    hud.style.setProperty("--seg-article-x", `${(imgX * 0.25).toFixed(2)}px`);
    hud.style.setProperty("--seg-article-y", `${(imgY * 0.25).toFixed(2)}px`);
  }

  window.addEventListener("resize", () => snapHudToDock(true));
  window.addEventListener("scroll", () => snapHudToDock(true), {
    passive: true,
  });

  // --- Long press (HUD only) + drag initiation (carousel) ---
  let pressTimer = 0;
  let pressStartX = 0;
  let pressStartY = 0;

  function cancelLongPress() {
    clearTimeout(pressTimer);
    pressTimer = 0;
  }

  function openHudForIndex(i) {
    const el = items[i];
    if (!el) return;

    if (!petalsOpen) {
      petalsOpen = true;
      updatePetalVisibility();
      start();
    }

    focusedIndex = i;
    window.__focusedIndex = i; // Expose globally for ColorSwatch
    snapToIndex(i, false);

    setHudDataFromItem(el);

    setHudOpen(true);
    snapHudToDock(true);
    start();
  }

  // --- idle snap: after 1.6s, pull nearest to center (fluid) ---
  let idleSnapTimer = 0;

  // --- idle auto-snap ---
  let idleTimer = 0;
  const IDLE_SNAP_MS = 1100;

  function bumpIdle() {
    clearTimeout(idleTimer);
    idleTimer = window.setTimeout(() => {
      if (!petalsOpen) return;
      if (hudOpen) return;
      if (isPointerDown || isDragging) return; // don't fight the user
      snapToNearest(false); // fluid snap
    }, IDLE_SNAP_MS);
  }

  function snapToNearest(immediate = false) {
    // find the index whose yaw is closest to "front/center"
    // (your "center" is effectively the active index computed from angle)
    const normalized = ((angle % 360) + 360) % 360;
    const nearest = ((Math.round(-normalized / step) % count) + count) % count;
    snapToIndex(nearest, immediate);
  }

  function cancelIdleSnap() {
    clearTimeout(idleSnapTimer);
    idleSnapTimer = 0;
  }

  function nearestIndexFromAngle() {
    if (!count) return 0;
    const normalized = ((angle % 360) + 360) % 360;
    return ((Math.round(-normalized / step) % count) + count) % count;
  }

  function scheduleIdleSnap() {
    if (!petalsOpen) return;
    cancelIdleSnap();

    idleSnapTimer = window.setTimeout(() => {
      if (!petalsOpen) return;
      if (hudOpen) return;
      if (isPointerDown || isDragging) return;

      const i = nearestIndexFromAngle();
      focusedIndex = i;
      window.__focusedIndex = i; // Expose globally for ColorSwatch
      snapToIndex(i, false);
      start();
    }, 1600);
  }

  function armSurfaceInteractions(surfaceEl, index) {
    let dragLastX = 0;

    surfaceEl.addEventListener(
      "pointerdown",
      (e) => {
        if (!petalsOpen) return;
        if (e.pointerType === "mouse" && e.button !== 0) return;
        if (hudOpen) return;

        cancelIdleSnap();

        // arm long press
        isPointerDown = true;
        didMove = false;
        pressStartX = e.clientX;
        pressStartY = e.clientY;
        dragLastX = e.clientX;

        // immediate focus target (feels "magnetic" even before release)
        focusedIndex = index;
        window.__focusedIndex = index; // Expose globally for ColorSwatch
        snapToIndex(index, false);
        start();

        cancelLongPress();
        pressTimer = window.setTimeout(() => {
          // HUD opens only if still down and we did NOT move (no drag)
          if (isPointerDown && !didMove && !hudOpen) openHudForIndex(index);
        }, 420);

        surfaceEl.setPointerCapture?.(e.pointerId);
      },
      { passive: true },
    );

    surfaceEl.addEventListener(
      "pointermove",
      (e) => {
        if (!isPointerDown) return;
        if (hudOpen) return;

        const dx = e.clientX - pressStartX;
        const dy = e.clientY - pressStartY;

        if (!didMove && Math.abs(dx) + Math.abs(dy) > 10) {
          didMove = true;
          cancelLongPress();
          bumpIdle();
          // now we are officially dragging the carousel
          isDragging = true;
          isPulling = false;
          pullVel = 0;
        }

        if (!isDragging) return;

        const ddx = e.clientX - dragLastX;
        dragLastX = e.clientX;

        const d = ddx * 0.12;
        vel = clamp(d, -velClamp, velClamp);
        angle += d;

        cancelIdleSnap();
        start();
      },
      { passive: true },
    );

    function endPointer() {
      // short click -> ALWAYS snap (fluid) to clicked orb
      if (petalsOpen && !hudOpen && !didMove) {
        focusedIndex = index;
        window.__focusedIndex = index; // Expose globally for ColorSwatch
        snapToIndex(index, false);
        snapBoost = 1;
        start();
      }

      isPointerDown = false;
      cancelLongPress();
      isDragging = false;
      isPulling = false;

      scheduleIdleSnap();
    }

    surfaceEl.addEventListener("pointerup", endPointer, { passive: true });
    surfaceEl.addEventListener("pointercancel", endPointer, { passive: true });

    surfaceEl.addEventListener("keydown", (e) => {
      const el = items[index];
      const href = el?.dataset?.href;

      if (e.key === "Enter" && href) {
        location.href = href;
        return;
      }

      if (e.key === "Escape") {
        if (hudOpen) closeHud();
      }
    });
  }

  function applyTransforms() {
    if (!ring) return;
    if (angle === lastAngle) return;
    lastAngle = angle;

    ring.style.transform = `translateZ(0) rotateX(var(--orbit-tilt, -16deg)) rotateY(${angle + snapElastic}deg)`;

    const normalized = ((angle % 360) + 360) % 360;
    const active = ((Math.round(-normalized / step) % count) + count) % count;

    let activeSideVis = 1;

    if (active !== lastActive) {
      lastActive = active;
      items.forEach((el, i) => el.classList.toggle("active", i === active));
      if (hudOpen) setHudDataFromItem(items[active]);
    }

    const maxDist = Math.floor(count / 2 || 1);

    items.forEach((el, i) => {
      let dist = Math.abs(i - active);
      dist = Math.min(dist, count - dist);

      const depth = Math.min(1, dist / maxDist);
      el.style.setProperty("--petal-depth", depth.toFixed(4));
      el.style.setProperty("--petal-prox", (1 - depth).toFixed(4));

      const yawTotal = i * step + angle + snapElastic;
      const yaw = normDeg(yawTotal);

      const d90 = angDist(yaw, 90);
      const d270 = angDist(yaw, 270);
      const sideDist = Math.min(d90, d270);
      const sideVis = smoothstep(SIDE_KILL, SIDE_FADE_END, sideDist);

      const prev = lastSideDist[i];
      if (prev !== null) {
        const crossedIntoKill = prev > SIDE_KILL && sideDist <= SIDE_KILL;
        const crossedOutOfKill = prev <= SIDE_KILL && sideDist > SIDE_KILL;

        if (crossedIntoKill || crossedOutOfKill) {
          const which = d270 < d90 ? "left" : "right";
          const mode = crossedIntoKill ? "out" : "in";
          pulseScan(which, mode);
          // Tell the active orb to "disintegrate" when it hits the scanner boundary
          window.dispatchEvent(
            new CustomEvent("nelumbo:scan", {
              detail: { index: i, which, mode },
            }),
          );
        }
      }
      lastSideDist[i] = sideDist;

      if (i === active) activeSideVis = sideVis;

      const depthVis = 1 - depth * 0.7;
      const finalVis = depthVis * sideVis;
      el.style.opacity = finalVis.toFixed(3);

      el.style.pointerEvents = sideVis < 0.08 ? "none" : "auto";
      el.style.visibility = sideVis < 0.02 ? "hidden" : "visible";

      el.style.setProperty("--item-yaw", `${yawTotal}deg`);

      const PERSPECTIVE = 1500;
      const z = Math.cos((yawTotal * Math.PI) / 180) * radius;
      const sizeFix = (PERSPECTIVE - z) / PERSPECTIVE;

      el.style.setProperty("--size-fix", sizeFix.toFixed(6));

      el.style.transform = `translate(-50%, -50%)
        rotateY(${i * step}deg)
        translateZ(${radius * stretch}px)`;
    });

    snapHudToDock(false);
    updateHudEffects(activeSideVis);
  }

  function tick() {
    if (!running) return;

    const om = getOmPulse();
    const breath = (om - 0.5) * 2;

    const friction = BASE_FRICTION * (1 - breath * 0.015);
    const snapStrength = BASE_SNAP * (1 + breath * 0.06) * (1 + snapBoost * 2.2);

    if (snapBoost) {
      snapBoost *= 0.86;
      if (snapBoost < 0.01) snapBoost = 0;
    }

    if (wheelVel) {
      vel += wheelVel;
      wheelVel *= 0.86;
      if (Math.abs(wheelVel) < 0.001) wheelVel = 0;
    }

    angle += vel;
    vel *= friction;

    // Orbit: swell the ring with angular speed. The camera pan lives in its own
    // loop (panTick) because this one parks as soon as the ring settles.
    stretch = 1 + Math.min(1, Math.abs(vel) / velClamp) * 0.1;

    if (snapTarget !== null) {
      const d = snapTarget - angle;
      angle += d * snapStrength;
      snapElastic *= 0.78;

      if (Math.abs(d) < 0.01 && Math.abs(snapElastic) < 0.2) {
        angle = snapTarget;
        vel = 0;
        snapElastic = 0;
        snapTarget = null;
      }
    }

    if (snapTarget === null && Math.abs(vel) < settleThreshold) {
      const snapped = snapAngle(angle);
      angle += (snapped - angle) * snapStrength;

      if (Math.abs(snapped - angle) < 0.001) {
        angle = snapped;
        vel = 0;
        running = false;
        applyTransforms();
        return;
      }
    }

    applyTransforms();
    updateTether();
    rafId = requestAnimationFrame(tick);
  }

  function start() {
    if (running) return;
    running = true;
    rafId = requestAnimationFrame(tick);
  }

  window.addEventListener("resize", updateTether, { passive: true });
  document.addEventListener("astro:page-load", () => updateTether());

  function stop() {
    running = false;
    cancelAnimationFrame(rafId);
  }

  shell?.addEventListener(
    "pointerup",
    () => {
      isDragging = false;
      isPulling = false;
      isPointerDown = false;
      bumpIdle();
      cancelLongPress();
      scheduleIdleSnap();
    },
    { passive: true },
  );

  shell?.addEventListener(
    "pointercancel",
    () => {
      isDragging = false;
      isPulling = false;
      isPointerDown = false;
      cancelLongPress();
      scheduleIdleSnap();
    },
    { passive: true },
  );

  // Install per-item interactions
  items.forEach((el) => {
    const index = Number(el.dataset.index);
    const surface = el.querySelector("[data-petal-surface]") || el;
    armSurfaceInteractions(surface, index);
  });

  // initial state
  applyTransforms();
  updatePetalVisibility();
  stop();
  setRingTilt(false);

  window.addEventListener(
    "astro:before-swap",
    () => {
      clearInterval(omPulseTimer);
    },
    { once: true },
  );

  // ── HUD card: vanilla ports of SpotlightCard / TiltedCard / ClickSpark ──
  //    Tether cord ─────────────────────────────────────────────────
  // Tether cord: draw a live SVG line between the HUD card and the
  // comments card so the two read as one instrument in two modes.
  const tetherSvg = document.createElementNS(
    "http://www.w3.org/2000/svg",
    "svg",
  );
  tetherSvg.setAttribute("class", "hud-tether");
  tetherSvg.setAttribute("aria-hidden", "true");
  tetherSvg.innerHTML =
    '<line class="hud-tether-line" x1="0" y1="0" x2="0" y2="0"/>' +
    '<circle class="hud-tether-dot" r="2" cx="0" cy="0"/>';
  document.body.appendChild(tetherSvg);
  const tetherLine = tetherSvg.querySelector(".hud-tether-line");
  const tetherDot = tetherSvg.querySelector(".hud-tether-dot");

  function updateTether() {
    if (!hudOpen || !hudCommentsSection) {
      tetherSvg.style.opacity = "0";
      return;
    }
    const show =
      !hudCommentsSection.classList.contains("is-collapsed");
    tetherSvg.style.opacity = show ? "1" : "0";
    if (!show) return;
    const a = hud.getBoundingClientRect();
    const b = hudCommentsSection.getBoundingClientRect();
    // Drive the cord with transforms only. Mutating SVG attributes per frame
    // forces layout; transforms stay on the compositor.
    const h = Math.max(10, a.bottom - b.top - 16);
    const angle =
      Math.atan2(a.bottom - b.top - 16, a.left - b.left) * (180 / Math.PI);
    tetherSvg.style.transform = `translate(${(b.left + a.left) / 2 + a.width / 2 - b.width / 2}px, ${b.top + 8}px)`;
    tetherLine.setAttribute("y2", h);
    tetherLine.style.transformOrigin = "0 0";
    tetherLine.style.transform = `rotate(${angle}deg)`;
    tetherDot.setAttribute("cy", h);
  }
  (() => {

  // Reading progress bar — passive scroll listener
  const progress = hud.querySelector(".hud-progress");
  const articleBody = hud.querySelector(".hud-article-body");
  if (progress && articleBody) {
    articleBody.addEventListener("scroll", () => {
      const max = articleBody.scrollHeight - articleBody.clientHeight;
      progress.style.width =
        max > 0 ? `${(articleBody.scrollTop / max) * 100}%` : "0%";
    }, { passive: true });
  }

  // Keyboard: j/k or arrows scroll the article; Esc closes
  document.addEventListener("keydown", (e) => {
    if (!hudOpen) return;
    if (e.key === "Escape") return; // handled above
    const ab = hud.querySelector(".hud-article-body");
    if (!ab) return;
    if (e.key === "j" || e.key === "ArrowDown") {
      ab.scrollTop += 60;
      e.preventDefault();
    } else if (e.key === "k" || e.key === "ArrowUp") {
      ab.scrollTop -= 60;
      e.preventDefault();
    }
  });

  //    Spotlight / tilt / ghost / spark / progress / keys ─────────
  const hud = document.getElementById("petal-hud");
  if (!hud) return;

  const reduce = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const fine = window.matchMedia("(pointer: fine)").matches;
  const live = fine && !reduce;
  const tilt = hud.querySelector(".hud-tilt");

  // SpotlightCard + TiltedCard — rAF-throttled, transforms only
  let raf = 0;
  hud.addEventListener(
    "pointermove",
    (e) => {
      if (!live) return;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = hud.getBoundingClientRect();
        hud.style.setProperty("--mx", `${e.clientX - r.left}px`);
        hud.style.setProperty("--my", `${e.clientY - r.top}px`);
        if (!tilt) return;
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        tilt.style.transform = `perspective(1100px) rotateX(${(-py * 8).toFixed(2)}deg) rotateY(${(px * 8).toFixed(2)}deg)`;
      });
    },
    { passive: true },
  );
  hud.addEventListener("pointerleave", () => {
    if (tilt)
      tilt.style.transform =
        "perspective(1100px) rotateX(0deg) rotateY(0deg)";
  });

  // Ghost typography mirrors whatever the title settles on
  const ghost = hud.querySelector(".hud-ghost");
  const titleEl = hud.querySelector("[data-hud-title]");
  if (ghost && titleEl) {
    const sync = () => {
      ghost.textContent = titleEl.textContent;
    };
    new MutationObserver(sync).observe(titleEl, {
      childList: true,
      characterData: true,
      subtree: true,
    });
    sync();
  }

  // ClickSpark — a small burst off the controls
  if (!reduce) {
    hud.querySelectorAll("[data-spark]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const r = btn.getBoundingClientRect();
        const n = btn.classList.contains("hud-pill") ? 14 : 9;
        for (let i = 0; i < n; i++) {
          const sp = document.createElement("span");
          sp.className = "hud-spark";
          const a = Math.random() * Math.PI * 2;
          const d = 16 + Math.random() * 24;
          sp.style.setProperty("--sx", `${(Math.cos(a) * d).toFixed(1)}px`);
          sp.style.setProperty("--sy", `${(Math.sin(a) * d).toFixed(1)}px`);
          sp.style.left = `${e.clientX - r.left}px`;
          sp.style.top = `${e.clientY - r.top}px`;
          btn.appendChild(sp);
          setTimeout(() => sp.remove(), 600);
        }
      });
    });
  }


  })();
</script>
