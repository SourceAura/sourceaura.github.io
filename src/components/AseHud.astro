---
/*
  AseHud: dev-only inspector for the Ase neural core.

  Rendered only when `import.meta.env.DEV` (see Layout.astro), so none of this
  reaches production. Collapsed to a pill by default; open state and active tab
  persist in localStorage. Monochrome, using the site's own tokens plus the
  single oklch accent shared with the pagefind glow.

  The "in" pane reads `__ase.lastVector`, the exact array that was POSTed,
  instead of recomputing its own normalisation.
*/
import ColorSwatch from "./ColorSwatch.astro";
---

<div id="ase-hud" data-open="false" data-tab="in" data-link="waiting">
  <button
    id="ase-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="ase-body"
    title="Ase inspector (E)"
  >
    <span class="ase-dot" aria-hidden="true"></span>
    <span class="ase-word">ase</span>
    <span class="ase-model" id="ase-model-ver">v0</span>
    <span class="ase-chev" aria-hidden="true"></span>
  </button>

  <div id="ase-body">
    <div class="ase-link">
      <span id="ase-state">waiting</span>
      <span class="ase-sep">·</span>
      <span id="ase-lat">-</span>
      <span class="ase-sep">·</span>
      <span id="ase-age">no inference yet</span>
    </div>

    <!-- The only thing Ase changes about the page: one CSS variable. -->
    <div class="ase-block">
      <div class="ase-block-head">
        <span class="ase-key">ase-wake</span>
        <span class="ase-num" id="ase-wake-val">0.500</span>
      </div>
      <canvas id="ase-wake-spark"></canvas>
    </div>

    <div class="ase-tabs" role="tablist">
      <button type="button" role="tab" data-tab="in" aria-selected="true">in</button>
      <button type="button" role="tab" data-tab="out" aria-selected="false">out</button>
      <button type="button" role="tab" data-tab="model" aria-selected="false">model</button>
      <button type="button" role="tab" data-tab="colors" aria-selected="false">colors</button>
    </div>

    <div class="ase-pane" data-pane="in">
      <p class="ase-note">8 values → <code>/infer</code></p>
      <div id="ase-vec"></div>
    </div>

    <div class="ase-pane" data-pane="out" hidden>
      <p class="ase-note">latent embedding · <span id="ase-embed-dims">0</span> dims · signed</p>
      <div id="ase-embed-grid" class="ase-embed-grid"></div>
    </div>

    <div class="ase-pane" data-pane="model" hidden>
      <div id="ase-model-rows"></div>
    </div>

    <div class="ase-pane" data-pane="colors" hidden>
      <ColorSwatch width={264} height={150} />
      <div id="ase-console-logs" class="ase-console"></div>
    </div>

    <div class="ase-actions">
      <button id="ase-log" type="button">log session</button>
      <button id="ase-train" type="button">train</button>
      <button id="ase-copy" type="button">copy json</button>
    </div>
  </div>
</div>

<script>
  const IN_LABELS = [
    "scroll vel",
    "scroll acc",
    "idle ratio",
    "click heat",
    "kbd rhythm",
    "interactions",
    "depth",
    "focus",
  ];

  const MODEL_FIELDS = [
    ["model", "ase-f-model"],
    ["samples", "ase-f-samples"],
    ["training", "ase-f-training"],
    ["auto-train", "ase-f-auto"],
    ["page", "ase-f-page"],
    ["section", "ase-f-section"],
    ["device", "ase-f-device"],
    ["viewport", "ase-f-viewport"],
    ["session #", "ase-f-session"],
    ["referrer", "ase-f-referrer"],
  ];

  const HISTORY = 96;

  function initAseHud() {
    const hud = document.getElementById("ase-hud");
    if (!hud || hud.dataset.ready === "1") return;
    hud.dataset.ready = "1";

    const $ = (id: string) => document.getElementById(id);
    const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
    const accent = () =>
      getComputedStyle(document.documentElement)
        .getPropertyValue("--ase-accent")
        .trim() || "oklch(0.72 0.06 255)";

    const store = {
      get: (k: string, d: string) => {
        try {
          return localStorage.getItem("ase." + k) ?? d;
        } catch {
          return d;
        }
      },
      set: (k: string, v: string) => {
        try {
          localStorage.setItem("ase." + k, v);
        } catch {
          /* private mode */
        }
      },
    };

    /* open / close */
    let open = store.get("open", "false") === "true";
    let tab = store.get("tab", "in");

    const toggle = $("ase-toggle")!;

    const applyOpen = () => {
      hud.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      store.set("open", String(open));
      if (open) void pollStats();
    };

    const applyTab = () => {
      hud.dataset.tab = tab;
      hud.querySelectorAll<HTMLElement>("[data-tab]").forEach((b) => {
        b.setAttribute("aria-selected", String(b.dataset.tab === tab));
      });
      hud.querySelectorAll<HTMLElement>("[data-pane]").forEach((p) => {
        p.hidden = p.dataset.pane !== tab;
      });
      store.set("tab", tab);
    };

    toggle.addEventListener("click", () => {
      open = !open;
      applyOpen();
    });

    hud.querySelectorAll<HTMLElement>("[data-tab]").forEach((b) => {
      b.addEventListener("click", () => {
        tab = b.dataset.tab ?? "in";
        applyTab();
      });
    });

    const onKey = (e: KeyboardEvent) => {
      const tag = (document.activeElement as HTMLElement | null)?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA") return;
      if (e.key === "e" || e.key === "E") {
        open = !open;
        applyOpen();
      }
    };
    window.addEventListener("keydown", onKey);

    applyOpen();
    applyTab();

    /* device-pixel-aware canvas */
    function fitCanvas(
      canvas: HTMLCanvasElement | null,
      cssH: number,
    ): { ctx: CanvasRenderingContext2D; w: number; h: number } | null {
      if (!canvas) return null;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const cssW = canvas.parentElement?.clientWidth || 264;
      canvas.width = Math.round(cssW * dpr);
      canvas.height = Math.round(cssH * dpr);
      canvas.style.width = "100%";
      canvas.style.height = `${cssH}px`;
      const ctx = canvas.getContext("2d");
      if (!ctx) return null;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return { ctx, w: cssW, h: cssH };
    }

    /* "in" pane, built from the wire vector */
    const vecRoot = $("ase-vec")!;
    const vecRows = IN_LABELS.map((label) => {
      const row = document.createElement("div");
      row.className = "ase-row";
      const l = document.createElement("span");
      l.className = "ase-key";
      l.textContent = label;
      const track = document.createElement("span");
      track.className = "ase-track";
      const fill = document.createElement("span");
      fill.className = "ase-fill";
      track.appendChild(fill);
      const num = document.createElement("span");
      num.className = "ase-num";
      num.textContent = "0.00";
      row.append(l, track, num);
      vecRoot.appendChild(row);
      return { fill, num };
    });

    /* "out" pane: the latent embedding. The embedding is signed, so each
       dimension is drawn diverging from a zero baseline rather than as a
       magnitude. */
    const embedGrid = $("ase-embed-grid")!;
    let embedding: number[] = [];
    let embedCells: { bar: HTMLElement; num: HTMLElement }[] = [];

    const buildEmbedCells = (n: number) => {
      embedGrid.textContent = "";
      embedCells = Array.from({ length: n }, () => {
        const cell = document.createElement("div");
        cell.className = "ase-cell";
        const track = document.createElement("span");
        track.className = "ase-cell-track";
        const bar = document.createElement("i");
        track.appendChild(bar);
        const num = document.createElement("span");
        num.className = "ase-cell-num";
        num.textContent = "0.00";
        cell.append(track, num);
        embedGrid.appendChild(cell);
        return { bar, num };
      });
    };

    const renderEmbed = () => {
      if (!embedding.length) return;
      if (embedCells.length !== embedding.length) {
        buildEmbedCells(embedding.length);
      }

      const maxAbs = Math.max(...embedding.map(Math.abs), 1e-6);
      const half = 8; // half of the 16px track
      embedCells.forEach((cell, i) => {
        const v = embedding[i] ?? 0;
        const t = Math.max(-1, Math.min(1, v / maxAbs));
        // Floor at 1px so a small-but-nonzero dimension is still visible
        // instead of silently rendering as nothing.
        const h = Math.max(Math.abs(t) * half, 1);
        cell.bar.style.height = `${h}px`;
        cell.bar.style.top = t >= 0 ? `${half - h}px` : `${half}px`;
        cell.num.textContent = v.toFixed(2);
        cell.num.dataset.sign = v >= 0 ? "pos" : "neg";
      });
    };

    /* wake sparkline */
    const sparkCv = fitCanvas(
      document.getElementById("ase-wake-spark") as HTMLCanvasElement | null,
      30,
    );
    const wakeHist: number[] = [];
    let smoothWake = 0.5;

    const renderSpark = () => {
      if (!sparkCv || wakeHist.length < 2) return;
      const { ctx, w, h } = sparkCv;
      const color = accent();

      ctx.clearRect(0, 0, w, h);
      ctx.globalAlpha = 0.16;
      ctx.fillStyle = color;
      ctx.fillRect(0, h - 1, w, 1);
      ctx.globalAlpha = 1;

      ctx.beginPath();
      wakeHist.forEach((v, i) => {
        const x = (i / (HISTORY - 1)) * w;
        const y = h - clamp01(v) * (h - 4) - 2;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.strokeStyle = color;
      ctx.lineWidth = 1.5;
      ctx.lineJoin = "round";
      ctx.stroke();
    };

    /* "model" pane */
    const modelRows = $("ase-model-rows")!;
    const modelEls: Record<string, HTMLElement> = {};
    MODEL_FIELDS.forEach(([label, id]) => {
      const row = document.createElement("div");
      row.className = "ase-row ase-row--flat";
      const l = document.createElement("span");
      l.className = "ase-key";
      l.textContent = label;
      const v = document.createElement("span");
      v.className = "ase-num";
      v.textContent = "-";
      row.append(l, v);
      modelRows.appendChild(row);
      modelEls[id] = v;
    });

    let lastStatsAt = 0;
    async function pollStats() {
      const url = (window as any).__aseUrl;
      if (!url) return;
      try {
        const res = await fetch(`${url}/stats`);
        const data = await res.json();
        const count = data.log_count ?? 0;
        const readyAt = data.training_ready_at ?? 25;
        modelEls["ase-f-model"].textContent = data.current_model ?? "-";
        modelEls["ase-f-samples"].textContent = `${count}/${readyAt}`;
        modelEls["ase-f-training"].textContent = data.training_ready
          ? "ready"
          : "collecting";
        modelEls["ase-f-auto"].textContent = data.auto_training ? "on" : "off";
        const ver = $("ase-model-ver");
        if (ver) {
          ver.textContent = String(data.current_model ?? "v0").replace(
            "ase_",
            "",
          );
        }
        hud.dataset.link = "online";
      } catch {
        hud.dataset.link = "offline";
        modelEls["ase-f-training"].textContent = "offline";
      }
    }

    /* events from the client */
    const onUpdate = (e: Event) => {
      const d = (e as CustomEvent).detail || {};
      embedding = d.embedding || [];
      hud.dataset.link = "online";
      const lat = $("ase-lat");
      if (lat) {
        lat.textContent =
          d.latency != null ? `${Math.round(d.latency)}ms` : "-";
      }
      const dims = $("ase-embed-dims");
      if (dims) dims.textContent = String(embedding.length);
      renderEmbed();
    };
    window.addEventListener("ase:update", onUpdate);

    const onMilestone = (e: Event) => {
      const state = $("ase-state");
      if (state) {
        state.textContent = `milestone ${(e as CustomEvent).detail?.count ?? 0}`;
      }
    };
    window.addEventListener("ase:milestone", onMilestone);

    /* main loop */
    const tick = () => {
      const s = (window as any).__ase;
      if (!s) return;

      const vec: number[] = s.lastVector || [];
      for (let i = 0; i < vecRows.length; i++) {
        const v = clamp01(vec[i] ?? 0);
        vecRows[i].fill.style.width = `${v * 100}%`;
        vecRows[i].num.textContent = v.toFixed(2);
      }

      const wakeRaw =
        parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue(
            "--ase-wake",
          ),
        ) || 0.5;
      smoothWake = smoothWake + (wakeRaw - smoothWake) * 0.2;
      const wakeVal = $("ase-wake-val");
      if (wakeVal) wakeVal.textContent = smoothWake.toFixed(3);
      wakeHist.push(smoothWake);
      if (wakeHist.length > HISTORY) wakeHist.shift();
      renderSpark();

      const state = $("ase-state");
      const age = $("ase-age");
      if (state) state.textContent = s.status || "waiting";
      if (age) {
        age.textContent = s.lastUpdate
          ? `${((Date.now() - s.lastUpdate) / 1000).toFixed(1)}s ago`
          : "no inference yet";
      }

      const c = s.context;
      if (c) {
        modelEls["ase-f-page"].textContent = c.page || "-";
        modelEls["ase-f-section"].textContent = c.section || "-";
        modelEls["ase-f-device"].textContent = c.deviceType || "-";
        modelEls["ase-f-viewport"].textContent = c.viewportSize || "-";
        modelEls["ase-f-session"].textContent = String(c.sessionNumber ?? "-");
        modelEls["ase-f-referrer"].textContent = (c.referrer || "direct").slice(
          0,
          18,
        );
      }

      if (open && Date.now() - lastStatsAt > 8000) {
        lastStatsAt = Date.now();
        void pollStats();
      }
    };
    const loop = window.setInterval(tick, 250);
    tick();

    /* actions */
    const flash = (btn: HTMLButtonElement, text: string, ms = 1200) => {
      const old = btn.textContent;
      btn.textContent = text;
      btn.disabled = true;
      window.setTimeout(() => {
        btn.textContent = old;
        btn.disabled = false;
      }, ms);
    };

    $("ase-log")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const ok = await (window as any).__ase?.logSession?.();
      flash(btn, ok ? "logged" : "failed");
    });

    $("ase-train")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.textContent = "training…";
      btn.disabled = true;
      try {
        const res = await fetch(`${(window as any).__aseUrl}/train`, {
          method: "POST",
        });
        const data = await res.json();
        btn.textContent = data.status === "success" ? "done" : "failed";
        void pollStats();
      } catch {
        btn.textContent = "offline";
      }
      window.setTimeout(() => {
        btn.textContent = "train";
        btn.disabled = false;
      }, 1600);
    });

    $("ase-copy")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const s = (window as any).__ase;
      const payload = {
        vector: s?.lastVector ?? [],
        embedding,
        latency: s?.lastLatency ?? null,
        context: s?.context ?? null,
      };
      try {
        await navigator.clipboard.writeText(JSON.stringify(payload, null, 2));
        flash(btn, "copied");
      } catch {
        flash(btn, "failed");
      }
    });

    /* teardown on view-transition swap */
    document.addEventListener(
      "astro:before-swap",
      () => {
        window.clearInterval(loop);
        window.removeEventListener("keydown", onKey);
        window.removeEventListener("ase:update", onUpdate);
        window.removeEventListener("ase:milestone", onMilestone);
      },
      { once: true },
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAseHud);
  } else {
    initAseHud();
  }
  document.addEventListener("astro:page-load", initAseHud);
</script>

<style is:global>
  /* Global on purpose: the rows are created with createElement and would never
     pick up Astro's scope attribute. Everything is namespaced under #ase-hud. */
  #ase-hud {
    --ase-accent: oklch(0.72 0.06 255);
    --ase-surface: rgba(9, 9, 11, 0.86);
    --ase-line: rgba(255, 255, 255, 0.12);
    --ase-fg: rgba(255, 255, 255, 0.94);
    --ase-muted: rgba(255, 255, 255, 0.44);
    --ase-soft: rgba(255, 255, 255, 0.06);
    --ase-track: rgba(255, 255, 255, 0.1);
    --ase-raised: rgba(255, 255, 255, 0.13);
    --ase-zero: rgba(255, 255, 255, 0.24);

    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 9000;
    width: min(288px, calc(100vw - 2rem));
    font-family:
      "Geist Mono Variable", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    line-height: 1.5;
    color: var(--ase-fg);
    background: var(--ase-surface);
    backdrop-filter: blur(14px) saturate(140%);
    @media (pointer: coarse) {
      /* touch GPUs: saturate() compounds the offscreen-surface cost */
      backdrop-filter: blur(8px);
    }
    border: 1px solid var(--ase-line);
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    transition: width 180ms ease;
  }

  html.light #ase-hud {
    --ase-accent: oklch(0.52 0.09 255);
    --ase-surface: rgba(253, 253, 254, 0.9);
    --ase-line: rgba(0, 0, 0, 0.12);
    --ase-fg: rgba(0, 0, 0, 0.92);
    --ase-muted: rgba(0, 0, 0, 0.46);
    --ase-soft: rgba(0, 0, 0, 0.05);
    --ase-track: rgba(0, 0, 0, 0.09);
    --ase-raised: rgba(0, 0, 0, 0.07);
    --ase-zero: rgba(0, 0, 0, 0.26);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.14);
  }

  /* collapsed */
  #ase-hud[data-open="false"] {
    width: auto;
  }
  #ase-hud[data-open="false"] #ase-body {
    display: none;
  }

  #ase-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.45rem 0.7rem;
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  #ase-hud[data-open="false"] #ase-toggle {
    width: auto;
  }
  #ase-toggle:hover {
    background: var(--ase-soft);
  }
  #ase-toggle:focus-visible {
    outline: 1px solid var(--ase-accent);
    outline-offset: -1px;
  }

  #ase-hud .ase-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ase-muted);
  }
  #ase-hud[data-link="online"] .ase-dot {
    background: var(--ase-accent);
    box-shadow: 0 0 8px var(--ase-accent);
  }
  #ase-hud[data-link="offline"] .ase-dot {
    background: oklch(0.66 0.19 25);
    box-shadow: 0 0 8px oklch(0.66 0.19 25 / 0.6);
  }

  #ase-hud .ase-word {
    letter-spacing: 0.09em;
    opacity: 0.9;
  }

  #ase-hud .ase-model {
    margin-left: auto;
    color: var(--ase-muted);
    font-size: 10px;
  }

  #ase-hud .ase-chev {
    flex: none;
    width: 6px;
    height: 6px;
    margin-left: 0.4rem;
    border-right: 1px solid var(--ase-muted);
    border-bottom: 1px solid var(--ase-muted);
    transform: rotate(-135deg) translate(-1px, -1px);
    transition: transform 180ms ease;
  }
  #ase-hud[data-open="true"] .ase-chev {
    transform: rotate(45deg) translate(-1px, -1px);
  }

  /* body */
  #ase-body {
    padding: 0 0.7rem 0.7rem;
    border-top: 1px solid var(--ase-line);
  }

  #ase-hud .ase-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0;
    font-size: 10px;
    color: var(--ase-muted);
  }
  #ase-hud .ase-sep {
    opacity: 0.4;
  }

  #ase-hud .ase-block {
    padding-bottom: 0.6rem;
  }
  #ase-hud .ase-block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.3rem;
  }

  #ase-wake-spark {
    display: block;
  }

  /* tabs */
  #ase-hud .ase-tabs {
    display: flex;
    gap: 2px;
    padding: 2px;
    margin-bottom: 0.6rem;
    background: var(--ase-soft);
    border-radius: 7px;
  }
  #ase-hud .ase-tabs button {
    flex: 1;
    padding: 0.28rem 0;
    background: transparent;
    border: 0;
    border-radius: 5px;
    color: var(--ase-muted);
    font: inherit;
    font-size: 10px;
    cursor: pointer;
    transition:
      background 140ms ease,
      color 140ms ease;
  }
  #ase-hud .ase-tabs button:hover {
    color: var(--ase-fg);
  }
  #ase-hud .ase-tabs button[aria-selected="true"] {
    background: var(--ase-raised);
    color: var(--ase-fg);
    box-shadow: inset 0 0 0 1px var(--ase-line);
  }

  /* panes */
  #ase-hud .ase-pane[hidden] {
    display: none;
  }

  #ase-hud .ase-note {
    margin: 0 0 0.5rem;
    font-size: 10px;
    color: var(--ase-muted);
  }
  #ase-hud .ase-note code {
    color: var(--ase-fg);
    opacity: 0.75;
  }

  #ase-hud .ase-row {
    display: grid;
    grid-template-columns: 74px 1fr 34px;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 5px;
  }
  #ase-hud .ase-row--flat {
    grid-template-columns: 74px 1fr;
  }

  #ase-hud .ase-key {
    font-size: 10px;
    color: var(--ase-muted);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  #ase-hud .ase-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  #ase-hud .ase-track {
    display: block;
    height: 3px;
    background: var(--ase-track);
    border-radius: 2px;
    overflow: hidden;
  }
  #ase-hud .ase-fill {
    display: block;
    width: 0;
    height: 100%;
    background: var(--ase-accent);
    border-radius: 2px;
    transition: width 220ms ease;
  }

  #ase-hud .ase-embed-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 4px;
  }
  #ase-hud .ase-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
