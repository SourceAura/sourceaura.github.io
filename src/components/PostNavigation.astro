---
const { prevPost, nextPost } = Astro.props;
---

<nav class="post-nav" aria-label="Post navigation">
  {
    prevPost?.slug ? (
      <a
        href={prevPost?.slug}
        class="nav-pill nav-prev"
        title={prevPost?.data.title}
      >
        <span class="nav-arrow" aria-hidden="true">←</span>
        <span class="nav-label">Prev</span>
      </a>
    ) : (
      <span class="nav-pill nav-pill--placeholder" aria-hidden="true" />
    )
  }

  {
    nextPost?.slug ? (
      <a
        href={nextPost?.slug}
        class="nav-pill nav-next"
        title={nextPost?.data.title}
      >
        <span class="nav-label">Next</span>
        <span class="nav-arrow" aria-hidden="true">→</span>
      </a>
    ) : (
      <span class="nav-pill nav-pill--placeholder" aria-hidden="true" />
    )
  }
</nav>

<style>
  .post-nav {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklch, var(--pc-accent) 30%, transparent);
    background: linear-gradient(
      135deg,
      color-mix(in oklch, var(--pc-accent) 12%, transparent),
      color-mix(in oklch, var(--pc-accent2) 8%, transparent)
    );
    color: var(--pc-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    flex: 1;
    justify-content: center;
  }

  .nav-pill:hover {
    transform: translateY(-2px);
    border-color: var(--pc-accent);
    box-shadow: 0 4px 16px color-mix(in oklch, var(--pc-accent) 20%, transparent);
  }

  .nav-pill--placeholder {
    visibility: hidden;
    pointer-events: none;
  }

  .nav-arrow {
    font-size: 1em;
    line-height: 1;
  }

  .nav-label {
    line-height: 1;
  }

  @media (max-width: 640px) {
    .post-nav {
      flex-direction: column;
      gap: 0.75rem;
    }

    .nav-pill {
      padding: 0.5rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-pill {
      transition: none;
    }
  }
</style>
